---
import { dataAiCapabilities } from "../data/data-ai-capabilities";

const panelData = dataAiCapabilities.map((item) => ({
  number: item.number,
  title: item.title,
  signature: item.signature,
  intro: item.intro,
  managementQuestions: item.managementQuestions,
  principles: item.principles,
  evidence: item.evidence,
  trends: item.trends,
  image: item.image,
  alt: item.alt,
  href: item.href,
  ctaLabel: item.ctaLabel,
}));

const serializedPanelData = JSON.stringify(panelData).replace(/</g, "\\u003c");
---

<section class="field-section" id="data-ai-fields" aria-labelledby="data-ai-fields-title">
  <div class="section-heading">
    <div class="section-kicker">Die 8 Capability-Felder</div>
    <h2 id="data-ai-fields-title">Von belastbaren Signalen bis zu verlässlicher, skalierbarer Automation.</h2>
  </div>

  <ol class="field-grid">
    {
      dataAiCapabilities.map((item) => (
        <li>
          <button
            class="field-card"
            type="button"
            data-data-ai-field={item.number}
            aria-haspopup="dialog"
            aria-controls="data-ai-field-dialog"
            aria-expanded="false"
            aria-label={`${item.number} ${item.title} erkunden`}
          >
            <span class="field-media">
              <img src={item.image} alt={item.alt} width="400" height="340" loading="lazy" decoding="async" />
            </span>
            <span class="field-content">
              <span class="field-title"><b>{item.number}</b><strong>{item.title}</strong></span>
              <span class="field-description">{item.description}</span>
              <span class="field-mobile-action">Explore <span aria-hidden="true">→</span></span>
            </span>
            <span class="field-preview" aria-hidden="true">
              <span class="preview-copy">{item.hover}</span>
              <span class="preview-action">Explore <span aria-hidden="true">→</span></span>
            </span>
          </button>
        </li>
      ))
    }
  </ol>
</section>

<dialog class="field-dialog" id="data-ai-field-dialog" aria-labelledby="data-ai-dialog-title" aria-describedby="data-ai-dialog-signature">
  <div class="drawer">
    <div class="drawer-topline">
      <span class="drawer-number" id="data-ai-dialog-number"></span>
      <button class="drawer-close" type="button" aria-label="Capability-Details schließen">×</button>
    </div>

    <div class="drawer-heading">
      <div class="drawer-icon">
        <img id="data-ai-dialog-image" src="" alt="" width="400" height="340" />
      </div>
      <div>
        <h2 id="data-ai-dialog-title"></h2>
        <p class="drawer-signature" id="data-ai-dialog-signature"></p>
      </div>
    </div>

    <section class="drawer-section intro-section" aria-labelledby="data-ai-dialog-intro-label">
      <h3 id="data-ai-dialog-intro-label">Intro</h3>
      <p id="data-ai-dialog-intro"></p>
    </section>

    <div class="drawer-columns">
      <section class="drawer-section" aria-labelledby="data-ai-dialog-questions-label">
        <h3 id="data-ai-dialog-questions-label">Management Questions</h3>
        <ul id="data-ai-dialog-questions"></ul>
      </section>

      <section class="drawer-section" aria-labelledby="data-ai-dialog-principles-label">
        <h3 id="data-ai-dialog-principles-label">Principles</h3>
        <ul id="data-ai-dialog-principles"></ul>
      </section>
    </div>

    <section class="drawer-section" aria-labelledby="data-ai-dialog-evidence-label">
      <h3 id="data-ai-dialog-evidence-label">Selected Evidence</h3>
      <div class="drawer-tags" id="data-ai-dialog-evidence"></div>
    </section>

    <section class="drawer-section" aria-labelledby="data-ai-dialog-trends-label">
      <h3 id="data-ai-dialog-trends-label">Aktuelle Trends</h3>
      <div class="drawer-trends" id="data-ai-dialog-trends"></div>
    </section>

    <a class="drawer-cta" id="data-ai-dialog-link" href="/data-ai-digital-product" hidden>
      <span id="data-ai-dialog-link-label"></span> <span aria-hidden="true">→</span>
    </a>
  </div>
</dialog>

<script type="application/json" id="data-ai-field-data" set:html={serializedPanelData}></script>

<script>
  const fieldDialog = document.querySelector<HTMLDialogElement>("#data-ai-field-dialog");
  const fieldDataNode = document.querySelector<HTMLScriptElement>("#data-ai-field-data");
  const fieldTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-data-ai-field]"));
  const closeButton = fieldDialog?.querySelector<HTMLButtonElement>(".drawer-close");
  let activeFieldTrigger: HTMLButtonElement | null = null;

  const fields = fieldDataNode ? JSON.parse(fieldDataNode.textContent || "[]") : [];
  const byNumber = new Map(fields.map((field: { number: string }) => [field.number, field]));

  function setText(selector: string, value: string) {
    const node = fieldDialog?.querySelector<HTMLElement>(selector);
    if (node) node.textContent = value;
  }

  function replaceList(selector: string, values: string[]) {
    const list = fieldDialog?.querySelector<HTMLUListElement>(selector);
    list?.replaceChildren(...values.map((value) => {
      const item = document.createElement("li");
      item.textContent = value;
      return item;
    }));
  }

  function replaceTags(selector: string, values: string[]) {
    const container = fieldDialog?.querySelector<HTMLElement>(selector);
    container?.replaceChildren(...values.map((value) => {
      const item = document.createElement("span");
      item.textContent = value;
      return item;
    }));
  }

  function openFieldDialog(trigger: HTMLButtonElement) {
    if (!fieldDialog) return;
    const field = byNumber.get(trigger.dataset.dataAiField || "");
    if (!field) return;

    activeFieldTrigger = trigger;
    fieldTriggers.forEach((item) => item.setAttribute("aria-expanded", item === trigger ? "true" : "false"));

    setText("#data-ai-dialog-number", `${field.number} · Data, AI & Decisioning`);
    setText("#data-ai-dialog-title", field.title);
    setText("#data-ai-dialog-signature", field.signature);
    setText("#data-ai-dialog-intro", field.intro);
    replaceList("#data-ai-dialog-questions", field.managementQuestions);
    replaceList("#data-ai-dialog-principles", field.principles);
    replaceTags("#data-ai-dialog-evidence", field.evidence);
    replaceTags("#data-ai-dialog-trends", field.trends);

    const image = fieldDialog.querySelector<HTMLImageElement>("#data-ai-dialog-image");
    if (image) {
      image.src = field.image;
      image.alt = field.alt;
    }

    const link = fieldDialog.querySelector<HTMLAnchorElement>("#data-ai-dialog-link");
    if (link) {
      link.hidden = !field.href;
      if (field.href) link.href = field.href;
    }
    setText("#data-ai-dialog-link-label", field.ctaLabel || "Case ansehen");

    fieldDialog.showModal();
    document.body.classList.add("data-ai-dialog-open");
    closeButton?.focus();
  }

  fieldTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => openFieldDialog(trigger));
  });

  closeButton?.addEventListener("click", () => fieldDialog?.close());

  fieldDialog?.addEventListener("click", (event) => {
    if (event.target === fieldDialog) fieldDialog.close();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && fieldDialog?.open) {
      event.preventDefault();
      fieldDialog.close();
    }
  });

  fieldDialog?.addEventListener("close", () => {
    document.body.classList.remove("data-ai-dialog-open");
    fieldTriggers.forEach((item) => item.setAttribute("aria-expanded", "false"));
    activeFieldTrigger?.focus();
    activeFieldTrigger = null;
  });
</script>

<style>
  .field-section { padding: 5.5rem 0; border-top: 1px solid var(--color-border); }
  .section-heading { display: grid; grid-template-columns: .34fr 1fr; gap: 4rem; align-items: start; margin-bottom: 2.75rem; }
  .section-kicker { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .section-heading h2 { max-width: 820px; margin: 0; color: var(--color-ink); font-size: 28px; font-weight: 500; letter-spacing: -.025em; line-height: 1.25; }
  .field-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .field-card { position: relative; display: grid; width: 100%; height: 100%; min-height: 350px; grid-template-rows: 205px 1fr; overflow: hidden; padding: 0; color: inherit; text-align: left; font: inherit; cursor: pointer; background: rgba(255,255,255,.58); border: 1px solid var(--color-border-soft); transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .field-card:hover { background: rgba(255,255,255,.76); border-color: rgba(180,83,9,.32); transform: translateY(-2px); box-shadow: 0 16px 34px rgba(30,50,70,.07); }
  .field-card:focus-visible { outline: 3px solid rgba(180,83,9,.4); outline-offset: 3px; }
  .field-media { position: relative; display: flex; min-width: 0; align-items: center; justify-content: center; padding: .8rem .85rem .3rem; overflow: hidden; border-bottom: 1px solid var(--color-border-soft); }
  .field-media img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .field-content { display: flex; min-width: 0; flex-direction: column; padding: 1.1rem 1.05rem 1.25rem; }
  .field-title { display: grid; grid-template-columns: 1.75rem 1fr; gap: .45rem; align-items: baseline; color: var(--color-ink); }
  .field-title b { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .1em; }
  .field-title strong { font-size: 16px; font-weight: 500; letter-spacing: -.015em; line-height: 1.3; }
  .field-description { display: block; margin: .65rem 0 0; color: var(--color-body); font-size: 13px; line-height: 1.5; }
  .field-mobile-action { display: none; gap: .4rem; align-items: center; margin-top: 1rem; color: var(--color-amber); font-size: 12px; font-weight: 500; letter-spacing: .04em; }
  .field-preview { position: absolute; inset: .75rem; z-index: 2; display: flex; flex-direction: column; justify-content: center; padding: 1.35rem 1.25rem; opacity: 0; background: rgba(249,252,254,.97); border: 1px solid rgba(30,60,100,.18); box-shadow: 0 14px 30px rgba(30,50,70,.1); transform: translateY(8px); transition: opacity .2s ease, transform .2s ease; pointer-events: none; }
  .preview-copy { display: -webkit-box; overflow: hidden; color: var(--color-ink); font-size: 13.5px; font-weight: 500; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .preview-action { display: inline-flex; gap: .4rem; align-items: center; margin-top: 1.1rem; color: var(--color-amber); font-size: 12px; font-weight: 500; letter-spacing: .04em; }
  @media (hover: hover) and (pointer: fine) {
    .field-card:hover .field-preview, .field-card:focus-visible .field-preview { opacity: 1; transform: translateY(0); }
  }

  .field-dialog { position: fixed; inset: 0 0 0 auto; width: clamp(720px, 68vw, 1180px); max-width: 100vw; height: 100dvh; max-height: none; margin: 0; padding: 0; overflow: hidden; color: var(--color-ink); background: transparent; border: 0; }
  .field-dialog::backdrop { background: rgba(15,23,41,.38); backdrop-filter: blur(3px); }
  .drawer { height: 100%; padding: 2.25rem clamp(2rem, 4vw, 4rem) 3rem; overflow-y: auto; background: linear-gradient(180deg, #f9fbfd 0%, #eef3f8 100%); border-left: 1px solid rgba(30,60,100,.2); box-shadow: -18px 0 50px rgba(15,23,41,.14); }
  .field-dialog[open] .drawer { animation: data-ai-drawer-in .24s ease-out both; }
  .drawer-topline { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; }
  .drawer-number { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .drawer-close { display: inline-grid; width: 42px; height: 42px; place-items: center; padding: 0; color: var(--color-ink-2); font: inherit; font-size: 25px; line-height: 1; cursor: pointer; background: rgba(255,255,255,.7); border: 1px solid var(--color-border-soft); transition: color .2s ease, border-color .2s ease; }
  .drawer-close:hover { color: var(--color-amber); border-color: rgba(180,83,9,.35); }
  .drawer-close:focus-visible, .drawer-cta:focus-visible { outline: 3px solid rgba(180,83,9,.4); outline-offset: 3px; }
  .drawer-heading { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: clamp(1.5rem, 3vw, 2.75rem); align-items: center; padding-bottom: 1.8rem; }
  .drawer-icon { display: flex; height: 145px; align-items: center; justify-content: center; background: rgba(255,255,255,.62); border: 1px solid var(--color-border-soft); }
  .drawer-icon img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .drawer-heading h2 { margin: 0; color: var(--color-ink); font-size: clamp(32px, 4vw, 52px); font-weight: 500; letter-spacing: -.04em; line-height: 1.05; }
  .drawer-signature { max-width: 720px; margin: 1rem 0 0; color: var(--color-ink-2); font-size: clamp(18px, 2vw, 25px); font-weight: 400; letter-spacing: -.02em; line-height: 1.3; }
  .drawer-section { padding: 1.35rem 0; border-top: 1px solid var(--color-border-soft); }
  .drawer-section h3 { margin: 0 0 .8rem; color: var(--color-ink-3); font-size: 10.5px; font-weight: 500; letter-spacing: .13em; text-transform: uppercase; }
  .drawer-section p { max-width: 850px; margin: 0; color: var(--color-body); font-size: 14px; line-height: 1.7; }
  .intro-section p { color: var(--color-ink); font-size: 16px; line-height: 1.65; }
  .drawer-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.25rem; border-top: 1px solid var(--color-border-soft); }
  .drawer-columns .drawer-section { border-top: 0; }
  .drawer-section ul { display: grid; gap: .6rem; margin: 0; padding: 0; list-style: none; }
  .drawer-section :global(li) { position: relative; padding-left: 1rem; color: var(--color-body); font-size: 13.5px; line-height: 1.55; }
  .drawer-section :global(li)::before { content: ""; position: absolute; top: .55rem; left: 0; width: 5px; height: 5px; background: var(--color-amber); }
  .drawer-tags, .drawer-trends { display: flex; flex-wrap: wrap; gap: .5rem; }
  .drawer-tags :global(span), .drawer-trends :global(span) { padding: .42rem .6rem; color: var(--color-ink-2); font-size: 11px; font-weight: 500; line-height: 1.15; background: rgba(225,234,243,.72); border: 1px solid var(--color-border-soft); }
  .drawer-trends :global(span) { background: rgba(255,255,255,.5); }
  .drawer-cta { display: inline-flex; gap: .5rem; align-items: center; margin-top: 1.25rem; padding-bottom: .2rem; color: var(--color-amber); font-size: 15px; font-weight: 500; text-decoration: none; border-bottom: 1px solid rgba(180,83,9,.35); }
  .drawer-cta[hidden] { display: none; }
  :global(body.data-ai-dialog-open) { overflow: hidden; }

  @keyframes data-ai-drawer-in {
    from { opacity: .65; transform: translateX(36px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @media (max-width: 1120px) {
    .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
    .field-card { min-height: 395px; grid-template-rows: 245px 1fr; }
    .field-content { padding: 1.25rem 1.35rem 1.4rem; }
    .field-title { grid-template-columns: 2.1rem 1fr; gap: .55rem; }
    .field-title strong { font-size: 18px; }
    .field-description { font-size: 14px; }
  }

  @media (max-width: 900px) {
    .field-dialog { width: 82vw; }
    .drawer-heading { grid-template-columns: 145px minmax(0, 1fr); }
    .drawer-icon { height: 124px; }
  }

  @media (max-width: 760px) {
    .field-section { padding: 4rem 0; }
    .section-heading { grid-template-columns: 1fr; gap: 1rem; margin-bottom: 2rem; }
    .section-heading h2 { font-size: 24px; }
    .field-grid { grid-template-columns: 1fr; }
    .field-card { min-height: 0; grid-template-rows: 230px auto; }
    .field-preview { display: none; }
    .field-mobile-action { display: inline-flex; }
    .field-dialog { inset: 0; width: 100vw; height: 100dvh; }
    .drawer { padding: 1.25rem 1.4rem 2.25rem; border-left: 0; }
    .drawer-heading { grid-template-columns: 92px minmax(0, 1fr); gap: 1rem; padding-bottom: 1.4rem; }
    .drawer-icon { height: 78px; }
    .drawer-heading h2 { font-size: 28px; }
    .drawer-signature { margin-top: .65rem; font-size: 17px; }
    .drawer-columns { grid-template-columns: 1fr; gap: 0; }
    .drawer-columns .drawer-section + .drawer-section { border-top: 1px solid var(--color-border-soft); }
  }

  @media (max-width: 420px) {
    .field-card { grid-template-rows: 205px auto; }
    .field-content { padding: 1.15rem 1.15rem 1.3rem; }
    .drawer-heading { grid-template-columns: 76px minmax(0, 1fr); }
    .drawer-icon { height: 65px; }
    .drawer-heading h2 { font-size: 25px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .field-card, .field-preview { transition: none; }
    .field-dialog[open] .drawer { animation: none; }
  }
</style>
