  "data-ai-operational-steering": "Data & AI",
} : {
  "business-performance-back-on-track": "Geschäftsentwicklung steuern",
  "profitable-customer-base": "Kundenbasis profitabel entwickeln",
  "international-growth-by-market": "Internationales Wachstum skalieren",
  "strategy-to-resource-decisions": "Strategie in Ressourcenentscheidungen übersetzen",
  "data-driven-marketing": "Data-Driven Marketing",
  "web-tracking-marketing-steering": "Tracking & Attribution",
  "shopping-app-customer-touchpoint": "Shopping App",
  "omnichannel-journey-data-integration": "Omnichannel",
  "digital-product-operating-model": "Product Operating Model",
  "data-ai-operational-steering": "Data & AI",
};

const phaseTeaserByPeriod: Record<string, string> = isEnglish ? {
  "2004–2010": "Offer Management, Online Marketing, conversion and digital growth.",
  "2010–2014": "Mobile, Customer Journey and international scaling.",
  "2014–2018": "CRM, Analytics, Personalisation and Customer Value.",
  "2018–2025": "Connecting Marketing, Product, Data and Technology end to end.",
} : {
  "2000–2010": "Angebotssteuerung, Online Marketing, Conversion und digitales Wachstum.",
  "2010–2014": "Mobile, Customer Journey und internationale Skalierung.",
  "2014–2018": "CRM, Analytics, Personalisierung und Customer Value.",
  "2018–2025": "Marketing, Product, Data und Technology End-to-End verbinden.",
};

const commercialCases = initiatives.slice(0, 4);
const selectedInitiatives = initiatives.slice(4);

const layerItems = [
  ...phases.map((phase, index) => ({
    id: `phase-${index + 1}`,
    meta: `${labels.development} · ${phase.period}`,
    title: phase.title,
    subtitle: phase.summary,
    sections: [
      { label: labels.phaseDetail, text: phase.body },
      ...(phase.scale ? [{ label: labels.scale, text: phase.scale }] : []),
    ],
  })),
  ...initiatives.map((initiative, index) => ({
    id: `case-${initiative.id}`,
    meta: `${index < 4 ? labels.commercial : labels.initiatives} · ${String(index < 4 ? index + 1 : index - 3).padStart(2, "0")}`,
    title: initiative.title,
    subtitle: initiative.subtitle,
    sections: [
      { label: labels.context, text: initiative.context },
      { label: labels.role, text: initiative.role },
      { label: labels.change, text: initiative.change },
      { label: labels.perspective, text: initiative.perspective },
    ],
  })),
];

const serializedLayerItems = JSON.stringify(layerItems).replace(/</g, "\\u003c");
---

<section class="perspectives" aria-label={isEnglish ? "Three perspectives on my track record" : "Drei Perspektiven auf meinen Track Record"}>
  <div class="perspective-grid">
    <section class="perspective-column" aria-labelledby="development-column-title">
      <header class="column-header">
        <div class="column-number">01</div>
        <h2 id="development-column-title">{labels.development}</h2>
        <p>{labels.developmentIntro}</p>
      </header>
      <ol class="perspective-list">
        {phases.map((phase, index) => (
          <li>
            <button class="perspective-card" type="button" data-track-record-item={`phase-${index + 1}`} aria-haspopup="dialog" aria-controls="track-record-detail-dialog" aria-expanded="false">
              <span class="card-meta">{phase.period}</span>
              <strong>{phase.title}</strong>
              <span class="card-teaser">{phaseTeaserByPeriod[phase.period] ?? phase.summary}</span>
              <span class="card-action">{labels.explore} <span aria-hidden="true">→</span></span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <section class="perspective-column" aria-labelledby="commercial-column-title">
      <header class="column-header">
        <div class="column-number">02</div>
        <h2 id="commercial-column-title">{labels.commercial}</h2>
        <p>{labels.commercialIntro}</p>
      </header>
      <ol class="perspective-list">
        {commercialCases.map((initiative, index) => (
          <li>
            <button class="perspective-card" type="button" data-track-record-item={`case-${initiative.id}`} aria-haspopup="dialog" aria-controls="track-record-detail-dialog" aria-expanded="false">
              <span class="card-meta">{String(index + 1).padStart(2, "0")}</span>
              <strong>{shortTitleById[initiative.id]}</strong>
              <span class="card-teaser">{initiative.teaser}</span>
              <span class="card-action">{labels.explore} <span aria-hidden="true">→</span></span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    <section class="perspective-column" aria-labelledby="initiatives-column-title">
      <header class="column-header">
        <div class="column-number">03</div>
        <h2 id="initiatives-column-title">{labels.initiatives}</h2>
        <p>{labels.initiativesIntro}</p>
      </header>
      <ol class="perspective-list compact-list">
        {selectedInitiatives.map((initiative, index) => (
          <li>
            <button class="perspective-card compact-card" type="button" data-track-record-item={`case-${initiative.id}`} aria-haspopup="dialog" aria-controls="track-record-detail-dialog" aria-expanded="false">
              <span class="card-meta">{String(index + 1).padStart(2, "0")}</span>
              <strong>{shortTitleById[initiative.id]}</strong>
              <span class="card-teaser">{initiative.teaser}</span>
              <span class="card-action">{labels.explore} <span aria-hidden="true">→</span></span>
            </button>
          </li>
        ))}
      </ol>
    </section>
  </div>
</section>

<dialog class="field-dialog" id="track-record-detail-dialog" aria-labelledby="track-record-dialog-title">
  <div class="drawer">
    <div class="drawer-topline">
      <span class="drawer-meta" id="track-record-dialog-meta"></span>
      <button class="drawer-close" type="button" aria-label={labels.close}>×</button>
    </div>
    <h2 id="track-record-dialog-title"></h2>
    <p class="drawer-subtitle" id="track-record-dialog-subtitle"></p>
    <div id="track-record-dialog-sections"></div>
  </div>
</dialog>

<script type="application/json" id="track-record-layer-data" set:html={serializedLayerItems}></script>

<script>
  const trackRecordDialog = document.querySelector<HTMLDialogElement>("#track-record-detail-dialog");
  const trackRecordDataNode = document.querySelector<HTMLScriptElement>("#track-record-layer-data");
  const trackRecordTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-track-record-item]"));
  const trackRecordCloseButton = trackRecordDialog?.querySelector<HTMLButtonElement>(".drawer-close");
  let activeTrackRecordTrigger: HTMLButtonElement | null = null;

  const trackRecordItems = trackRecordDataNode ? JSON.parse(trackRecordDataNode.textContent || "[]") : [];
  const trackRecordItemsById = new Map(trackRecordItems.map((item: { id: string }) => [item.id, item]));

  function setTrackRecordText(selector: string, value: string) {
    const node = trackRecordDialog?.querySelector<HTMLElement>(selector);
    if (node) node.textContent = value;
  }

  function openTrackRecordDialog(trigger: HTMLButtonElement) {
    if (!trackRecordDialog) return;
    const item = trackRecordItemsById.get(trigger.dataset.trackRecordItem || "");
    if (!item) return;

    activeTrackRecordTrigger = trigger;
    trackRecordTriggers.forEach((entry) => entry.setAttribute("aria-expanded", entry === trigger ? "true" : "false"));
    setTrackRecordText("#track-record-dialog-meta", item.meta);
    setTrackRecordText("#track-record-dialog-title", item.title);
    setTrackRecordText("#track-record-dialog-subtitle", item.subtitle);

    const sections = trackRecordDialog.querySelector<HTMLElement>("#track-record-dialog-sections");
    sections?.replaceChildren(...item.sections.map((section: { label: string; text: string }) => {
      const wrapper = document.createElement("section");
      wrapper.className = "drawer-section";
      const heading = document.createElement("h3");
      heading.textContent = section.label;
      const paragraph = document.createElement("p");
      paragraph.textContent = section.text;
      wrapper.append(heading, paragraph);
      return wrapper;
    }));

    trackRecordDialog.showModal();
    document.body.classList.add("track-record-dialog-open");
    trackRecordCloseButton?.focus();
  }

  trackRecordTriggers.forEach((trigger) => trigger.addEventListener("click", () => openTrackRecordDialog(trigger)));
  trackRecordCloseButton?.addEventListener("click", () => trackRecordDialog?.close());
  trackRecordDialog?.addEventListener("click", (event) => {
    if (event.target === trackRecordDialog) trackRecordDialog.close();
  });
  trackRecordDialog?.addEventListener("close", () => {
    document.body.classList.remove("track-record-dialog-open");
    trackRecordTriggers.forEach((entry) => entry.setAttribute("aria-expanded", "false"));
    activeTrackRecordTrigger?.focus();
    activeTrackRecordTrigger = null;
  });
</script>

<style>
  .perspectives { margin-top: 2rem; }
  .perspective-grid { display: grid; gap: 2.25rem; }
  .perspective-column { min-width: 0; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .column-header { padding-bottom: .85rem; }
  .column-number { margin-bottom: .45rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .12em; }
  .column-header h2 { margin: 0 0 .35rem; color: var(--color-ink); font-size: 23px; font-weight: 500; letter-spacing: -.025em; line-height: 1.15; }
  .column-header p { margin: 0; color: var(--color-ink-2); font-size: 13.5px; line-height: 1.55; }
  .perspective-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 1fr; column-gap: 1rem; row-gap: .75rem; list-style: none; margin: 0; padding: 0; }
  .perspective-list li { display: flex; min-width: 0; }
  .perspective-card { display: flex; width: 100%; height: 100%; min-height: 8.75rem; flex-direction: column; padding: .75rem 1rem; color: inherit; text-align: left; font: inherit; cursor: pointer; background: rgba(255,255,255,.62); border: 1px solid var(--color-border-soft); transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .perspective-card:hover { background: rgba(255,255,255,.82); border-color: rgba(180,83,9,.32); transform: translateY(-2px); box-shadow: 0 12px 26px rgba(30,50,70,.07); }
  .perspective-card:focus-visible, .drawer-close:focus-visible { outline: 3px solid rgba(180,83,9,.4); outline-offset: 3px; }
  .card-meta { margin-bottom: .35rem; color: var(--color-amber); font-size: 10px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  .perspective-card strong { color: var(--color-ink); font-size: 15px; font-weight: 500; letter-spacing: -.01em; line-height: 1.35; }
  .card-teaser { display: -webkit-box; margin-top: .4rem; overflow: hidden; color: var(--color-body); font-size: 12px; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .card-action { display: inline-flex; gap: .35rem; align-items: center; margin-top: auto; padding-top: .5rem; color: var(--color-amber); font-size: 11.5px; font-weight: 500; }
  .compact-card { min-height: 7.25rem; }
  .compact-card .card-teaser { -webkit-line-clamp: 2; }

  .field-dialog { position: fixed; inset: 0 0 0 auto; width: min(570px, 100vw); max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; overflow: visible; color: var(--color-ink); background: transparent; border: 0; }
  .field-dialog::backdrop { background: rgba(15,23,41,.38); backdrop-filter: blur(3px); }
  .drawer { height: 100%; padding: 2.35rem 2.5rem 2.75rem; overflow-y: auto; background: linear-gradient(180deg, #f9fbfd 0%, #eef3f8 100%); border-left: 1px solid rgba(30,60,100,.2); box-shadow: -18px 0 50px rgba(15,23,41,.14); }
  .drawer-topline { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .drawer-meta { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .drawer-close { display: inline-grid; width: 42px; height: 42px; place-items: center; padding: 0; color: var(--color-ink-2); font: inherit; font-size: 25px; line-height: 1; cursor: pointer; background: rgba(255,255,255,.7); border: 1px solid var(--color-border-soft); transition: color .2s ease, border-color .2s ease; }
  .drawer-close:hover { color: var(--color-amber); border-color: rgba(180,83,9,.35); }
  .drawer > h2 { margin: 0 0 .75rem; color: var(--color-ink); font-size: 34px; font-weight: 500; letter-spacing: -.03em; line-height: 1.12; }
  .drawer-subtitle { margin: 0 0 1.7rem; color: var(--color-ink-2); font-size: 15px; line-height: 1.6; }
  :global(.drawer-section) { padding: 1.45rem 0; border-top: 1px solid var(--color-border-soft); }
  :global(.drawer-section h3) { margin: 0 0 .7rem; color: var(--color-ink-3); font-size: 10.5px; font-weight: 500; letter-spacing: .13em; text-transform: uppercase; }
  :global(.drawer-section p) { margin: 0; color: var(--color-body); font-size: 14px; line-height: 1.7; }
  :global(body.track-record-dialog-open) { overflow: hidden; }

  @media (max-width: 1050px) {
    .perspective-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 600px) {
    .perspectives { margin-top: 1.75rem; }
    .perspective-grid { gap: 1.75rem; }
    .perspective-column { padding-top: 1.25rem; }
    .perspective-list { row-gap: .7rem; }
    .perspective-list { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .perspective-list li { display: block; }
    .perspective-card, .compact-card { height: auto; min-height: 0; }
    .field-dialog { inset: auto 0 0; width: 100%; height: min(88dvh, 760px); }
    .drawer { padding: 1.35rem 1.4rem 2rem; border-top: 1px solid rgba(30,60,100,.2); border-left: 0; box-shadow: 0 -18px 50px rgba(15,23,41,.16); }
    .drawer > h2 { font-size: 28px; }
  }
</style>
