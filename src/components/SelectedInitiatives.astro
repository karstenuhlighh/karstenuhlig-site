  "profitable-customer-base": "Develop a profitable customer base",
  "international-growth-by-market": "Scale international growth",
  "strategy-to-resource-decisions": "Translate strategy into resource decisions",
  "data-driven-marketing": "Data-Driven Marketing",
  "web-tracking-marketing-steering": "Tracking & Attribution",
  "shopping-app-customer-touchpoint": "Shopping App",
