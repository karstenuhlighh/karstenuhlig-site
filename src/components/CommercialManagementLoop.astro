---
interface Props {
  title?: string;
  kicker?: string;
  lead?: string;
  language?: "de" | "en";
}

const { language = "de" } = Astro.props;
const isEnglish = language === "en";
const {
  title,
  kicker = isEnglish ? "Steering logic" : "Steuerungslogik",
  lead = isEnglish
    ? "Observation, decision and execution remain connected, turning signals into clear priorities and priorities into economic impact."
    : "Signale helfen nur, wenn daraus Entscheidungen werden. Und Entscheidungen zählen erst, wenn sie in der Umsetzung ankommen.",
} = Astro.props;

const movements = isEnglish ? [
  {
    number: "01",
    title: "Understand",
    sections: [
      ["Outcomes & signals", "Make economic variances, patterns and relevant signals visible."],
      ["Drivers & mechanics", "Go beyond KPIs to understand causes, bottlenecks and the underlying mechanisms of impact."],
    ],
  },
  {
    number: "02",
    title: "Decide",
    sections: [
      ["Priorities & trade-offs", "Make explicit choices where growth, customer value, margin, speed and complexity need to be balanced."],
    ],
  },
  {
    number: "03",
    title: "Drive impact",
    sections: [
      ["Decisions & execution", "Clarify accountability, concentrate resources and align the organisation behind the critical priorities."],
      ["Impact & learning", "Assess real impact rather than activity, then sharpen decisions accordingly."],
    ],
  },
] : [
  {
    number: "01",
    title: "Verstehen",
    sections: [
      ["Ergebnisse & Signale", "Wirtschaftliche Abweichungen, Muster und relevante Signale sichtbar machen."],
      ["Treiber & Mechanik", "Hinter den KPIs die Ursachen, Engpässe und Mechaniken des Geschäfts finden."],
    ],
  },
  {
    number: "02",
    title: "Entscheiden",
    sections: [
      ["Prioritäten & Trade-offs", "Bewusst entscheiden, wo Wachstum, Kundenwert, Marge, Geschwindigkeit und Komplexität gegeneinander abgewogen werden müssen."],
    ],
  },
  {
    number: "03",
    title: "Umsetzen",
    sections: [
      ["Entscheidungen & Umsetzung", "Verantwortung klären, Ressourcen konzentrieren und die Organisation auf die entscheidenden Prioritäten ausrichten."],
      ["Lernen & Nachschärfen", "Prüfen, was tatsächlich im Geschäft ankommt, und nachschärfen."],
    ],
  },
];

const outcomes = isEnglish
  ? ["Growth", "Customer Value", "Margin", "Competitiveness"]
  : ["Wachstum", "Kundenwert", "Marge", "Wettbewerbsfähigkeit"];
---

<section class="steering-section" aria-labelledby="steering-title">
  <div class="steering-heading">
    <div class="steering-kicker">{kicker}</div>
    {title && <h2 id="steering-title">{title}</h2>}
    <p id={title ? undefined : "steering-title"}>{lead}</p>
  </div>

  <ol class="movements">
    {movements.map((movement) => (
      <li class="movement">
        <div class="movement-header"><span>{movement.number}</span><h3>{movement.title}</h3></div>
        <div class="movement-content">
          {movement.sections.map(([heading, body]) => (
            <div>
              <h4>{heading}</h4>
              <p>{body}</p>
            </div>
          ))}
        </div>
      </li>
    ))}
  </ol>

  <p class="outcomes">{outcomes.map((outcome, index) => <>{index > 0 && <span>·</span>}{outcome}</>)}</p>
</section>

<style>
  .steering-section { margin-top: 4.75rem; padding-top: 3.75rem; border-top: 1px solid var(--color-border); }
  .steering-heading { margin-bottom: 2.25rem; }
  .steering-kicker { margin-bottom: .75rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .13em; text-transform: uppercase; }
  .steering-heading h2 { margin: 0 0 .7rem; color: var(--color-ink); font-size: 32px; font-weight: 500; letter-spacing: -.03em; line-height: 1.15; }
  .steering-heading > p { margin: 0; color: var(--color-ink-2); font-size: 15px; line-height: 1.7; text-align: left; white-space: nowrap; }
  .movements { display: grid; grid-template-columns: 1.05fr .9fr 1.05fr; grid-auto-rows: 1fr; align-items: stretch; list-style: none; margin: 0; padding: 0; background: rgba(255,255,255,.38); border: 1px solid var(--color-border-soft); }
  .movement { display: flex; min-width: 0; height: 100%; flex-direction: column; padding: 2rem 1.75rem 2.15rem; }
  .movement + .movement { border-left: 1px solid var(--color-border-soft); }
  .movement-header { display: flex; align-items: baseline; gap: .8rem; padding-bottom: 1.2rem; border-bottom: 2px solid rgba(180,83,9,.66); }
  .movement-header span { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .1em; }
  h3 { margin: 0; color: var(--color-ink); font-size: 18px; font-weight: 500; letter-spacing: .04em; line-height: 1.25; text-transform: uppercase; }
  .movement-content { flex: 1; }
  .movement-content > div { padding-top: 1.25rem; }
  .movement-content > div + div { margin-top: 1.25rem; border-top: 1px solid var(--color-border-soft); }
  h4 { margin: 0 0 .55rem; color: var(--color-ink); font-size: 14px; font-weight: 500; line-height: 1.4; }
  .movement-content p { margin: 0; color: var(--color-body); font-size: 13.5px; line-height: 1.65; }
  .outcomes { margin: 0; padding: 1.3rem 1.75rem; color: var(--color-ink-3); font-size: 12px; font-weight: 500; letter-spacing: .08em; text-align: center; text-transform: uppercase; border: 1px solid var(--color-border-soft); border-top: 0; }
  .outcomes span { padding: 0 .7rem; color: var(--color-amber); }
  @media (max-width: 860px) {
    .steering-heading > p { white-space: normal; }
    .movements { grid-template-columns: 1fr; }
    .movement + .movement { border-top: 1px solid var(--color-border-soft); border-left: 0; }
  }
  @media (max-width: 640px) {
    .steering-section { margin-top: 3.5rem; padding-top: 3rem; }
    .steering-heading h2 { font-size: 27px; }
    .movement { padding: 1.5rem 1.35rem 1.7rem; }
    .outcomes { line-height: 1.9; }
  }
</style>
