---
import { getLanguage, getLanguageSwitchPath, type Language } from "../i18n/routes";

interface Props {
  language?: Language;
}

const { language = getLanguage(Astro.url.pathname) } = Astro.props;
const isEnglish = language === "en";
const homePath = isEnglish ? "/en/" : "/";
const commercialPath = isEnglish ? "/en/commercial-management" : "/commercial-management";
const dataPath = isEnglish ? "/en/data-ai-digital-product" : "/data-ai-digital-product";
const productPath = isEnglish ? "/en/digital-product-customer-experience" : "/digital-product-customer-experience";
const leadershipPath = isEnglish ? "/en/leadership" : "/leadership";
const aboutPath = isEnglish ? "/en/track-record" : "/track-record";
const deSwitchPath = getLanguageSwitchPath(Astro.url.pathname, "de");
const enSwitchPath = getLanguageSwitchPath(Astro.url.pathname, "en");

const navMenus = [
  {
    id: "commercial",
    label: "Commercial",
    ariaLabel: "Commercial",
    items: [
      {
        href: commercialPath,
        title: "Commercial Management",
        subline: isEnglish ? "Overview and management system" : "Übersicht und Managementsystem",
      },
      {
        href: `${commercialPath}#commercial-fields`,
        title: isEnglish ? "8 Management Areas" : "8 Handlungsfelder",
      },
      {
        href: `${commercialPath}#mechanics-title`,
        title: isEnglish ? "Models & Mechanics" : "Modelle & Mechanik",
      },
      {
        href: `${commercialPath}#steering-title`,
        title: isEnglish ? "Steering Logic" : "Steuerungslogik",
      },
      {
        href: `${commercialPath}#tensions-title`,
        title: isEnglish ? "Executive Tensions" : "Executive-Spannungsfelder",
      },
    ],
  },
  {
    id: "leadership",
    label: "Leadership",
    ariaLabel: isEnglish ? "Leadership" : "Leadership",
    items: [
      {
        href: leadershipPath,
        title: "Leadership & Transformation",
        subline: isEnglish ? "Overview and leadership approach" : "Übersicht und Führungsansatz",
      },
      {
        href: `${leadershipPath}#leadership-autonomy-performance`,
        title: isEnglish ? "Autonomy & Performance" : "Autonomie & Performance",
      },
      {
        href: `${leadershipPath}#leadership-direction-decisions`,
        title: isEnglish ? "Direction & Decisions" : "Richtung & Entscheidungen",
      },
      {
        href: `${leadershipPath}#leadership-matrix-stakeholders`,
        title: isEnglish ? "Matrix & Stakeholders" : "Matrix & Stakeholder",
      },
      {
        href: `${leadershipPath}#leadership-transformation-change`,
        title: "Transformation & Change",
      },
    ],
  },
  {
    id: "data-ai-product",
    label: "Data, AI & Digital Product",
    ariaLabel: isEnglish ? "Data, AI and Digital Product" : "Data, AI und Digital Product",
    items: [
      {
        href: dataPath,
        title: "Data, AI & Decisioning",
        subline: isEnglish ? "Better commercial decisions" : "Bessere kommerzielle Entscheidungen",
      },
      {
        href: productPath,
        title: "Digital Product & Customer Experience",
        subline: isEnglish ? "Design effective products and journeys" : "Produkte und Journeys wirksam gestalten",
      },
    ],
  },
];
---

<nav class="nav" aria-label={isEnglish ? "Main navigation" : "Hauptnavigation"} data-site-nav>
  <div class="nav-left">
    <a href={homePath} class="nav-logo">Karsten Uhlig</a>
    <button
      class="nav-mobile-toggle"
      type="button"
      aria-expanded="false"
      aria-controls={`mobile-navigation-${language}`}
      aria-label={isEnglish ? "Open menu" : "Menü öffnen"}
      data-open-label={isEnglish ? "Open menu" : "Menü öffnen"}
      data-close-label={isEnglish ? "Close menu" : "Menü schließen"}
      data-mobile-nav-trigger
    >
      <span class="nav-mobile-icon" aria-hidden="true"></span>
    </button>
    <div class="nav-items" id={`mobile-navigation-${language}`} data-mobile-nav-items>
      {navMenus.map((menu) => (
        <div class="nav-menu" data-nav-menu>
          <button
            class="nav-link nav-trigger"
            type="button"
            aria-expanded="false"
            aria-controls={`${menu.id}-navigation-${language}`}
            aria-haspopup="true"
            data-nav-trigger
          >
            <span>{menu.label}</span>
            <svg class="nav-chevron" viewBox="0 0 10 6" aria-hidden="true">
              <path d="m1 1 4 4 4-4" />
            </svg>
          </button>

          <ul
            class="nav-dropdown"
            id={`${menu.id}-navigation-${language}`}
            aria-label={menu.ariaLabel}
            data-nav-dropdown
            hidden
          >
            {menu.items.map((item) => (
              <li>
                <a class:list={["nav-dropdown-link", { "nav-dropdown-link--compact": !item.subline }]} href={item.href}>
                  <span class="nav-dropdown-title">{item.title}</span>
                  {item.subline && <span class="nav-dropdown-subline">{item.subline}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <a href={aboutPath} class="nav-link">{isEnglish ? "About" : "Über mich"}</a>
      <span class="language-switch" aria-label={isEnglish ? "Language selection" : "Sprachauswahl"}>
        <a href={deSwitchPath} hreflang="de" lang="de" aria-current={!isEnglish ? "page" : undefined}>DE</a>
        <span aria-hidden="true">·</span>
        <a href={enSwitchPath} hreflang="en-GB" lang="en" aria-current={isEnglish ? "page" : undefined}>EN</a>
      </span>
    </div>
  </div>
</nav>

<script>
  const hoverQuery = window.matchMedia("(hover: hover) and (pointer: fine)");
  const mobileQuery = window.matchMedia("(max-width: 768px)");

  document.querySelectorAll<HTMLElement>("[data-nav-menu]").forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>("[data-nav-trigger]");
    const dropdown = menu.querySelector<HTMLElement>("[data-nav-dropdown]");
    const dropdownLinks = Array.from(menu.querySelectorAll<HTMLAnchorElement>(".nav-dropdown-link"));

    if (!trigger || !dropdown) return;

    let hoverOpened = false;
    let closeTimer: number | undefined;

    const isOpen = () => trigger.getAttribute("aria-expanded") === "true";

    const openMenu = (options: { focus?: "first" | "last"; viaHover?: boolean } = {}) => {
      window.clearTimeout(closeTimer);
      document.dispatchEvent(new CustomEvent("nav-menu-open", { detail: menu }));
      dropdown.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      menu.classList.add("is-open");
      hoverOpened = options.viaHover ?? false;

      if (options.focus) {
        const target = options.focus === "first" ? dropdownLinks[0] : dropdownLinks.at(-1);
        target?.focus();
      }
    };

    const closeMenu = (returnFocus = false) => {
      window.clearTimeout(closeTimer);
      dropdown.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      menu.classList.remove("is-open");
      hoverOpened = false;
      if (returnFocus) trigger.focus();
    };

    trigger.addEventListener("click", () => {
      if (isOpen() && !hoverOpened) {
        closeMenu();
        return;
      }

      openMenu();
    });

    menu.addEventListener("mouseenter", () => {
      if (!hoverQuery.matches || mobileQuery.matches || isOpen()) return;
      openMenu({ viaHover: true });
    });

    menu.addEventListener("mouseleave", () => {
      if (!hoverQuery.matches || !hoverOpened) return;
      closeTimer = window.setTimeout(() => {
        if (!menu.matches(":focus-within")) closeMenu();
      }, 100);
    });

    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen()) {
        event.preventDefault();
        closeMenu(true);
        return;
      }

      if (event.target === trigger && (event.key === "ArrowDown" || event.key === "ArrowUp")) {
        event.preventDefault();
        openMenu({ focus: event.key === "ArrowDown" ? "first" : "last" });
        return;
      }

      const linkIndex = dropdownLinks.indexOf(event.target as HTMLAnchorElement);
      if (linkIndex < 0 || (event.key !== "ArrowDown" && event.key !== "ArrowUp")) return;

      event.preventDefault();
      const direction = event.key === "ArrowDown" ? 1 : -1;
      const nextIndex = (linkIndex + direction + dropdownLinks.length) % dropdownLinks.length;
      dropdownLinks[nextIndex]?.focus();
    });

    menu.addEventListener("focusout", () => {
      window.setTimeout(() => {
        if (!menu.contains(document.activeElement)) closeMenu();
      });
    });

    document.addEventListener("pointerdown", (event) => {
      const target = event.target as Element | null;
      if (isOpen() && target && !menu.contains(target) && !target.closest("[data-nav-menu]")) closeMenu();
    });

    document.addEventListener("nav-menu-open", (event) => {
      if ((event as CustomEvent<HTMLElement>).detail !== menu && isOpen()) closeMenu();
    });

    document.addEventListener("mobile-nav-close", () => {
      if (isOpen()) closeMenu();
    });
  });

  const siteNav = document.querySelector<HTMLElement>("[data-site-nav]");
  const mobileNavTrigger = siteNav?.querySelector<HTMLButtonElement>("[data-mobile-nav-trigger]");
  const mobileNavItems = siteNav?.querySelector<HTMLElement>("[data-mobile-nav-items]");

  if (siteNav && mobileNavTrigger && mobileNavItems) {
    const setMobileNavOpen = (open: boolean, returnFocus = false) => {
      siteNav.classList.toggle("is-mobile-open", open);
      mobileNavTrigger.setAttribute("aria-expanded", String(open));
      mobileNavTrigger.setAttribute(
        "aria-label",
        open ? mobileNavTrigger.dataset.closeLabel ?? "Close menu" : mobileNavTrigger.dataset.openLabel ?? "Open menu",
      );

      if (!open) {
        document.dispatchEvent(new CustomEvent("mobile-nav-close"));
        if (returnFocus) mobileNavTrigger.focus();
      }
    };

    mobileNavTrigger.addEventListener("click", () => {
      setMobileNavOpen(mobileNavTrigger.getAttribute("aria-expanded") !== "true");
    });

    mobileNavItems.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("click", () => setMobileNavOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && mobileNavTrigger.getAttribute("aria-expanded") === "true") {
        event.preventDefault();
        setMobileNavOpen(false, true);
      }
    });

    document.addEventListener("pointerdown", (event) => {
      const target = event.target as Node | null;
      if (target && mobileNavTrigger.getAttribute("aria-expanded") === "true" && !siteNav.contains(target)) {
        setMobileNavOpen(false);
      }
    });

    mobileQuery.addEventListener("change", () => setMobileNavOpen(false));
  }
</script>

<style>
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 6rem;
  }
  .nav-left,
  .nav-items {
    display: flex;
    align-items: baseline;
  }
  .nav-left {
    gap: 1.1rem;
  }
  .nav-items {
    flex-wrap: wrap;
    gap: 1.1rem;
  }
  .nav-logo {
    flex: 0 0 auto;
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .nav-logo:hover {
    opacity: 0.7;
  }
  .nav-mobile-toggle {
    display: none;
  }
  .nav-link {
    color: var(--color-ink-2);
    font-size: 14px;
  }
  .nav-link {
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .language-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-ink-3);
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .language-switch a {
    color: inherit;
    text-decoration: none;
  }
  .language-switch a:hover,
  .language-switch a[aria-current="page"] {
    color: var(--color-ink);
  }
  .language-switch a:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 4px;
  }
  .nav-link:hover,
  .nav-trigger[aria-expanded="true"] {
    color: var(--color-ink);
  }
  .nav-logo:focus-visible,
  .nav-link:focus-visible,
  .nav-dropdown-link:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 4px;
  }
  .nav-menu {
    position: relative;
    display: flex;
    align-items: center;
  }
  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    font-family: inherit;
    line-height: inherit;
    cursor: pointer;
    background: none;
    border: 0;
  }
  .nav-chevron {
    width: 10px;
    height: 6px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }
  .nav-trigger[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
  }
  .nav-dropdown {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.7rem);
    left: -1rem;
    display: grid;
    width: min(25rem, calc(100vw - 3rem));
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: rgba(249, 252, 254, 0.97);
    border: 1px solid var(--color-border-soft);
    box-shadow: 0 14px 30px rgba(30, 50, 70, 0.1);
  }
  .nav-dropdown-link {
    display: grid;
    min-height: 3.9rem;
    align-content: center;
    gap: 0.1rem;
    padding: 0.55rem 0.75rem;
    color: var(--color-ink);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .nav-dropdown-link:hover,
  .nav-dropdown-link:focus-visible {
    background: rgba(255, 255, 255, 0.72);
    border-color: var(--color-border-soft);
  }
  .nav-dropdown-link--compact {
    min-height: 2.8rem;
    padding-block: 0.45rem;
  }
  .nav-dropdown-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.25;
  }
  .nav-dropdown-subline {
    color: var(--color-ink-3);
    font-size: 12px;
    line-height: 1.3;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-dropdown::before {
      position: absolute;
      right: 0;
      bottom: 100%;
      left: 0;
      height: 0.7rem;
      content: "";
    }
  }
  @media (max-width: 900px) {
    .nav-left,
    .nav-items {
      gap: 0.65rem 1rem;
    }
  }

  @media (max-width: 768px) {
    .nav {
      align-items: center;
      margin-bottom: 2rem;
    }
    .nav-left {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      width: 100%;
      gap: 0;
    }
    .nav-logo {
      white-space: nowrap;
    }
    .nav-mobile-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      padding: 0;
      color: var(--color-ink-2);
      cursor: pointer;
      background: transparent;
      border: 0;
    }
    .nav-mobile-toggle:focus-visible {
      outline: 2px solid var(--color-amber);
      outline-offset: 2px;
    }
    .nav-mobile-icon,
    .nav-mobile-icon::before,
    .nav-mobile-icon::after {
      display: block;
      width: 18px;
      height: 1px;
      background: currentColor;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }
    .nav-mobile-icon {
      position: relative;
    }
    .nav-mobile-icon::before,
    .nav-mobile-icon::after {
      position: absolute;
      left: 0;
      content: "";
    }
    .nav-mobile-icon::before {
      top: -5px;
    }
    .nav-mobile-icon::after {
      top: 5px;
    }
    .nav-mobile-toggle[aria-expanded="true"] .nav-mobile-icon {
      background: transparent;
    }
    .nav-mobile-toggle[aria-expanded="true"] .nav-mobile-icon::before {
      transform: translateY(5px) rotate(45deg);
    }
    .nav-mobile-toggle[aria-expanded="true"] .nav-mobile-icon::after {
      transform: translateY(-5px) rotate(-45deg);
    }
    .nav-items {
      display: none;
      grid-column: 1 / -1;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 0;
      margin-top: 0.5rem;
      padding-top: 0.55rem;
      border-top: 1px solid var(--color-border);
    }
    .nav.is-mobile-open .nav-items {
      display: flex;
    }
    .nav-link {
      font-size: 14px;
    }
    .nav-items > .nav-link,
    .language-switch {
      padding: 0.65rem 0;
    }
    .nav-menu {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .nav-trigger {
      justify-content: space-between;
      width: 100%;
      padding: 0.65rem 0;
    }
    .nav-menu.is-open {
      align-items: stretch;
    }
    .nav-dropdown {
      position: static;
      width: 100%;
      margin: 0 0 0.35rem;
      box-shadow: none;
    }
    .nav-dropdown-link {
      padding: 0.55rem 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-chevron,
    .nav-mobile-icon,
    .nav-mobile-icon::before,
    .nav-mobile-icon::after {
      transition: none;
    }
  }
</style>
