---
import { commercialFields } from "../data/commercial-questions";
---

<section class="motif-section" aria-labelledby="motif-title">
  <div class="motif-heading">
    <div class="motif-kicker">Commercial Management</div>
    <h2 id="motif-title">Das wirtschaftliche Gesamtsystem verstehen, priorisieren und über Funktionsgrenzen hinweg wirksam steuern.</h2>
  </div>

  <ol class="motif-grid">
    {
      commercialFields.map((motif) => (
        <li>
          <a class="motif-card" href="/commercial-management">
            <span class="image-frame">
              <img src={motif.image} alt={motif.alt} width="400" height="340" loading="lazy" />
            </span>
            <span class="motif-label"><b>{motif.number}</b><span>{motif.shortTitle}</span></span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .motif-section { margin-top: 4.5rem; padding-top: 3.5rem; border-top: 1px solid var(--color-border); }
  .motif-heading { margin-bottom: 2rem; }
  .motif-kicker { margin-bottom: .8rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .13em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--color-ink-2); font-size: 15px; font-weight: 400; letter-spacing: 0; line-height: 1.7; white-space: nowrap; }
  .motif-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; list-style: none; margin: 0; padding: 0; }
  .motif-card { display: flex; height: 100%; min-height: 235px; flex-direction: column; justify-content: space-between; padding: 1rem 1rem 1.1rem; color: inherit; text-decoration: none; background: rgba(255,255,255,.56); border: 1px solid var(--color-border-soft); transition: background .2s ease, border-color .2s ease, transform .2s ease; }
  a.motif-card:hover { background: rgba(255,255,255,.78); border-color: rgba(180,83,9,.34); transform: translateY(-2px); }
  .image-frame { display: flex; height: 168px; align-items: center; justify-content: center; overflow: visible; }
  img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .motif-label { display: grid; grid-template-columns: 1.8rem 1fr; gap: .45rem; align-items: baseline; padding-top: .85rem; color: var(--color-ink); font-size: 14px; font-weight: 500; line-height: 1.3; border-top: 1px solid var(--color-border-soft); }
  .motif-label b { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .08em; }
  @media (max-width: 980px) {
    .motif-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .image-frame { height: 210px; }
  }
  @media (max-width: 640px) {
    .motif-section { margin-top: 3.5rem; padding-top: 2.75rem; }
    h2 { font-size: 15px; }
    .motif-grid { grid-template-columns: 1fr; }
    .motif-card { min-height: 260px; }
    .image-frame { height: 210px; }
  }
</style>
