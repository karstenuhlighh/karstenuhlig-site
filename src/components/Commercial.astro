---
import CommercialManagementLoop from "./CommercialManagementLoop.astro";
import type { Language } from "../i18n/routes";

interface Props { language?: Language; }

const { language = "de" } = Astro.props;
const isEnglish = language === "en";

const sectionCopy = isEnglish ? {
  capabilitiesLabel: "My focus areas",
  practiceLabel: "Practice & Proof",
  deepen: "Explore competency",
  viewCase: "View case",
} : {
  capabilitiesLabel: "Meine Schwerpunkte",
  practiceLabel: "Practice & Proof",
  deepen: "Bereich vertiefen",
  viewCase: "Case ansehen",
};

const rows = isEnglish ? [
  {
    capabilityTitle: "E-Commerce, Growth & CRM",
    capabilityBody: "Steer customer base, growth, margin and marketing investment as one system.",
    capabilityHref: "/en/commercial-management",
    visual: "/images/homepage/20-crm-lifecycle-category.png",
    visualFit: "contain",
    caseTitle: "Integrated CRM",
    caseBody: "Building integrated CRM and customer steering across the full lifecycle.",
    caseHref: "/en/integrated-crm",
    secondary: { label: "Performance Marketing Steering", href: "/en/performance-marketing-steering" },
  },
  {
    capabilityTitle: "Data, AI & Decisioning",
    capabilityBody: "Translate customer data, analytics and AI into better operational and commercial decisions.",
    capabilityHref: "/en/data-ai-digital-product",
    visual: "/images/homepage/12-data-ai-category.png",
    visualFit: "contain",
    caseTitle: "Marketing Decisioning Capability",
    caseBody: "From fragmented marketing steering to an integrated Data and Decisioning Capability.",
    caseHref: "/en/data-ai-digital-product#marketing-decisioning-case-title",
    secondary: { label: "Current AI Explorations", href: "/en/data-ai-digital-product#current-proof-title" },
  },
  {
    capabilityTitle: "Digital Product & Customer Experience",
    capabilityBody: "Advance webshop, app, customer journeys and commerce platforms.",
    capabilityHref: "/en/digital-product-customer-experience",
    visual: "/images/homepage/22-digital-product-category.png",
    visualFit: "contain",
    caseTitle: "Webshop & App Modernisation",
    caseBody: "A new commerce architecture, phased migration and the app as a distinct customer touchpoint.",
    caseHref: "/en/digital-product-customer-experience#commerce-case-title",
  },
  {
    capabilityTitle: "Leadership & Transformation",
    capabilityBody: "Lead teams, clarify accountability and make change effective.",
    capabilityHref: "/en/leadership",
    visual: "/images/homepage/14-leadership-category.png",
    visualFit: "contain",
    caseTitle: "From projects to product teams with outcome accountability",
    caseBody: "A cross-functional product organisation with clear end-to-end accountability.",
    caseHref: "/en/transformation/product-organisation",
  },
] : [
  {
    capabilityTitle: "E-Commerce, Growth & CRM",
    capabilityBody: "Kundenbasis, Wachstum, Marge und Marketinginvestitionen zusammen steuern.",
    capabilityHref: "/commercial-management",
    visual: "/images/homepage/20-crm-lifecycle-category.png",
    visualFit: "contain",
    caseTitle: "Integriertes CRM",
    caseBody: "Aufbau einer kanalübergreifenden CRM- und Kundensteuerung über den gesamten Lifecycle.",
    caseHref: "/integriertes-crm",
    secondary: { label: "Performance Marketing Steering", href: "/performance-marketing-steering" },
  },
  {
    capabilityTitle: "Data, AI & Decisioning",
    capabilityBody: "Customer Data, Analytics und AI in bessere operative und kommerzielle Entscheidungen übersetzen.",
    capabilityHref: "/data-ai-digital-product",
    visual: "/images/homepage/12-data-ai-category.png",
    visualFit: "contain",
    caseTitle: "Marketing Decisioning Capability",
    caseBody: "Von fragmentierter Marketingsteuerung zur integrierten Data- und Decisioning-Capability.",
    caseHref: "/data-ai-digital-product#marketing-decisioning-case-title",
    secondary: { label: "Current AI Explorations", href: "/data-ai-digital-product#current-proof-title" },
  },
  {
    capabilityTitle: "Digital Product & Customer Experience",
    capabilityBody: "Webshop, App, Customer Journeys und Commerce-Plattformen weiterentwickeln.",
    capabilityHref: "/digital-product-customer-experience",
    visual: "/images/homepage/22-digital-product-category.png",
    visualFit: "contain",
    caseTitle: "Webshop & App Modernisierung",
    caseBody: "Neue Commerce-Architektur, schrittweise Migration und die App als eigenständiger Kundenkontaktpunkt.",
    caseHref: "/digital-product-customer-experience#commerce-case-title",
  },
  {
    capabilityTitle: "Leadership & Transformation",
    capabilityBody: "Teams führen, Verantwortung klären und Veränderung wirksam gestalten.",
    capabilityHref: "/leadership",
    visual: "/images/homepage/14-leadership-category.png",
    visualFit: "contain",
    caseTitle: "Von Projekten zu Produktteams mit Ergebnisverantwortung",
    caseBody: "Crossfunktionale Produktorganisation mit klarer End-to-End-Verantwortung.",
    caseHref: "/transformation/product-organisation",
  },
];
---

<section class="commercial-pillar" id="commercial-management">
  <div class="editorial-showcase" aria-label={isEnglish ? "Competencies and practice" : "Kompetenzen und Praxis"}>
    <header class="showcase-header">
      <div class="column-labels" aria-hidden="true">
        <span>{sectionCopy.capabilitiesLabel}</span>
        <span>{sectionCopy.practiceLabel}</span>
      </div>
    </header>

    <div class="editorial-rows">
      {rows.map((row) => (
        <article class="editorial-row">
          <div class="capability">
            <div class="capability-copy">
              <h2>{row.capabilityTitle}</h2>
              <p>{row.capabilityBody}</p>
              <a href={row.capabilityHref}>{sectionCopy.deepen} <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <a class="row-visual" href={row.caseHref} aria-label={`${row.caseTitle}: ${sectionCopy.viewCase}`}>
            <img src={row.visual} alt="" width="1680" height="945" loading="lazy" decoding="async" style={`object-fit:${row.visualFit ?? "cover"};object-position:${row.visualPosition ?? "center"}`} />
          </a>

          <div class="case-copy">
            <h3>{row.caseTitle}</h3>
            <p>{row.caseBody}</p>
            <div class="case-links">
              <a href={row.caseHref}>{sectionCopy.viewCase} <span aria-hidden="true">↗</span></a>
              {row.secondary && (
                <>
                  <span class="link-divider" aria-hidden="true"></span>
                  <a href={row.secondary.href}>{row.secondary.label} <span aria-hidden="true">↗</span></a>
                </>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <slot name="before-steering" />
  <CommercialManagementLoop language={language} />
</section>

<style>
  .commercial-pillar { position: relative; padding-top: 2rem; }
  .editorial-showcase { padding: 1rem 0 4.5rem; border-bottom: 1px solid var(--color-border); }
  .showcase-header { padding: 0 1rem 1rem; }
  .column-labels { display: grid; grid-template-columns: minmax(340px, .95fr) minmax(330px, 1.05fr) minmax(330px, 1.1fr); padding-bottom: .9rem; border-bottom: 1px solid rgba(30,60,100,.16); color: var(--color-ink); font-size: 12px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; }
  .column-labels span:last-child { grid-column: 3; padding-left: 1.55rem; }
  .editorial-rows { display: grid; gap: .75rem; }
  .editorial-row { display: grid; grid-template-columns: minmax(340px, .95fr) minmax(330px, 1.05fr) minmax(330px, 1.1fr); min-height: 190px; overflow: hidden; background: linear-gradient(112deg, rgba(255,249,245,.8) 0%, rgba(255,255,255,.72) 34%, rgba(247,251,255,.78) 100%); border: 1px solid rgba(30,60,100,.1); border-radius: 16px; box-shadow: 0 12px 28px rgba(26,53,84,.07); }
  .capability { display: flex; min-width: 0; padding: 1.6rem 1.1rem 1.45rem 1.35rem; }
  .capability-copy { display: flex; min-width: 0; height: 100%; flex-direction: column; }
  .capability-copy h2, .case-copy h3 { margin: 0; color: var(--color-ink); font-size: 25px; font-weight: 600; letter-spacing: -.035em; line-height: 1.12; }
  .capability-copy p, .case-copy p { margin: .65rem 0 0; color: var(--color-body); font-size: 14px; font-weight: 400; line-height: 1.48; }
  .capability-copy > a, .case-links a { display: inline-flex; gap: .4rem; align-items: center; color: #d84b00; font-size: 13px; font-weight: 500; line-height: 1.35; text-decoration: none; }
  .capability-copy > a { align-self: flex-start; margin-top: auto; padding-top: 1rem; }
  .capability-copy a:hover, .case-links a:hover { opacity: .72; }
  .capability-copy a:focus-visible, .row-visual:focus-visible, .case-links a:focus-visible { outline: 3px solid rgba(216,75,0,.34); outline-offset: 3px; }
  .row-visual { position: relative; min-width: 0; min-height: 0; margin: .75rem 0; overflow: hidden; background: rgba(238,244,249,.9); border-radius: 12px; }
  .row-visual img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; transition: transform .35s ease; }
  .row-visual:hover img { transform: scale(1.018); }
  .editorial-row:nth-child(3) .row-visual img { transform: translate(-2.5%, -2%) scale(1.12); transform-origin: center top; }
  .editorial-row:nth-child(3) .row-visual:hover img { transform: translate(-2.5%, -2%) scale(1.14); }
  .case-copy { display: flex; min-width: 0; flex-direction: column; justify-content: center; padding: 1.35rem 1.55rem 1.3rem; }
  .case-copy p { max-width: 450px; }
  .case-links { display: flex; flex-wrap: wrap; gap: .55rem 1rem; align-items: center; margin-top: auto; padding-top: 1rem; }
  .link-divider { width: 1px; height: 1rem; background: rgba(30,60,100,.25); }
  @media (max-width: 1180px) {
    .showcase-header { padding-inline: 0; }
    .column-labels, .editorial-row { grid-template-columns: minmax(285px, .92fr) minmax(280px, 1.02fr) minmax(315px, 1.06fr); }
    .column-labels span:last-child { padding-left: 1.2rem; }
    .capability { padding-inline: 1rem; }
    .case-copy { padding-inline: 1.2rem; }
  }
  @media (max-width: 900px) {
    .column-labels { grid-template-columns: 1fr; }
    .column-labels span:last-child { display: none; }
    .editorial-row { grid-template-columns: minmax(300px,.9fr) minmax(0,1.1fr); grid-template-areas: "capability capability" "visual case"; }
    .capability { grid-area: capability; min-height: 0; padding: 1.35rem; border-bottom: 1px solid rgba(30,60,100,.1); }
    .capability-copy > a { margin-top: .9rem; padding-top: 0; }
    .row-visual { grid-area: visual; min-height: 190px; margin: .85rem 0 .85rem .85rem; }
    .case-copy { grid-area: case; min-height: 210px; }
    .capability-copy h2, .case-copy h3 { font-size: 22px; }
  }
  @media (max-width: 768px) {
    .commercial-pillar { padding-top: 1.5rem; }
    .editorial-showcase { padding: .75rem 0 3.25rem; }
    .editorial-rows { gap: 1rem; }
    .editorial-row { display: flex; min-height: 0; flex-direction: column; border-radius: 14px; }
    .capability { display: flex; padding: 1.3rem 1.15rem; }
    .row-visual { width: auto; height: 205px; min-height: 0; margin: .85rem 1rem 0; }
    .case-copy { min-height: 0; padding: 1.25rem 1.15rem 1.4rem; }
    .case-links { margin-top: .9rem; padding-top: 0; }
  }
  @media (max-width: 390px) {
    .capability-copy h2, .case-copy h3 { font-size: 21px; }
    .capability { padding-inline: .9rem; }
    .row-visual { height: 180px; margin-inline: .75rem; }
    .case-copy { padding-inline: .95rem; }
    .case-links { align-items: flex-start; flex-direction: column; }
    .link-divider { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .row-visual img { transition: none; } }
</style>
