---
import CommercialManagementLoop from "./CommercialManagementLoop.astro";
import type { Language } from "../i18n/routes";

interface Props {
  language?: Language;
}

const { language = "de" } = Astro.props;
const isEnglish = language === "en";
const prefix = isEnglish ? "/en" : "";

const germanEnablers = [
  {
    id: "leadership",
    title: "Leadership & Transformation",
    thesis: "Strategie in Organisation und Umsetzung übersetzen.",
    body: "Richtung geben, Verantwortung klären und die Organisation auf die entscheidenden Prioritäten ausrichten. Vor dem Instrument steht die Klärung: Was ist die Ursache, welche Entscheidung fehlt, wer steht für das Ergebnis gerade?",
    links: [{ href: "/leadership", label: "Leadership vertiefen" }],
  },
  {
    id: "data-ai-digital-product",
    title: "Data, AI & Digital Product",
    thesis: "Aus Daten bessere kommerzielle Entscheidungen machen.",
    body: "Entscheidend ist nicht das Modell allein, sondern ob Kundenverhalten, Analytics und Predictive AI zu klaren Entscheidungen im Geschäft führen. Digitale Produkte beginnen bei einem klaren Kundenproblem und brauchen saubere Ownership und Priorisierung.",
    links: [
      { href: "/data-ai-digital-product", label: "Data, AI & Decisioning" },
      { href: "/digital-product-customer-experience", label: "Digital Product & CX" },
    ],
  },
];

const englishEnablers = [
  {
    id: "leadership",
    title: "Leadership & Transformation",
    thesis: "Turn strategy into organisation and execution.",
    body: "Set direction, clarify accountability and align the organisation behind the critical priorities. Diagnose the cause and clarify the decision first, then choose the appropriate leadership and change intervention.",
    links: [{ href: "/en/leadership", label: "Explore Leadership" }],
  },
  {
    id: "data-ai-digital-product",
    title: "Data, AI & Digital Product",
    thesis: "Turn better evidence into better commercial decisions.",
    body: "The model alone is not decisive. Customer behaviour, analytics and Predictive AI need to lead to concrete action, while digital products require clear customer problems, ownership and prioritisation.",
    links: [
      { href: "/en/data-ai-digital-product", label: "Data, AI & Decisioning" },
      { href: "/en/digital-product-customer-experience", label: "Digital Product & CX" },
    ],
  },
];

const enablers = isEnglish ? englishEnablers : germanEnablers;
const intro = isEnglish ? {
  label: "Explore Commercial Management / Digital Commerce",
  heading: "Steering and scaling digital businesses for economic impact.",
  body: "Growth, customer base, customer journey, commercial economics and scarce resources belong in one coherent management system. The decisive capability is to interpret signals correctly, set priorities and direct resources so that economic impact can scale.",
} : {
  label: "Commercial Management / Digital Commerce vertiefen",
  heading: "Digitale Geschäfte wirtschaftlich steuern und skalieren.",
  body: "Wachstum entsteht nicht in einem einzelnen Kanal. Es hängt daran, wie Kundenbasis, Customer Journey, Marge und Ressourcen zusammen gesteuert werden. Entscheidend ist, die richtigen Signale zu lesen, Prioritäten zu setzen und Ressourcen dorthin zu bringen, wo sie den größten Beitrag leisten.",
};

const selectedPractice = isEnglish ? {
  sectionLabel: "Practice & Proof",
  caseLabel: "Transformation Case",
  caseTitle: "Marketing Decisioning Capability",
  caseBody: "From fragmented marketing steering to an integrated Decisioning Capability connecting data foundation, analytics, predictive models and activation.",
  outcome: "Double-digit millions less advertising spend with stable revenue.",
  caseAction: "Explore the capability",
  caseHref: "/en/data-ai-digital-product",
  explorationLabel: "Performance Marketing Steering",
  explorationTitle: "Measure impact. Steer budgets. Lead platforms.",
  explorationBody: "Modern performance steering connects business goals, value signals, measurement and AI-enabled decisions – from Google Ads to cross-channel budget allocation.",
  explorationAction: "Explore Performance Marketing Steering",
  explorationHref: "/performance-marketing-steering",
} : {
  sectionLabel: "Practice & Proof",
  caseLabel: "Transformation Case",
  caseTitle: "Marketing Decisioning Capability",
  caseBody: "Von fragmentierter Marketingsteuerung zu einer integrierten Decisioning Capability: gemeinsame Datenbasis, Analytics, Predictive Models und Aktivierung als kommerzielles System verbunden.",
  outcome: "Zweistelliger Mio.-Betrag weniger Werbekosten bei stabilem Umsatz.",
  caseAction: "Case ansehen",
  caseHref: "/data-ai-digital-product#marketing-decisioning-case-title",
  explorationLabel: "Performance Marketing Steering",
  explorationTitle: "Wirkung messen. Budgets steuern. Plattformen führen.",
  explorationBody: "Moderne Performance-Steuerung verbindet Business-Ziele, Value Signals, Measurement und AI-gestützte Entscheidungen – von Google Ads bis zur kanalübergreifenden Budgetallokation.",
  explorationAction: "Performance Marketing Steering ansehen",
  explorationHref: "/performance-marketing-steering",
};

const enablerVisuals = {
  leadership: {
    src: "/images/homepage/02-leadership-transformation.png",
    width: 465,
    height: 416,
  },
  "data-ai-digital-product": {
    src: "/images/homepage/03-data-ai-digital-product.png",
    width: 420,
    height: 413,
  },
};

---

<section class="commercial-pillar" id="commercial-management">
  <div class="showcase-grid">
    <div class="capability-column">
      <a class="commercial-intro" href={`${prefix}/commercial-management`} aria-label={intro.label}>
        <div class="commercial-copy">
          <div class="card-eyebrow">Commercial Management</div>
          <h2>{intro.heading}</h2>
          <p>{intro.body}</p>
          <span class="text-link">{isEnglish ? "Explore Commercial Management" : "Commercial Management vertiefen"} <span aria-hidden="true">→</span></span>
        </div>
        <figure class="commercial-visual" aria-hidden="true">
          <img
            src="/images/homepage/01-commercial-management.png"
            alt=""
            width="568"
            height="438"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </a>

      <div class="enablers" aria-label={isEnglish ? "Core enablers" : "Zentrale Enabler"}>
        {enablers.map((enabler) => {
          const visual = enablerVisuals[enabler.id as keyof typeof enablerVisuals];
          return (
            <article class="enabler-card" id={enabler.id}>
              <div class="enabler-copy">
                <div class="card-eyebrow">{enabler.title}</div>
                <h2>{enabler.thesis}</h2>
                <p>{enabler.body}</p>
                <div class="enabler-links">
                  {enabler.links.map((link) => (
                    <a href={link.href}>{link.label} <span aria-hidden="true">→</span></a>
                  ))}
                </div>
              </div>
              <figure class="enabler-visual" aria-hidden="true">
                <img
                  src={visual.src}
                  alt=""
                  width={visual.width}
                  height={visual.height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
            </article>
          );
        })}
      </div>
    </div>

    <span class="column-divider" aria-hidden="true"></span>

    <aside class="proof-column" aria-labelledby={`practice-proof-${language}`}>
      <div class="proof-heading" id={`practice-proof-${language}`}>
        <span>{selectedPractice.sectionLabel}</span>
        <i aria-hidden="true"></i>
      </div>

      <a class="selected-practice" href={selectedPractice.caseHref}>
        <div class="practice-copy">
          <div class="card-eyebrow">{selectedPractice.caseLabel}</div>
          <h2>{selectedPractice.caseTitle}</h2>
          <p>{selectedPractice.caseBody}</p>
        </div>
        <figure class="practice-visual" aria-hidden="true">
          <img
            src="/images/homepage/04-marketing-decisioning.png"
            alt=""
            width="444"
            height="485"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="outcome-strip">
          <span class="outcome-icon" aria-hidden="true">↗</span>
          <strong>{selectedPractice.outcome}</strong>
        </div>
        <span class="text-link case-link">{selectedPractice.caseAction} <span aria-hidden="true">→</span></span>
      </a>

      <a class="practice-exploration" href={selectedPractice.explorationHref}>
        <div class="exploration-copy">
          <div class="card-eyebrow">{selectedPractice.explorationLabel}</div>
          <h3>{selectedPractice.explorationTitle}</h3>
          <p>{selectedPractice.explorationBody}</p>
          <span class="text-link">{selectedPractice.explorationAction} <span aria-hidden="true">→</span></span>
        </div>
        <figure class="exploration-visual" aria-hidden="true">
          <img
            src="/images/homepage/05-ai-explorations.png"
            alt=""
            width="504"
            height="432"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </a>
    </aside>
  </div>

  <slot name="before-steering" />

  <CommercialManagementLoop language={language} />
</section>

<style>
  .commercial-pillar {
    position: relative;
    padding-top: 2rem;
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) 1px minmax(360px, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .capability-column,
  .proof-column {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 1.25rem;
  }
  .column-divider {
    width: 1px;
    height: 100%;
    background: rgba(30,60,100,.2);
  }
  .commercial-intro,
  .selected-practice,
  .practice-exploration {
    color: inherit;
    text-decoration: none;
  }
  .commercial-intro,
  .enabler-card,
  .selected-practice,
  .practice-exploration {
    min-width: 0;
    border: 1px solid rgba(30,60,100,.17);
    border-radius: 2px;
  }
  .commercial-intro,
  .enabler-card {
    background: rgba(255,255,255,.43);
  }
  .selected-practice,
  .practice-exploration {
    background: linear-gradient(135deg, rgba(255,255,255,.5), rgba(255,248,242,.52));
  }
  .commercial-intro:hover,
  .selected-practice:hover,
  .practice-exploration:hover {
    border-color: rgba(180,83,9,.3);
  }
  .commercial-intro:focus-visible,
  .selected-practice:focus-visible,
  .practice-exploration:focus-visible,
  .enabler-links a:focus-visible {
    outline: 3px solid rgba(180,83,9,.4);
    outline-offset: 4px;
  }
  .card-eyebrow {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-bottom: 1rem;
    color: var(--color-amber);
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: .14em;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .card-eyebrow::before {
    width: 2.25rem;
    height: 2px;
    flex: 0 0 auto;
    background: var(--color-amber);
    content: "";
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    margin-top: auto;
    padding-top: 1.2rem;
    color: var(--color-amber);
    font-size: 12.5px;
    font-weight: 500;
  }
  .commercial-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(260px, .82fr);
    min-height: 438px;
    overflow: hidden;
  }
  .commercial-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 2.1rem 1rem 2rem 2rem;
  }
  .commercial-intro h2 {
    max-width: 510px;
    margin: 0 0 1rem;
    color: var(--color-ink);
    font-size: clamp(34px, 3vw, 43px);
    font-weight: 500;
    letter-spacing: -.04em;
    line-height: 1.08;
  }
  .commercial-intro p {
    max-width: 530px;
    margin: 0;
    color: var(--color-ink-2);
    font-size: 15px;
    line-height: 1.62;
  }
  .commercial-visual,
  .enabler-visual,
  .practice-visual,
  .exploration-visual {
    margin: 0;
  }
  .commercial-visual {
    min-width: 0;
    padding: 1.25rem .8rem 1.25rem 0;
  }
  .commercial-visual img,
  .enabler-visual img,
  .practice-visual img,
  .exploration-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .enablers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .enabler-card {
    position: relative;
    min-height: 418px;
    overflow: hidden;
    padding: 1.65rem 1.6rem 1.5rem;
  }
  .enabler-copy {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
  }
  .enabler-card h2 {
    max-width: 330px;
    margin: 0 0 .85rem;
    color: var(--color-ink);
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1.18;
  }
  .enabler-card p {
    max-width: 330px;
    margin: 0;
    color: var(--color-ink-2);
    font-size: 13.5px;
    line-height: 1.55;
  }
  .enabler-links {
    position: relative;
    z-index: 2;
    display: flex;
    max-width: 58%;
    flex-direction: column;
    align-items: flex-start;
    gap: .55rem;
    margin-top: auto;
    padding-top: 1rem;
  }
  .enabler-links a {
    color: var(--color-amber);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
  }
  .enabler-links a:hover { opacity: .72; }
  .enabler-visual {
    position: absolute;
    right: .55rem;
    bottom: .45rem;
    width: 46%;
    height: 155px;
  }
  .proof-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 1.55rem;
    color: var(--color-ink-3);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .19em;
    text-transform: uppercase;
  }
  .proof-heading span {
    flex: 0 0 auto;
  }
  .proof-heading i {
    width: 100%;
    height: 1px;
    background: rgba(30,60,100,.2);
  }
  .proof-column .card-eyebrow {
    margin-bottom: .75rem;
  }
  .proof-column .text-link {
    padding-top: .75rem;
  }
  .practice-exploration .card-eyebrow,
  .practice-exploration .text-link {
    white-space: nowrap;
  }
  .selected-practice {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(145px, .8fr);
    grid-template-areas:
      "copy visual"
      "outcome outcome"
      "cta cta";
    gap: .75rem 1rem;
    min-height: 0;
    padding: 1.35rem 1.35rem 1.2rem;
    overflow: hidden;
  }
  .practice-copy {
    grid-area: copy;
    min-width: 0;
  }
  .practice-copy h2,
  .exploration-copy h3 {
    margin: 0;
    color: var(--color-ink);
    font-weight: 500;
    letter-spacing: -.025em;
    line-height: 1.17;
  }
  .practice-copy h2 {
    font-size: 22px;
  }
  .practice-copy p,
  .exploration-copy p {
    margin: .75rem 0 0;
    color: var(--color-ink-2);
    font-size: 13px;
    line-height: 1.58;
  }
  .practice-visual {
    grid-area: visual;
    min-width: 0;
    min-height: 190px;
  }
  .outcome-strip {
    grid-area: outcome;
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: .6rem;
    align-items: start;
    align-self: end;
    padding: .1rem 0 0;
  }
  .outcome-icon {
    color: var(--color-amber);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.15;
  }
  .outcome-strip strong {
    display: block;
    color: var(--color-ink);
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.42;
  }
  .case-link {
    grid-area: cta;
    justify-self: start;
    margin-top: 0;
    padding-top: 0;
  }
  .practice-exploration {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(150px, .88fr);
    min-height: 0;
    gap: .75rem;
    padding: 1.35rem 1.35rem 1.2rem;
    overflow: hidden;
  }
  .exploration-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }
  .exploration-copy h3 {
    font-size: 23px;
  }
  .exploration-visual {
    min-width: 0;
    align-self: center;
    height: 200px;
  }
  @media (min-width: 1161px) {
    .proof-column {
      grid-template-rows: auto 440px 370px;
    }
  }
  @media (min-width: 1161px) and (max-width: 1400px) {
    .proof-column {
      grid-template-rows: auto 440px minmax(0, 1fr);
    }
    #data-ai-digital-product .enabler-visual {
      width: 40%;
      height: 130px;
    }
    .practice-exploration {
      position: relative;
      display: block;
      padding: 1.35rem;
    }
    .practice-exploration .exploration-copy {
      height: 100%;
    }
    .practice-exploration .exploration-copy h3,
    .practice-exploration .exploration-copy p {
      max-width: 58%;
    }
    .practice-exploration .exploration-copy p {
      font-size: 13.5px;
      line-height: 1.55;
    }
    .practice-exploration .exploration-visual {
      position: absolute;
      top: 50%;
      right: 1.35rem;
      width: 36%;
      height: 200px;
      transform: translateY(-50%);
    }
  }
  @media (max-width: 1160px) {
    .showcase-grid {
      grid-template-columns: minmax(0, 1.58fr) 1px minmax(330px, 1fr);
      gap: 1rem;
    }
    .commercial-intro {
      grid-template-columns: minmax(0, 1.2fr) minmax(210px, .8fr);
    }
    .commercial-copy {
      padding-left: 1.65rem;
    }
    .selected-practice,
    .practice-exploration {
      grid-template-columns: 1fr;
    }
    .selected-practice {
      grid-template-areas:
        "copy"
        "visual"
        "outcome"
        "cta";
    }
    .practice-visual {
      height: 180px;
      min-height: 0;
    }
    .exploration-visual {
      height: 180px;
    }
  }
  @media (max-width: 1100px) {
    .showcase-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .capability-column,
    .proof-column {
      display: contents;
    }
    .column-divider {
      display: none;
    }
    .commercial-intro { order: 1; }
    .proof-heading { order: 2; margin-top: .75rem; }
    .selected-practice { order: 3; }
    .practice-exploration { order: 4; }
    .enablers { order: 5; }
    .selected-practice {
      grid-template-columns: minmax(0, 1.1fr) minmax(250px, .9fr);
      grid-template-areas:
        "copy visual"
        "outcome outcome"
        "cta cta";
    }
    .practice-exploration {
      grid-template-columns: minmax(0, 1.2fr) minmax(240px, .8fr);
    }
    .practice-visual,
    .exploration-visual {
      height: 220px;
    }
  }
  @media (max-width: 768px) {
    .commercial-pillar { padding-top: 2.5rem; }
    .showcase-grid { padding-bottom: 3rem; }
    .commercial-intro {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .commercial-copy {
      padding: 1.65rem 1.5rem 1.35rem;
    }
    .commercial-intro h2 { font-size: 28px; }
    .commercial-intro p { font-size: 15px; line-height: 1.58; }
    .commercial-visual {
      height: 220px;
      padding: 0 1rem 1rem;
    }
    .selected-practice,
    .practice-exploration {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }
    .selected-practice {
      grid-template-areas:
        "copy"
        "visual"
        "outcome"
        "cta";
    }
    .practice-visual,
    .exploration-visual {
      height: 210px;
    }
    .enablers {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .enabler-card {
      min-height: 390px;
      padding: 1.5rem;
    }
    .enabler-visual {
      width: 45%;
      height: 150px;
    }
  }
  @media (max-width: 430px) {
    .card-eyebrow {
      font-size: 10px;
      letter-spacing: .11em;
    }
    .practice-copy h2,
    .exploration-copy h3 {
      font-size: 22px;
    }
    .enabler-card h2 {
      font-size: 21px;
    }
  }
</style>
