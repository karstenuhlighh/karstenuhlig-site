---
import CommercialManagementLoop from "./CommercialManagementLoop.astro";
import CommercialMotifGrid from "./CommercialMotifGrid.astro";

const enablers = [
  {
    title: "Leadership & Transformation",
    thesis: "Strategie in Organisation und Umsetzung übersetzen.",
  },
  {
    title: "Data, AI & Digital Product",
    thesis: "Digitale Fähigkeiten gezielt für wirtschaftliche Wirkung einsetzen.",
  },
];
---

<section class="commercial-pillar" id="commercial-management">
  <div class="commercial-intro">
    <div class="section-kicker">Commercial Management / Digital Commerce</div>
    <h2>Digitale Geschäfte wirtschaftlich steuern und skalieren.</h2>
    <p>
      Wachstum, Kundenbasis, Customer Journey, Commercial Economics und knappe
      Ressourcen gehören in ein zusammenhängendes Managementsystem. Entscheidend
      ist, Signale richtig zu deuten, Prioritäten zu setzen und Ressourcen so zu
      führen, dass wirtschaftliche Wirkung skalierbar wird.
    </p>
  </div>

  <div class="enablers" aria-label="Zentrale Enabler">
    {
      enablers.map((enabler) => (
        <article class="enabler-card">
          <span class="enabler-marker" aria-hidden="true"></span>
          <h2>{enabler.title}</h2>
          <p>{enabler.thesis}</p>
        </article>
      ))
    }
  </div>

  <CommercialMotifGrid />
  <CommercialManagementLoop />
</section>

<style>
  .commercial-pillar {
    position: relative;
    padding-top: 4rem;
  }
  .commercial-intro {
    position: relative;
    overflow: hidden;
    padding: 3rem 3.25rem 3.2rem;
    background: linear-gradient(135deg, rgba(255,255,255,.78) 0%, rgba(232,240,248,.62) 62%, rgba(255,255,255,.42) 100%);
    border: 1px solid rgba(30,60,100,.18);
    border-left: 3px solid var(--color-amber);
    box-shadow: 0 14px 34px rgba(30,50,70,.06);
  }
  .commercial-intro::after {
    content: "";
    position: absolute;
    top: -4rem;
    right: 8%;
    width: 1px;
    height: 20rem;
    background: linear-gradient(180deg, transparent, rgba(30,60,100,.16), transparent);
    transform: rotate(18deg);
    pointer-events: none;
  }
  .section-kicker {
    position: relative;
    z-index: 1;
    margin-bottom: 1rem;
    color: var(--color-amber);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .commercial-intro h2 {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 0 .9rem;
    color: var(--color-ink);
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -.03em;
    line-height: 1.12;
  }
  .commercial-intro p {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0;
    color: var(--color-ink-2);
    font-size: 17px;
    line-height: 1.7;
  }
  .enablers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  .enabler-card {
    position: relative;
    overflow: hidden;
    min-height: 170px;
    padding: 2rem 2.15rem;
    background: rgba(255,255,255,.54);
    border: 1px solid var(--color-border-soft);
    border-top: 2px solid rgba(30,60,100,.34);
  }
  .enabler-marker {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-bottom: 1.35rem;
    background: var(--color-amber);
  }
  .enabler-card h2 {
    margin: 0 0 .65rem;
    color: var(--color-ink);
    font-size: 23px;
    font-weight: 500;
    letter-spacing: -.02em;
    line-height: 1.2;
  }
  .enabler-card p {
    max-width: 470px;
    margin: 0;
    color: var(--color-ink-2);
    font-size: 16px;
    line-height: 1.55;
  }
  @media (max-width: 768px) {
    .commercial-pillar { padding-top: 3rem; }
    .commercial-intro { padding: 1.9rem 1.5rem 2.1rem; }
    .commercial-intro h2 { font-size: 29px; }
    .enablers { grid-template-columns: 1fr; gap: 1rem; }
    .enabler-card { min-height: 0; padding: 1.6rem 1.5rem; }
  }
</style>
