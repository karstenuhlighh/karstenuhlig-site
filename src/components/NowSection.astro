---
// Inhalt der Now-Section pflegt Karsten monatlich.
// Marketing-affine Tonalität; keine technischen Detailbegriffe
// (LangGraph, Recall, BOOST, LLM-as-Judge) auf der Hauptseite.
interface Props {
  language?: "de" | "en";
}

const { language = "de" } = Astro.props;
const isEnglish = language === "en";
---

<section class="now-section" id="thesen-praxistests">
  <div class="eyebrow">{isEnglish ? "Hypotheses and practical tests" : "Thesen und Praxistests"}</div>
  <p class="now-intro">{isEnglish ? "Hypotheses become robust when they hold up against real decisions, economic guardrails and live systems." : "Thesen werden belastbar, wenn sie sich an realen Entscheidungen, wirtschaftlichen Guardrails und laufenden Systemen bewähren."}</p>
  <div class="now-grid">
    <a href={isEnglish ? "/en/data-ai-digital-product" : "/agentic-ai/sem-agentic"} class="now-card">
      <span class="hair hair-1" aria-hidden="true"></span>
      <span class="hair hair-2" aria-hidden="true"></span>
      <div class="now-card-label">{isEnglish ? "Practical test: Data & AI" : "Praxistest: Data & AI"}</div>
      <p class="now-card-body">{isEnglish ? "How robust are AI-assisted decisions when they meet real campaign logic, data quality and economic guardrails? The feasibility study tests steering impact, not the demo." : "Wie belastbar sind AI-gestützte Entscheidungen, wenn sie auf reale Kampagnenlogik, Datenqualität und wirtschaftliche Guardrails treffen? Die Feasibility Study prüft nicht die Demo, sondern die Steuerungswirkung."}</p>
    </a>
    <a href={isEnglish ? "/en/digital-product-customer-experience" : "/martech/operating-model-schlaegt-stack"} class="now-card">
      <span class="hair hair-1" aria-hidden="true"></span>
      <span class="hair hair-2" aria-hidden="true"></span>
      <div class="now-card-label">{isEnglish ? "Management hypothesis" : "Managementthese"}</div>
      <p class="now-card-body">{isEnglish ? "Why capable technology only creates impact once ownership, decision rights and execution routines are clear. The operating model comes before the model." : "Warum leistungsfähige Technologie erst dann wirkt, wenn Ownership, Entscheidungsrechte und Execution-Routinen geklärt sind. Das Operating Model kommt vor dem Modell."}</p>
    </a>
  </div>
</section>

<style>
  .now-section {
    position: relative;
    padding-top: 4.75rem;
    padding-bottom: 5rem;
    border-top: 1px solid var(--color-border);
  }
  .eyebrow {
    font-size: 12px;
    color: var(--color-ink-3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    font-weight: 500;
  }
  .now-intro {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-ink-2, var(--color-body));
    margin: 0 0 1.75rem;
  }
  .now-grid {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: 1.25rem;
    align-items: stretch;
    max-width: 900px;
  }
  .now-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.66);
    border: 1px solid rgba(30, 60, 100, 0.14);
    border-radius: 2px;
    padding: 2.15rem 1.9rem;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .now-card:first-child {
    background: linear-gradient(
      135deg,
      rgba(164, 192, 217, 0.28) 0%,
      rgba(255, 255, 255, 0.76) 52%,
      rgba(255, 255, 255, 0.58) 100%
    );
  }
  .now-card:hover {
    background: rgba(255, 255, 255, 0.82);
    border-color: rgba(180, 83, 9, 0.38);
    box-shadow: 0 10px 26px rgba(30, 60, 100, 0.07);
    transform: translateY(-2px);
  }
  /* Hairlines bleiben auf der Startseite dem Hero vorbehalten. */
  .now-card .hair {
    display: none;
  }
  .now-card .hair-1 {
    top: -30px;
    right: 46px;
    height: 230px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(30, 60, 100, 0.09) 32%,
      rgba(30, 60, 100, 0.02) 75%,
      transparent 100%
    );
  }
  .now-card .hair-2 {
    top: 8px;
    right: 90px;
    height: 170px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(30, 60, 100, 0.05) 35%,
      rgba(30, 60, 100, 0.015) 75%,
      transparent 100%
    );
  }
  .now-card-label {
    font-size: 11px;
    color: var(--color-ink-3);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .now-card-body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-body);
    margin: 0;
  }

  @media (max-width: 768px) {
    .now-grid {
      grid-template-columns: 1fr;
      max-width: 560px;
    }
  }
</style>
