---
import { leadershipClasses } from "../data/leadership-classes";
import { leadershipClassesEn } from "../data/en/leadership-classes";

interface Props {
  language?: "de" | "en";
}

const { language = "de" } = Astro.props;
const isEnglish = language === "en";
const classes = isEnglish ? leadershipClassesEn : leadershipClasses;
const ui = isEnglish ? {
  kicker: "",
  heading: "What good leadership needs to enable",
  explore: "Explore",
  question: "What it is about",
  close: "Close details",
  about: "In detail",
  focus: "What I pay attention to",
} : {
  kicker: "",
  heading: "Was gute Führung für mich ermöglichen muss",
  explore: "Vertiefen",
  question: "Worum es geht",
  close: "Vertiefung schließen",
  about: "Im Detail",
  focus: "Worauf ich achte",
};

const panelData = classes.map((item) => ({
  number: item.number,
  title: item.title,
  managementQuestion: item.managementQuestion,
  description: item.description,
  about: item.about,
  focus: item.focus,
  tags: item.tags,
  layers: item.layers ?? [],
  personalNote: item.personalNote ?? item.about,
}));

const serializedPanelData = JSON.stringify(panelData).replace(/</g, "\\u003c");
const anchorByNumber: Record<string, string> = {
  "01": "leadership-accountability-autonomy",
  "02": "leadership-development-feedback",
  "03": "leadership-direction-focus",
  "04": "leadership-openness-conflict",
  "05": "leadership-cross-functional-collaboration",
  "06": "leadership-transformation-change-learning",
  "07": "leadership-stance",
};
---

<section class="field-section" id="leadership-classes" aria-labelledby="leadership-classes-title">
  <div class="section-heading section-heading--single">
    {ui.kicker && <div class="section-kicker">{ui.kicker}</div>}
    <h2 id="leadership-classes-title">{ui.heading}</h2>
  </div>

  <ol class="field-grid">
    {
      classes.map((item) => (
        <li id={anchorByNumber[item.number]}>
          <button
            class="field-card field-card--personal"
            type="button"
            data-leadership-field={item.number}
            aria-haspopup="dialog"
            aria-controls="leadership-field-dialog"
            aria-expanded="false"
            aria-label={`${ui.explore} ${item.number} ${item.title}`}
          >
            <span class="field-media">
              <img src={item.image} alt={item.alt} width="1254" height="1254" loading="lazy" />
            </span>
            <span class="field-content">
              <span class="field-title"><b>{item.number}</b><strong>{item.shortTitle}</strong></span>
              <span class="field-description">{item.description}</span>
              <span class="field-action">{ui.explore} <span aria-hidden="true">→</span></span>
            </span>
            <span class="field-preview" aria-hidden="true">
              <span class="preview-label">{ui.question}</span>
              <span class="preview-question">{item.managementQuestion}</span>
              <span class="preview-tags">
                {item.tags.map((tag) => <span>{tag}</span>)}
              </span>
            </span>
          </button>
        </li>
      ))
    }
  </ol>
</section>

<dialog class="field-dialog field-dialog--personal" id="leadership-field-dialog" aria-labelledby="field-dialog-title">
  <div class="drawer">
    <div class="drawer-topline">
      <span class="drawer-number" id="field-dialog-number"></span>
      <button class="drawer-close" type="button" aria-label={ui.close}>×</button>
    </div>
    <h2 id="field-dialog-title"></h2>

    <section class="drawer-main" aria-label={ui.question}>
      <p id="field-dialog-description"></p>
      <p id="field-dialog-question"></p>
    </section>

    <section class="drawer-section layer-section" aria-label={ui.about}>
      <div class="drawer-layers" id="field-dialog-layers"></div>
    </section>

    <section class="drawer-section personal-section" aria-labelledby="field-dialog-focus-label">
      <h3 id="field-dialog-focus-label">{ui.focus}</h3>
      <p id="field-dialog-personal-note"></p>
    </section>

  </div>
</dialog>

<script type="application/json" id="leadership-field-data" set:html={serializedPanelData}></script>

<script>
  const fieldDialog = document.querySelector<HTMLDialogElement>("#leadership-field-dialog");
  const fieldDataNode = document.querySelector<HTMLScriptElement>("#leadership-field-data");
  const fieldTriggers = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-leadership-field]"));
  const closeButton = fieldDialog?.querySelector<HTMLButtonElement>(".drawer-close");
  let activeFieldTrigger: HTMLButtonElement | null = null;

  const fields = fieldDataNode ? JSON.parse(fieldDataNode.textContent || "[]") : [];
  const byNumber = new Map(fields.map((field: { number: string }) => [field.number, field]));

  function setText(selector: string, value: string) {
    const node = fieldDialog?.querySelector<HTMLElement>(selector);
    if (node) node.textContent = value;
  }

  function openFieldDialog(trigger: HTMLButtonElement) {
    if (!fieldDialog) return;
    const field = byNumber.get(trigger.dataset.leadershipField || "");
    if (!field) return;

    activeFieldTrigger = trigger;
    fieldTriggers.forEach((item) => item.setAttribute("aria-expanded", item === trigger ? "true" : "false"));

    setText("#field-dialog-number", `${field.number} · Leadership & Transformation`);
    setText("#field-dialog-title", field.title);
    setText("#field-dialog-description", field.description);
    setText("#field-dialog-question", field.managementQuestion);
    setText("#field-dialog-about", field.about);
    setText("#field-dialog-personal-note", field.personalNote);

    const tags = fieldDialog.querySelector<HTMLElement>("#field-dialog-tags");
    tags?.replaceChildren(...field.tags.map((tag: string) => {
      const item = document.createElement("span");
      item.textContent = tag;
      return item;
    }));

    const focus = fieldDialog.querySelector<HTMLUListElement>("#field-dialog-focus");
    focus?.replaceChildren(...field.focus.map((text: string) => {
      const item = document.createElement("li");
      item.textContent = text;
      return item;
    }));

    const layers = fieldDialog.querySelector<HTMLElement>("#field-dialog-layers");
    layers?.replaceChildren(...field.layers.map((layer: { title: string; text: string }) => {
      const item = document.createElement("div");
      item.className = "drawer-layer";
      const heading = document.createElement("h3");
      heading.textContent = layer.title;
      const copy = document.createElement("p");
      copy.textContent = layer.text;
      item.append(heading, copy);
      return item;
    }));

    fieldDialog.showModal();
    document.body.classList.add("leadership-dialog-open");
    closeButton?.focus();
  }

  fieldTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => openFieldDialog(trigger));
  });

  closeButton?.addEventListener("click", () => fieldDialog?.close());

  fieldDialog?.addEventListener("click", (event) => {
    if (event.target === fieldDialog) fieldDialog.close();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && fieldDialog?.open) {
      event.preventDefault();
      fieldDialog.close();
    }
  });

  fieldDialog?.addEventListener("close", () => {
    document.body.classList.remove("leadership-dialog-open");
    fieldTriggers.forEach((item) => item.setAttribute("aria-expanded", "false"));
    activeFieldTrigger?.focus();
    activeFieldTrigger = null;
  });
</script>

<style>
  .field-section { padding: 5.5rem 0; border-top: 1px solid var(--color-border); }
  .section-heading { display: grid; grid-template-columns: .34fr 1fr; gap: 4rem; align-items: start; margin-bottom: 2.75rem; }
  .section-heading--single { grid-template-columns: 1fr; gap: 0; }
  .section-kicker { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .section-heading h2 { max-width: 820px; margin: 0; color: var(--color-ink); font-size: 28px; font-weight: 500; letter-spacing: -.025em; line-height: 1.25; }
  .field-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; list-style: none; margin: 0; padding: 0; }
  .field-card { position: relative; display: grid; width: 100%; height: 100%; min-height: 370px; grid-template-rows: 205px 1fr; overflow: hidden; padding: 0; color: inherit; text-align: left; font: inherit; cursor: pointer; background: rgba(255,255,255,.58); border: 1px solid var(--color-border-soft); transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .field-card--personal { min-height: 480px; }
  .field-card:hover { background: rgba(255,255,255,.76); border-color: rgba(180,83,9,.32); transform: translateY(-2px); box-shadow: 0 16px 34px rgba(30,50,70,.07); }
  .field-card:focus-visible { outline: 3px solid rgba(180,83,9,.4); outline-offset: 3px; }
  .field-media { position: relative; display: flex; min-width: 0; align-items: center; justify-content: center; padding: .8rem .85rem .3rem; overflow: hidden; border-bottom: 1px solid var(--color-border-soft); }
  .field-media img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .field-content { display: flex; min-width: 0; flex-direction: column; padding: 1.1rem 1.05rem 1.2rem; }
  .field-title { display: grid; grid-template-columns: 1.75rem 1fr; gap: .45rem; align-items: baseline; color: var(--color-ink); }
  .field-title b { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .1em; }
  .field-title strong { font-size: 16px; font-weight: 500; letter-spacing: -.015em; line-height: 1.3; }
  .field-description { display: block; margin: .65rem 0 1rem; color: var(--color-body); font-size: 13px; line-height: 1.5; }
  .field-card--personal .field-description { margin-bottom: .55rem; color: var(--color-ink); font-weight: 500; }
  .field-card--personal .field-action { margin-top: 1rem; }
  .field-action { display: inline-flex; gap: .4rem; align-items: center; margin: auto 0 0; color: var(--color-amber); font-size: 11.5px; font-weight: 500; letter-spacing: .04em; }
  .field-preview { position: absolute; inset: .75rem; z-index: 2; display: flex; visibility: hidden; flex-direction: column; justify-content: center; overflow-y: auto; padding: 1.35rem 1.25rem; opacity: 0; background: #f9fcfe; border: 1px solid rgba(30,60,100,.18); box-shadow: 0 14px 30px rgba(30,50,70,.1); transform: translateY(8px); transition: opacity .2s ease, transform .2s ease, visibility 0s linear .2s; pointer-events: none; }
  .preview-label { margin-bottom: .55rem; color: var(--color-amber); font-size: 10px; font-weight: 500; letter-spacing: .13em; text-transform: uppercase; }
  .preview-question { color: var(--color-ink); font-size: 13px; font-weight: 500; line-height: 1.4; }
  .preview-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .9rem; }
  .preview-tags span { padding: .35rem .55rem; color: var(--color-ink-2); font-size: 10.5px; font-weight: 500; line-height: 1; background: rgba(225,234,243,.72); border: 1px solid var(--color-border-soft); }
  @media (hover: hover) and (pointer: fine) {
    .field-card:hover .field-preview, .field-card:focus-visible .field-preview { visibility: visible; opacity: 1; transform: translateY(0); transition-delay: 0s; }
  }

  .field-dialog { position: fixed; inset: 0 0 0 auto; width: min(570px, 100vw); max-width: none; height: 100dvh; max-height: none; margin: 0; padding: 0; overflow: visible; color: var(--color-ink); background: transparent; border: 0; }
  .field-dialog--personal { width: min(640px, 100vw); }
  .field-dialog::backdrop { background: rgba(15,23,41,.38); backdrop-filter: blur(3px); }
  .drawer { height: 100%; padding: 2.35rem 2.5rem 2.75rem; overflow-y: auto; background: linear-gradient(180deg, #f9fbfd 0%, #eef3f8 100%); border-left: 1px solid rgba(30,60,100,.2); box-shadow: -18px 0 50px rgba(15,23,41,.14); }
  .drawer-topline { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
  .drawer-number { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .drawer-close { display: inline-grid; width: 42px; height: 42px; place-items: center; padding: 0; color: var(--color-ink-2); font: inherit; font-size: 25px; line-height: 1; cursor: pointer; background: rgba(255,255,255,.7); border: 1px solid var(--color-border-soft); transition: color .2s ease, border-color .2s ease; }
  .drawer-close:hover { color: var(--color-amber); border-color: rgba(180,83,9,.35); }
  .drawer-close:focus-visible { outline: 3px solid rgba(180,83,9,.4); outline-offset: 3px; }
  .drawer > h2 { margin: 0 0 2rem; color: var(--color-ink); font-size: 34px; font-weight: 500; letter-spacing: -.03em; line-height: 1.12; }
  .drawer-main { padding: 0 0 1.45rem; }
  .drawer-main p { margin: 0; color: var(--color-ink); font-size: 17px; font-weight: 500; line-height: 1.5; }
  .drawer-main p + p { margin-top: .65rem; color: var(--color-body); font-size: 14px; font-weight: 400; line-height: 1.7; }
  .drawer-section { padding: 1.45rem 0; border-top: 1px solid var(--color-border-soft); }
  .drawer-section h3 { margin: 0 0 .7rem; color: var(--color-ink-3); font-size: 10.5px; font-weight: 500; letter-spacing: .13em; text-transform: uppercase; }
  .drawer-section p { margin: 0; color: var(--color-body); font-size: 14px; line-height: 1.7; }
  .question-section > p { color: var(--color-ink); font-size: 18px; font-weight: 500; line-height: 1.45; }
  .drawer-section ul { display: grid; gap: .65rem; list-style: none; margin: 0; padding: 0; }
  .drawer-section :global(li) { position: relative; padding-left: 1.15rem; color: var(--color-body); font-size: 13.5px; line-height: 1.6; }
  .drawer-section :global(li)::before { content: ""; position: absolute; top: .62rem; left: 0; width: 5px; height: 5px; background: var(--color-amber); }
  .drawer-layers { display: grid; gap: 1.15rem; }
  :global(.drawer-layer) { padding-left: 1rem; border-left: 2px solid rgba(180,83,9,.55); }
  :global(.drawer-layer h3) { margin: 0 0 .35rem; color: var(--color-ink); font-size: 14px; font-weight: 500; letter-spacing: 0; text-transform: none; }
  :global(.drawer-layer p) { margin: 0; color: var(--color-body); font-size: 13.5px; line-height: 1.65; }
  .personal-section > p { margin: 0; color: var(--color-body); font-size: 14px; line-height: 1.7; }
  :global(body.leadership-dialog-open) { overflow: hidden; }

  @media (max-width: 1120px) {
    .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
    .field-card { min-height: 410px; grid-template-rows: 245px 1fr; }
    .field-card--personal { min-height: 460px; }
    .field-content { padding: 1.25rem 1.35rem 1.35rem; }
    .field-title { grid-template-columns: 2.1rem 1fr; gap: .55rem; }
    .field-title strong { font-size: 18px; }
    .field-description { font-size: 14px; }
  }

  @media (max-width: 760px) {
    .field-section { padding: 4rem 0; }
    .section-heading { grid-template-columns: 1fr; gap: 1rem; margin-bottom: 2rem; }
    .section-heading h2 { font-size: 24px; }
    .field-grid { grid-template-columns: 1fr; }
    .field-card { min-height: 0; grid-template-rows: 230px auto; }
    .field-card--personal { min-height: 0; }
    .field-preview { display: none; }
    .field-dialog { inset: auto 0 0; width: 100%; height: min(88dvh, 760px); }
    .drawer { padding: 1.35rem 1.4rem 2rem; border-top: 1px solid rgba(30,60,100,.2); border-left: 0; box-shadow: 0 -18px 50px rgba(15,23,41,.16); }
    .drawer > h2 { margin-bottom: 1.4rem; font-size: 28px; }
  }

  @media (max-width: 420px) {
    .field-card { grid-template-rows: 205px auto; }
    .field-content { padding: 1.15rem 1.15rem 1.3rem; }
    .field-description, .field-action { margin-left: 0; }
    .field-description { margin-top: .7rem; }
  }
</style>
