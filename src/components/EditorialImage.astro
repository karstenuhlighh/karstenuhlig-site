---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
}

const { src, alt, width, height, class: className } = Astro.props;
---

<figure class:list={["image-frame-shell", "editorial-image", className]}>
  <div class="editorial-image__media">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      decoding="async"
    />
  </div>
</figure>

<style>
  .editorial-image {
    margin: var(--editorial-image-margin, 0);
    padding: clamp(.45rem, .8vw, .7rem);
    background: rgba(255, 255, 255, .3);
  }

  .editorial-image__media {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(30, 60, 100, .1);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
