---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
}

const { src, alt, width, height, class: className } = Astro.props;
---

<figure class:list={["editorial-image", className]}>
  <div class="editorial-image__media">
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      decoding="async"
    />
  </div>
</figure>

<style>
  .editorial-image {
    position: relative;
    margin: var(--editorial-image-margin, 0);
    padding: clamp(.45rem, .8vw, .7rem);
    background: rgba(255, 255, 255, .3);
    border: 1px solid var(--color-border-soft);
  }

  .editorial-image::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: -1px;
    left: -1px;
    width: clamp(52px, 7vw, 84px);
    height: 2px;
    background: var(--color-amber);
  }

  .editorial-image__media {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(30, 60, 100, .1);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
