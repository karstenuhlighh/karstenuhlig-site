---
import Nav from "./Nav.astro";
import type { Language } from "../i18n/routes";

interface Props {
  language?: Language;
}

const { language = "de" } = Astro.props;
const isEnglish = language === "en";

const copy = isEnglish ? {
  headline: ["Scaling digital commerce.", "Turning strategy into results."],
  subtitle: "I steer digital businesses with a clear focus on growth and customer value. I connect marketing, digital sales and CRM across the customer journey into one coherent commercial system. I use data, AI and digital products where they improve decisions, change customer experiences and create economic impact.",
  profileLabel: "Executive profile",
  proofs: [
    ["€1.6bn", "Online business scaled"],
    ["20+ years", "Digital Commerce"],
    ["20+ markets", "Digital Commerce across Europe"],
  ],
  about: "DIGITAL COMMERCE & GROWTH EXECUTIVE",
  profileEyebrow: "EXECUTIVE PROFILE",
  portraitAlt: "Portrait of Karsten Uhlig",
  bio: "As an E-Commerce Executive at bonprix, I scaled the international online business across more than 20 markets to €1.6bn in revenue. Most recently, I was responsible for a broad digital organisation and the interplay of E-Commerce, Digital Marketing, CRM, Data and Digital Product.",
} : {
  headline: ["Digital Commerce skalieren.", "Strategie wirksam machen."],
  subtitle: "Wachstum im Digital Commerce entsteht, wenn Marketing, Digital Sales, CRM und Product als ein System arbeiten, mit klaren Zielen, guter Zusammenarbeit und echter Verantwortung. Genau dieses Zusammenspiel gestalte ich. Data, AI und Digital Products setze ich dort ein, wo sie Entscheidungen verbessern und sich im Ergebnis zeigen.",
  profileLabel: "Kurzprofil",
  proofs: [
    ["€1,6 Mrd.", "Online Business skaliert"],
    ["20+ Jahre", "Digital Commerce"],
    ["20+ Märkte", "Digital Commerce Europa"],
  ],
  about: "DIGITAL COMMERCE & GROWTH EXECUTIVE",
  profileEyebrow: "EXECUTIVE PROFILE",
  portraitAlt: "Portrait Karsten Uhlig",
  bio: "Als E-Commerce Executive habe ich bei bonprix das internationale Online-Geschäft in mehr als 20 Märkten auf €1,6 Mrd. Umsatz skaliert. Zuletzt verantwortete ich eine Digitalorganisation mit über 100 Mitarbeitenden und das Zusammenspiel von E-Commerce, Digital Marketing, CRM, Data und Digital Product. Dabei verbinde ich kommerzielle Klarheit mit einer Arbeitsweise, in der Entscheidungen nah an der fachlichen Expertise fallen, Verantwortung klar verankert ist und Teams eigenständig handeln.",
};
---

<section class="hero">
  <div class="diag-line-1"></div>
  <div class="diag-line-2"></div>
  <div class="hero-inner">
    <Nav language={language} homepage />
    <div class="hero-grid">
      <div class="hero-intro-eyebrow">
        <span aria-hidden="true"></span>
        {copy.about}
      </div>
      <h1 class="headline headline--split">
        {copy.headline.map((line, index) => (
          <>
            <span class="headline-line">{line}</span>
            {index < copy.headline.length - 1 && " "}
          </>
        ))}
      </h1>
      <p class="subtitle">{copy.subtitle}</p>
      <div class="cover-proof" aria-label={copy.profileLabel}>
        {copy.proofs.map(([value, label]) => (
          <div class="cover-proof-item">
            <span class="cover-proof-value">{value}</span>
            <span class="cover-proof-label">{label}</span>
          </div>
        ))}
      </div>
      <div class="ueber-mich-marker" id="about">
        <div class="ueber-mich-eyebrow">{copy.profileEyebrow}</div>
      </div>
      <div class="portrait image-frame-shell">
        <div class="portrait-line-1" aria-hidden="true"></div>
        <div class="portrait-line-2" aria-hidden="true"></div>
        <img
          src="/portrait-freigestellt.png"
          alt={copy.portraitAlt}
          width="1000"
          height="1250"
        />
      </div>
      <div class="bio">
        <p>{copy.bio}</p>
      </div>
    </div>
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    overflow: hidden;
    background:
      radial-gradient(circle at 84% 14%, rgba(255,255,255,.82) 0, rgba(255,255,255,0) 28rem),
      radial-gradient(circle at 12% 34%, rgba(181,202,221,.42) 0, rgba(181,202,221,0) 32rem),
      linear-gradient(180deg, #EEF2F7 0, #D6E1ED 45rem, #EEF2F7 90rem, #EEF2F7 100%);
  }
  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 520px;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.36) 0%,
      rgba(220, 235, 250, 0.12) 60%,
      transparent 100%
    );
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: 1.25rem 4.25rem 4rem;
  }
  .diag-line-1 {
    position: absolute;
    top: 60px;
    right: 4%;
    width: 1px;
    height: 620px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(30, 60, 100, 0.12) 25%,
      rgba(30, 60, 100, 0.04) 65%,
      transparent 100%
    );
    transform: rotate(18deg);
    transform-origin: top right;
    pointer-events: none;
  }
  .diag-line-2 {
    position: absolute;
    top: 140px;
    right: 10%;
    width: 1px;
    height: 420px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(30, 60, 100, 0.18) 40%,
      transparent 100%
    );
    transform: rotate(18deg);
    transform-origin: top right;
    pointer-events: none;
  }

  /* --- DESKTOP --- Grid mit Named Areas --- */
  /* Portrait linke Spalte, Text-Block rechte Spalte.
     teaser ist nicht mehr im Grid (haengt darunter, full-width), damit
     das Portrait am unteren Hero-Sektionsrand angeschnitten sitzen kann. */
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(390px, .86fr) minmax(0, 1.34fr);
    grid-template-areas:
      "portrait intro-eyebrow"
      "portrait headline"
      "portrait subtitle"
      "portrait proof"
      "portrait ueber-mich"
      "portrait bio";
    column-gap: 4.25rem;
    row-gap: 0;
    align-items: start;
    margin-bottom: 0;
    padding-bottom: 1.5rem;
  }
  .ueber-mich-marker {
    grid-area: ueber-mich;
    padding-top: 1.55rem;
    margin-top: 0;
    margin-bottom: 0.65rem;
  }
  .ueber-mich-eyebrow {
    font-size: 12px;
    color: var(--color-ink-3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .headline {
    grid-area: headline;
    font-size: clamp(46px, 4.15vw, 60px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.047em;
    margin-bottom: 1.35rem;
    color: var(--color-ink);
    max-width: 800px;
  }
  .hero-intro-eyebrow {
    grid-area: intro-eyebrow;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    color: var(--color-amber);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .hero-intro-eyebrow span {
    width: 2.25rem;
    height: 2px;
    flex: 0 0 auto;
    background: var(--color-amber);
  }
  .headline-line {
    display: inline;
  }
  @media (min-width: 1024px) {
    .headline--split {
      width: 100%;
      max-width: 800px;
      font-size: clamp(46px, 4.15vw, 60px);
      line-height: 1;
    }
    .headline--split .headline-line {
      display: block;
      white-space: nowrap;
    }
  }
  .subtitle {
    grid-area: subtitle;
    font-size: 16.5px;
    color: var(--color-ink-2);
    margin-bottom: 0;
    max-width: 680px;
  }
  .cover-proof {
    grid-area: proof;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    max-width: 720px;
    margin: 1.8rem 0 1.35rem;
    padding: 0;
  }
  .cover-proof-item {
    min-width: 0;
    padding: 0 1.5rem;
  }
  .cover-proof-item:first-child {
    padding-left: 0;
  }
  .cover-proof-item + .cover-proof-item {
    border-left: 1px solid rgba(30, 60, 100, 0.18);
  }
  .cover-proof-value,
  .cover-proof-label {
    display: block;
  }
  .cover-proof-value {
    font-size: 28px;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .cover-proof-label {
    margin-top: 0.35rem;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }
  .bio {
    grid-area: bio;
    max-width: 680px;
  }
  .bio p {
    font-size: 14px;
    line-height: 1.62;
    color: var(--color-body);
    margin: 0;
  }
  .bio p + p {
    margin-top: 1rem;
  }
  /* Primaeres Hero-Portrait: bestehende Groesse, Position und Bildlogik bleiben
     unveraendert; die gemeinsame Frame-Basis harmonisiert nur die Aussenkante. */
  .portrait {
    grid-area: portrait;
    align-self: start;
    width: min(100%, 500px);
    justify-self: start;
    aspect-ratio: 494 / 607;
    position: relative;
    background: #D6E1ED;
    border-radius: 4px;
    overflow: hidden;
  }
  /* Zwei 18deg-Haarlinien innen (oben rechts), als "Himmel" ueber dem Kopf
     sichtbar -- echoen die Hero-Banner-Linien. */
  .portrait-line-1,
  .portrait-line-2 {
    display: none;
  }
  .portrait-line-1 {
    top: -40px;
    right: 64px;
    height: 330px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(30, 60, 100, 0.14) 32%,
      rgba(30, 60, 100, 0.04) 75%,
      transparent 100%
    );
  }
  .portrait-line-2 {
    top: 6px;
    right: 122px;
    height: 240px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(30, 60, 100, 0.08) 35%,
      rgba(30, 60, 100, 0.02) 75%,
      transparent 100%
    );
  }
  .portrait img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  @media (min-width: 769px) and (max-width: 1023px) {
    .hero-inner {
      padding-inline: 2.5rem;
    }
    .hero-grid {
      grid-template-columns: 0.85fr 1.15fr;
      column-gap: 2.5rem;
    }
    .headline {
      font-size: 39px;
    }
    .subtitle {
      font-size: 16px;
    }
  }
  @media (min-width: 1024px) and (max-width: 1280px) {
    .headline--split {
      font-size: clamp(42px, 3.7vw, 47px);
    }
    .headline--split .headline-line {
      white-space: nowrap;
    }
  }
  /* --- MOBILE --- Positionierung zuerst, kompakter persoenlicher Block danach --- */
  @media (max-width: 768px) {
    .hero {
      background:
        radial-gradient(circle at 88% 6rem, rgba(255,255,255,.72) 0, rgba(255,255,255,0) 20rem),
        linear-gradient(180deg, #D6E1ED 0, #EEF2F7 74rem, #EEF2F7 100%);
    }
    .hero-inner {
      padding: 2rem 1.5rem 0;
    }
    .hero-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-bottom: 0;
    }
    .portrait {
      order: 4;
      max-width: 280px;
      width: 72%;
      height: auto;
      margin: 1.35rem auto 1.5rem;
      aspect-ratio: 4 / 5;
    }
    .portrait img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      transform: none;
      object-fit: cover;
      object-position: center top;
    }
    .headline {
      order: 1;
      font-size: 32px;
      line-height: 1.06;
      letter-spacing: -0.035em;
      margin-bottom: 1rem;
    }
    .hero-intro-eyebrow {
      order: 0;
      margin-bottom: 0.85rem;
      font-size: 10px;
    }
    .headline--split .headline-line {
      white-space: normal;
    }
    .subtitle {
      order: 2;
      margin-bottom: 0;
    }
    .cover-proof {
      order: 3;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.55rem;
      margin: 1rem 0 0;
      padding: 0.85rem 0 0.9rem;
    }
    .cover-proof-item {
      padding-inline: .65rem;
    }
    .cover-proof-value {
      font-size: 16px;
    }
    .ueber-mich-marker {
      order: 5;
      margin-top: 0;
      padding-top: 1.25rem;
      margin-bottom: 0.75rem;
      border-top: 1px solid var(--color-border);
    }
    .bio {
      order: 6;
      margin-top: 0;
    }
  }
  @media (max-width: 420px) {
    .cover-proof-label {
      font-size: 9px;
      letter-spacing: 0.04em;
    }
  }
</style>
