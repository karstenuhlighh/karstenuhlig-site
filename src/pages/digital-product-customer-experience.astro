---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import DigitalProductCapabilityGrid from "../components/DigitalProductCapabilityGrid.astro";
import { getLanguage } from "../i18n/routes";

const language = getLanguage(Astro.url.pathname);
const isEnglish = language === "en";
const productFlow = ["Commercial Intent", "Customer Problem", "Product Decision", "Digital Experience", "Evidence", "Evolution"];

const principles = isEnglish ? [
  "Problem before feature.",
  "Optimise Customer Value and Commercial Value together.",
  "Ownership requires decision rights.",
  "Multiply where possible. Differentiate where necessary.",
  "A product must earn its continuing complexity.",
] : [
  "Problem before feature.",
  "Customer Value und Commercial Value gemeinsam optimieren.",
  "Ownership requires decision rights.",
  "Multiplikation, wo möglich. Differenzierung, wo nötig.",
  "Ein Produkt muss seine fortdauernde Komplexität verdienen.",
];

const enterpriseProofs = isEnglish ? [
  {
    title: "Search & Browse",
    body: "Treated commercial rules for ranking and assortment as hypotheses and tested them against the overall impact on Customer Journey and business.",
  },
  {
    title: "Project → Product",
    body: "Turned temporary project management into enduring Product Ownership with backlog authority, more stable teams and clearer decision rights.",
  },
  {
    title: "International Checkout & Payment",
    body: "Connected a shared Product Core with economically and regulatorily relevant local payment and service requirements.",
  },
  {
    title: "Recommendations & App",
    body: "Brought digital products live incrementally, learned from usage and impact, and derived the next stage from real evidence.",
  },
  {
    title: "Portfolio focus",
    body: "Balanced Product capacity across visible features, Customer Value, compliance, platform modernisation and legacy risks.",
  },
  {
    title: "Deliberate stop decisions",
    body: "Reduced or retired products and variants when usage and impact no longer justified their ongoing cost and additional complexity.",
  },
] : [
  {
    title: "Search & Browse",
    body: "Commercial Rules für Ranking und Sortiment als Hypothese behandelt und gegen die Gesamtwirkung auf Customer Journey und Geschäft geprüft.",
  },
  {
    title: "Projekt → Produkt",
    body: "Temporäre Projektsteuerung in dauerhafte Product Ownership mit Backlog-Hoheit, stabileren Teams und klareren Decision Rights überführt.",
  },
  {
    title: "International Checkout & Payment",
    body: "Einen gemeinsamen Product Core mit wirtschaftlich und regulatorisch relevanten lokalen Payment- und Service-Anforderungen verbunden.",
  },
  {
    title: "Recommendations & App",
    body: "Digitale Produkte schrittweise live gebracht, Nutzung und Wirkung gelernt und die nächste Ausbaustufe aus realer Evidenz abgeleitet.",
  },
  {
    title: "Portfolio-Fokus",
    body: "Product-Kapazität zwischen sichtbaren Features, Customer Value, Compliance, Plattformmodernisierung und Legacy-Risiken ausbalanciert.",
  },
  {
    title: "Bewusste Stop-Entscheidungen",
    body: "Produkte und Varianten reduziert oder beendet, wenn Nutzung und Wirkung ihre laufenden Kosten und zusätzliche Komplexität nicht rechtfertigten.",
  },
];

---

<SubPageLayout
  language={language}
  title="Digital Product & Customer Experience | Karsten Uhlig"
  description={isEnglish ? "Digital Product and Customer Experience as an enabler for Commercial Digital Commerce: translating commercial direction into effective products, journeys and Product systems." : "Digital Product und Customer Experience als Enabler für Commercial Digital Commerce: kommerzielle Richtung in wirksame Produkte, Journeys und Product-Systeme übersetzen."}
>
  <article class="product-landing">
    <header class="landing-hero">
      <div class="hero-eyebrow">Enabler for Commercial Digital Commerce</div>
      <h1>Digital Product &amp;<br />Customer Experience</h1>
      <p class="hero-subheadline">{isEnglish ? "Turning commercial direction into effective digital products and journeys." : "Kommerzielle Richtung in wirksame digitale Produkte und Journeys übersetzen."}</p>
      <p class="hero-copy">{isEnglish ? "For me, Digital Product is not a specialist or technology field detached from the business. Commercial Management remains the starting point: which customer or business problem needs to be solved better? Product translates this direction into Customer Journeys, Product decisions, enduring ownership and learning systems — and remains accountable for impact across the full lifecycle." : "Digital Product ist für mich kein vom Geschäft gelöstes Spezialisten- oder Tech-Feld. Ausgangspunkt bleibt Commercial Management: Welches Kunden- oder Geschäftsproblem muss besser gelöst werden? Product übersetzt diese Richtung in Customer Journeys, Product-Entscheidungen, dauerhafte Ownership und lernfähige Systeme — und verantwortet die Wirkung über den gesamten Lebenszyklus."}</p>
    </header>

    <section class="logic-section" aria-labelledby="product-logic-title">
      <div class="section-heading logic-heading">
        <div class="section-kicker">{isEnglish ? "The central logic" : "Die zentrale Logik"}</div>
        <div>
          <h2 id="product-logic-title">{isEnglish ? "From Commercial Intent to a learning Customer Experience." : "Vom Commercial Intent zur lernenden Customer Experience."}</h2>
          <p>{isEnglish ? "Product connects economic direction with a real customer problem, a deliberate solution decision and evidence from use. This keeps the experience effective and the product capable of evolving." : "Product verbindet die wirtschaftliche Richtung mit einem realen Kundenproblem, einer bewussten Lösungsentscheidung und Evidenz aus der Nutzung. So bleibt die Experience wirksam und das Produkt entwicklungsfähig."}</p>
        </div>
      </div>
      <ol class="product-flow" aria-label={productFlow.join(isEnglish ? " to " : " zu ")}>
        {productFlow.map((step) => (
          <li>
            <span class="flow-node" aria-hidden="true"></span>
            <strong>{step}</strong>
          </li>
        ))}
      </ol>
    </section>

    <DigitalProductCapabilityGrid language={language} />

    <section class="principles-section" aria-labelledby="principles-title">
      <div class="section-heading">
        <div class="section-kicker">Principles</div>
        <h2 id="principles-title">{isEnglish ? "Product follows the impact question, not a methodological ritual." : "Product folgt der Wirkungsfrage, nicht dem Methodenritual."}</h2>
      </div>
      <ol class="principles-grid">
        {principles.map((principle, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{principle}</strong></li>
        ))}
      </ol>
    </section>

    <section class="proof-section" aria-labelledby="proof-title">
      <div class="section-heading">
        <div class="section-kicker">Built &amp; scaled at enterprise level</div>
        <div>
          <h2 id="proof-title">{isEnglish ? "Substance from international Digital Commerce accountability." : "Substanz aus internationaler Digital-Commerce-Verantwortung."}</h2>
          <p>{isEnglish ? "The capability is grounded in real Product, Journey, Operating Model and Portfolio decisions — not in methodological positioning applied retrospectively." : "Die Capability basiert auf realen Product-, Journey-, Operating-Model- und Portfolio-Entscheidungen — nicht auf einer nachträglichen Methodenpositionierung."}</p>
        </div>
      </div>
      <div class="proof-grid">
        {enterpriseProofs.map((proof) => (
          <article class="proof-card">
            <h3>{proof.title}</h3>
            <p>{proof.body}</p>
          </article>
        ))}
      </div>
    </section>

  </article>
</SubPageLayout>

<style>
  .product-landing { min-width: 0; }
  .landing-hero { position: relative; padding: 2.25rem 0 5.25rem; }
  .landing-hero::after { content: ""; position: absolute; right: 2%; bottom: 0; left: 34%; height: 1px; background: linear-gradient(90deg, rgba(180,83,9,.65), rgba(30,60,100,.14), transparent); }
  .hero-eyebrow, .section-kicker { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .hero-eyebrow { margin-bottom: 1rem; }
  h1 { max-width: 980px; margin: 0; color: var(--color-ink); font-size: clamp(44px, 6.2vw, 76px); font-weight: 500; letter-spacing: -.055em; line-height: .98; }
  .hero-subheadline { max-width: 880px; margin: 1.55rem 0 0; color: var(--color-ink); font-size: clamp(22px, 2.7vw, 34px); font-weight: 400; letter-spacing: -.025em; line-height: 1.25; }
  .hero-copy { max-width: 840px; margin: 1.55rem 0 0; color: var(--color-body); font-size: 16px; line-height: 1.8; }

  .logic-section, .principles-section, .proof-section { padding: 5.5rem 0; border-top: 1px solid var(--color-border); }
  .section-heading { display: grid; grid-template-columns: .34fr 1fr; gap: 4rem; align-items: start; }
  .section-heading { margin-bottom: 2.75rem; }
  .section-heading h2 { max-width: 820px; margin: 0; color: var(--color-ink); font-size: 30px; font-weight: 500; letter-spacing: -.03em; line-height: 1.2; }
  .section-heading p { max-width: 800px; margin: .85rem 0 0; color: var(--color-body); font-size: 15px; line-height: 1.75; }
  .logic-heading h2 { font-size: clamp(34px, 4vw, 52px); letter-spacing: -.045em; line-height: 1.08; }
  .logic-heading p { color: var(--color-ink-2); font-size: 18px; line-height: 1.55; }

  .product-flow { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin: 3rem 0 0; padding: 0; list-style: none; }
  .product-flow li { position: relative; display: flex; min-width: 0; flex-direction: column; align-items: center; color: var(--color-ink); text-align: center; }
  .product-flow li:not(:last-child)::after { content: ""; position: absolute; top: 45px; left: calc(50% + 57px); width: calc(100% - 114px); height: 1px; background: rgba(74,135,190,.44); }
  .product-flow li:not(:last-child)::before { content: ""; position: absolute; top: 41px; right: -4px; z-index: 1; width: 8px; height: 8px; background: #ea5b0c; border-radius: 50%; }
  .flow-node { display: block; width: 92px; height: 92px; background: rgba(255,255,255,.34); border: 2px solid rgba(255,255,255,.9); border-radius: 50%; box-shadow: inset 0 0 22px rgba(255,255,255,.25), 0 8px 22px rgba(30,50,70,.04); }
  .product-flow strong { display: block; margin-top: 1.05rem; font-size: 16px; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }

  .principles-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .principles-grid li { min-height: 150px; padding: 1.35rem; background: rgba(255,255,255,.52); border: 1px solid var(--color-border-soft); border-top: 2px solid rgba(30,60,100,.34); }
  .principles-grid span { display: block; margin-bottom: 1.2rem; color: var(--color-amber); font-size: 10.5px; font-weight: 500; letter-spacing: .1em; }
  .principles-grid strong { color: var(--color-ink); font-size: 14px; font-weight: 500; line-height: 1.5; }

  .proof-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .proof-card { min-width: 0; padding: 1.55rem; background: rgba(255,255,255,.54); border: 1px solid var(--color-border-soft); border-top: 2px solid rgba(30,60,100,.34); }
  .proof-card h3 { margin: 0; color: var(--color-ink); font-size: 17px; font-weight: 500; letter-spacing: -.015em; line-height: 1.35; }
  .proof-card p { margin: .75rem 0 0; color: var(--color-body); font-size: 13px; line-height: 1.65; }

  @media (max-width: 1120px) {
    .principles-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow-node { width: 72px; height: 72px; }
    .product-flow li:not(:last-child)::after { top: 35px; left: calc(50% + 47px); width: calc(100% - 94px); }
    .product-flow li:not(:last-child)::before { top: 31px; }
    .product-flow strong { font-size: 14px; }
  }

  @media (max-width: 900px) {
    .proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .landing-hero { padding: 1rem 0 4rem; }
    .landing-hero::after { left: 0; }
    h1 { font-size: 43px; }
    .hero-subheadline { font-size: 24px; }
    .hero-copy { font-size: 15px; }
    .logic-section, .principles-section, .proof-section { padding: 4rem 0; }
    .section-heading { grid-template-columns: 1fr; gap: 1rem; }
    .section-heading { margin-bottom: 2rem; }
    .section-heading h2 { font-size: 26px; }
    .logic-heading h2 { font-size: 34px; }
    .logic-heading p { font-size: 16px; line-height: 1.65; }
    .product-flow { grid-template-columns: 1fr; gap: 0; margin-top: 2.75rem; }
    .product-flow li { display: grid; min-height: 78px; grid-template-columns: 58px 1fr; gap: 1.25rem; align-items: center; text-align: left; }
    .product-flow li:not(:last-child)::after { top: 57px; left: 28px; width: 1px; height: 21px; }
    .product-flow li:not(:last-child)::before { top: auto; right: auto; bottom: 7px; left: 25px; width: 7px; height: 7px; }
    .flow-node { width: 58px; height: 58px; }
    .product-flow strong { margin: 0; font-size: 17px; }
    .principles-grid, .proof-grid { grid-template-columns: 1fr; }
    .principles-grid li { min-height: 0; }
  }

  @media (max-width: 430px) {
    h1 { font-size: 36px; }
  }
</style>
