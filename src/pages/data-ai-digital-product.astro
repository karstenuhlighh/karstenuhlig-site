---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import DataAiCapabilityGrid from "../components/DataAiCapabilityGrid.astro";
import MarketingDecisioningCase from "../components/MarketingDecisioningCase.astro";
import { getLanguage } from "../i18n/routes";

const language = getLanguage(Astro.url.pathname);
const isEnglish = language === "en";

const principles = isEnglish ? [
  "Start with the decision, not the technology.",
  "Use the simplest mechanism that solves the problem.",
  "Evidence over plausibility.",
  "Intelligence creates value only through action.",
  "Reliability must scale with automation.",
] : [
  "Start with the decision, not the technology.",
  "Use the simplest mechanism that solves the problem.",
  "Evidence over plausibility.",
  "Intelligence creates value only through action.",
  "Reliability must scale with automation.",
];

const enterpriseProofs = isEnglish ? [
  {
    title: "Integrated customer & marketing data platform",
    body: "Connected web, customer, transaction and marketing data as a shared foundation for analytics and steering.",
  },
  {
    title: "Data Science & predictive use cases",
    body: "Developed scoring, forecasting models and Data Science applications from validation through to operational use.",
  },
  {
    title: "Recommendation, Ranking & Personalisation",
    body: "Connected Search & Browse ranking, recommendations and real-time Personalisation with digital customer journeys.",
  },
  {
    title: "Cross-channel decisioning",
    body: "Used customer state and response signals for coordinated decisions across CRM, Paid Media and Onsite.",
  },
  {
    title: "BigQuery / GCP transformation",
    body: "Developed an established BI and data landscape towards a cloud-based analytics and data platform.",
  },
] : [
  {
    title: "Integrated customer & marketing data platform",
    body: "Web-, Customer-, Transaktions- und Marketingdaten als gemeinsame Grundlage für Analytics und Steuerung verbunden.",
  },
  {
    title: "Data Science & predictive use cases",
    body: "Scoring, Prognosemodelle und Data-Science-Anwendungen von der Validierung bis zur operativen Nutzung entwickelt.",
  },
  {
    title: "Recommendation, Ranking & Personalisation",
    body: "Search-&-Browse-Ranking, Empfehlungen und Realtime-Personalisierung mit digitalen Customer Journeys verknüpft.",
  },
  {
    title: "Cross-channel decisioning",
    body: "Customer State und Response-Signale für abgestimmte Entscheidungen über CRM, Paid Media und Onsite eingesetzt.",
  },
  {
    title: "BigQuery / GCP transformation",
    body: "Eine gewachsene BI- und Data-Landschaft in Richtung cloud-basierter Analytics- und Datenplattform weiterentwickelt.",
  },
];

const explorations = isEnglish ? [
  {
    title: "Augur / sem-agentic",
    status: "Prototype",
    body: "AI-assisted SEM decisioning with LLMs, rules, tools, evals and human approval. Architecture and evaluation are evidenced; autonomous production impact is not.",
    href: undefined,
  },
  {
    title: "Signal Steering",
    status: "Prototype · synthetic data",
    body: "Measurement and Decision Intelligence through triangulation of attribution, geo-incrementality and MMM. Signal Steering is explicitly not an agentic system.",
    href: undefined,
  },
  {
    title: "KA-OS",
    status: "Active personal use",
    body: "AI-enabled knowledge and context system for robust, longer-term human-AI work. Active personal use, not an enterprise-scale claim.",
    href: undefined,
  },
] : [
  {
    title: "Augur / sem-agentic",
    status: "Prototype",
    body: "AI-assisted SEM decisioning mit LLMs, Rules, Tools, Evals und Human Approval. Belegt sind Architektur und Evaluation, nicht autonome Produktionswirkung.",
    href: "/agentic-ai/sem-agentic",
  },
  {
    title: "Signal Steering",
    status: "Prototype · synthetic data",
    body: "Measurement und Decision Intelligence durch Triangulation von Attribution, Geo-Incrementality und MMM. Signal Steering ist ausdrücklich kein Agentic System.",
    href: "/agentic-ai/signal-steering",
  },
  {
    title: "KA-OS",
    status: "Active personal use",
    body: "AI-enabled knowledge and context system für belastbare, längerfristige Human-AI-Arbeit. Aktive persönliche Nutzung, kein Enterprise-Scale-Claim.",
    href: undefined,
  },
];
---

<SubPageLayout
  editorial
  language={language}
  title={isEnglish ? "Data, AI & Decisioning | Karsten Uhlig" : "Data, AI & Decisioning | Karsten Uhlig"}
  description={isEnglish ? "Data, AI and Decisioning as an execution capability for Digital Commerce: from robust signals through intelligence to effective decisions." : "Data, AI und Decisioning als Execution Capability für Digital Commerce: von belastbaren Signalen über Intelligence bis zu wirksamen Entscheidungen."}
>
  <article class="data-landing">
    <header class="landing-hero">
      <div class="hero-main">
        <div class="hero-eyebrow">Execution Capability for Digital Commerce</div>
        <h1>Data, AI &amp;<br />Decisioning</h1>
        <p class="hero-subheadline">{isEnglish ? "Data becomes valuable when it enables better commercial decisions." : "Daten werden dann wertvoll, wenn sie bessere kommerzielle Entscheidungen ermöglichen."}</p>
        <p class="hero-copy">{isEnglish ? "I connect Measurement, Customer Data, Analytics, Data Science and AI with the decision systems and digital products that turn them into concrete customer and business impact. Commercial Management remains the starting point: which customer, growth or resource decision needs to improve?" : "Ich verbinde Measurement, Customer Data, Analytics, Data Science und AI mit den Entscheidungssystemen und digitalen Produkten, die daraus konkrete Kunden- und Geschäftswirkung erzeugen. Der Ausgangspunkt bleibt dabei Commercial Management: Welche Kunden-, Wachstums- oder Ressourcenentscheidung muss besser werden?"}</p>
      </div>

      {!isEnglish && (
        <nav class="page-jump-nav" aria-label="Auf dieser Seite">
          <div class="jump-nav-title">Auf dieser Seite</div>
          <a href="#marketing-decisioning-case-title"><span aria-hidden="true">01</span>Marketing Decisioning Capability bei bonprix</a>
          <a href="#current-proof-title"><span aria-hidden="true">02</span>Aktuelle AI-Explorationen</a>
          <a href="#data-ai-fields"><span aria-hidden="true">03</span>8 Capability-Felder</a>
          <a href="#principles-title"><span aria-hidden="true">04</span>Prinzipien</a>
          <a href="#enterprise-proof-title"><span aria-hidden="true">05</span>Auf Enterprise-Level aufgebaut und skaliert</a>
        </nav>
      )}
    </header>

    {!isEnglish && <MarketingDecisioningCase />}

    <section class="proof-section current-section" aria-labelledby="current-proof-title">
      <div class="section-heading">
        <div class="section-kicker">Current AI explorations</div>
        <div>
          <h2 id="current-proof-title">{isEnglish ? "Current spaces for learning and application — with maturity made explicit." : "Aktuelle AI-Explorationen und Prototypen"}</h2>
          <p>{isEnglish ? "This work demonstrates architecture, methods and active learning. It deliberately does not carry the same level of evidence as the enterprise experience." : "Eigene Arbeiten zu AI-enabled Decisioning, Measurement und Knowledge Systems. Fokus auf Architektur, Methoden und konkrete Anwendung – mit klarer Trennung zwischen Prototyping und Enterprise-Scale-Erfahrung."}</p>
        </div>
      </div>
      <div class="proof-grid exploration-grid">
        {explorations.map((item) => (
          <article class="exploration-card">
            <div class="status">{item.status}</div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {item.href && <a href={item.href}>{isEnglish ? "Explore" : "Vertiefen"} <span aria-hidden="true">→</span></a>}
          </article>
        ))}
      </div>
    </section>

    <DataAiCapabilityGrid language={language} />

    <section class="principles-section" aria-labelledby="principles-title">
      <div class="section-heading">
        <div class="section-kicker">Principles</div>
        <h2 id="principles-title">{isEnglish ? "Technology follows the decision question." : "Technologie folgt der Entscheidungsfrage."}</h2>
      </div>
      <ol class="principles-grid">
        {principles.map((principle, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{principle}</strong></li>
        ))}
      </ol>
    </section>

    <section class="proof-section" aria-labelledby="enterprise-proof-title">
      <div class="section-heading">
        <div class="section-kicker">Built &amp; scaled at enterprise level</div>
        <div>
          <h2 id="enterprise-proof-title">{isEnglish ? "Substance from operational accountability and scale." : "Substanz aus operativer Verantwortung und Skalierung."}</h2>
          <p>{isEnglish ? "The established experience lies in building integrated Data, Analytics and Decisioning capabilities for an international Digital Commerce business." : "Die historische Erfahrung liegt im Aufbau integrierter Data-, Analytics- und Decisioning-Capabilities für ein internationales Digital-Commerce-Geschäft."}</p>
        </div>
      </div>
      <div class="proof-grid enterprise-grid">
        {enterpriseProofs.map((proof) => (
          <article class="proof-card">
            <h3>{proof.title}</h3>
            <p>{proof.body}</p>
          </article>
        ))}
      </div>
    </section>

  </article>
</SubPageLayout>

<style>
  .data-landing { min-width: 0; }
  :global(html) { scroll-behavior: smooth; }
  .landing-hero { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(400px, 420px); gap: clamp(2rem, 3.5vw, 3.5rem); align-items: start; padding: 2rem 0 4rem; border-bottom: 1px solid var(--color-border-soft); }
  .hero-eyebrow, .section-kicker { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .hero-eyebrow { display: flex; gap: .85rem; align-items: center; margin-bottom: 1.1rem; }
  .hero-eyebrow::before { content: ""; width: 2.25rem; height: 2px; flex: 0 0 auto; background: var(--color-amber); }
  h1 { max-width: 800px; margin: 0; color: var(--color-ink); font-size: clamp(46px, 5.4vw, 64px); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  .hero-subheadline { max-width: 800px; margin: 1.35rem 0 0; color: var(--color-ink); font-size: clamp(22px, 2.35vw, 30px); font-weight: 500; letter-spacing: -.025em; line-height: 1.25; }
  .hero-copy { max-width: 800px; margin: 1.35rem 0 0; color: var(--color-body); font-size: 15.5px; line-height: 1.72; }
  .page-jump-nav { display: grid; gap: .05rem; margin-top: 1rem; padding: 1.25rem 1.4rem; background: rgba(255,255,255,.38); border: 1px solid var(--color-border-soft); border-radius: 2px; }
  .jump-nav-title { margin-bottom: .8rem; color: var(--color-amber); font-size: 12px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .page-jump-nav a { display: grid; grid-template-columns: 1.7rem minmax(0, 1fr); gap: .55rem; padding: .62rem 0; color: var(--color-ink); font-size: 14px; font-weight: 600; line-height: 1.4; text-decoration: none; border-bottom: 1px solid rgba(30,60,100,.2); transition: color .18s ease; }
  .page-jump-nav a span { color: var(--color-amber); font-size: 11.5px; font-weight: 600; letter-spacing: .08em; }
  .page-jump-nav a:hover { color: var(--color-ink); }
  .page-jump-nav a:focus-visible { outline: 3px solid rgba(180,83,9,.4); outline-offset: 3px; }
  :global(#marketing-decisioning-case-title), :global(#case-foundation-title), :global(#enterprise-proof-title), :global(#current-proof-title), :global(#data-ai-fields), :global(#principles-title) { scroll-margin-top: 2rem; }

  .principles-section, .proof-section { padding: 4rem 0; border-top: 1px solid var(--color-border); }
  .section-heading { display: grid; grid-template-columns: .34fr 1fr; gap: 4rem; align-items: start; }
  .section-heading { margin-bottom: 2rem; }
  .section-heading h2 { max-width: 820px; margin: 0; color: var(--color-ink); font-size: 30px; font-weight: 500; letter-spacing: -.03em; line-height: 1.2; }
  .section-heading p { max-width: 780px; margin: .85rem 0 0; color: var(--color-body); font-size: 15px; line-height: 1.75; }

  .principles-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .principles-grid li { min-height: 150px; padding: 1.35rem; background: rgba(255,255,255,.52); border: 1px solid var(--color-border-soft); border-top: 2px solid rgba(30,60,100,.34); }
  .principles-grid span { display: block; margin-bottom: 1.2rem; color: var(--color-amber); font-size: 10.5px; font-weight: 500; letter-spacing: .1em; }
  .principles-grid strong { color: var(--color-ink); font-size: 14px; font-weight: 500; line-height: 1.5; }

  .proof-grid { display: grid; gap: 1rem; }
  .enterprise-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .proof-card, .exploration-card { min-width: 0; padding: 1.55rem; background: rgba(255,255,255,.54); border: 1px solid var(--color-border-soft); border-top: 2px solid rgba(30,60,100,.34); }
  .proof-card h3, .exploration-card h3 { margin: 0; color: var(--color-ink); font-size: 17px; font-weight: 500; letter-spacing: -.015em; line-height: 1.35; }
  .proof-card p, .exploration-card p { margin: .75rem 0 0; color: var(--color-body); font-size: 13px; line-height: 1.65; }
  .exploration-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .exploration-card { display: flex; min-height: 265px; flex-direction: column; }
  .status { margin-bottom: 1rem; color: var(--color-amber); font-size: 10.5px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  .exploration-card a { display: inline-flex; gap: .45rem; align-items: center; align-self: flex-start; margin-top: auto; padding-top: 1.25rem; color: var(--color-amber); font-size: 13px; font-weight: 500; text-decoration: none; }
  .exploration-card a:hover { opacity: .72; }
  .exploration-card a:focus-visible { outline: 3px solid rgba(180,83,9,.4); outline-offset: 4px; }

  :global(.data-landing .field-section) { padding-top: 4rem; padding-bottom: 4rem; }
  :global(.data-landing .field-section > .section-heading) { margin-bottom: 2rem; }

  @media (min-width: 901px) {
    .page-jump-nav a { white-space: nowrap; }
  }

  @media (max-width: 1120px) {
    .enterprise-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .principles-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .landing-hero { grid-template-columns: minmax(0, 1fr) minmax(280px, 320px); gap: 2rem; }
    .exploration-grid { grid-template-columns: 1fr; }
    .exploration-card { min-height: 0; }
  }

  @media (max-width: 760px) {
    .landing-hero { grid-template-columns: 1fr; gap: 2rem; padding: 1rem 0 3rem; }
    h1 { font-size: 42px; }
    .hero-subheadline { font-size: 23px; }
    .hero-copy { font-size: 15px; }
    .page-jump-nav { margin-top: 0; padding: 1.1rem 1.2rem; }
    .principles-section, .proof-section { padding: 3rem 0; }
    .section-heading { grid-template-columns: 1fr; gap: 1rem; }
    .section-heading { margin-bottom: 1.5rem; }
    .section-heading h2 { font-size: 26px; }
    .principles-grid, .enterprise-grid { grid-template-columns: 1fr; }
    .principles-grid li { min-height: 0; }
    :global(.data-landing .field-section) { padding-top: 3rem; padding-bottom: 3rem; }
    :global(.data-landing .field-section > .section-heading) { margin-bottom: 1.5rem; }
  }

  @media (max-width: 430px) {
    h1 { font-size: 38px; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .page-jump-nav a { transition: none; }
  }
</style>
