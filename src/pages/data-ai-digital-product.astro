---
import SubPageLayout from "../layouts/SubPageLayout.astro";

const pilots = [
  {
    number: "01",
    area: "Agentic AI · Marketing",
    title: "sem-agentic",
    thesis: "Wie weit lässt sich ein agentisches System mit sauberer Architektur, Validierung und Rollout-Logik bringen, am Anwendungsfall Google SEM.",
    description: "Ein Multi-Agent-System für Google SEM, das Kampagnensteuerung vorbereitet und koordiniert, statt nur Texte zu erzeugen.",
    steps: ["Research", "Spezialisierte Agenten", "Strategy Coordinator", "Gestufter Rollout"],
    tags: ["Multi-Agent-System", "Validierung", "Human Control"],
    status: "Prototyp · laufender Pilot",
    scope: "Belegt sind Architektur, Validierung und koordinierte Verdichtung. Nicht belegt ist Wirkung im autonomen Betrieb oder im Maßstab.",
    href: "/agentic-ai/sem-agentic",
  },
  {
    number: "02",
    area: "Agentic AI · Measurement & Steering",
    title: "signal-steering",
    thesis: "Wie kann Agentic AI helfen, wenn mehrere Messmethoden denselben Kanal bewerten und zu unterschiedlichen Antworten kommen?",
    description: "Ein trianguliertes Mess- und Steuerungssystem, das Plattform-Attribution, Geo-Incrementality und MMM gegen eine bekannte Wahrheit prüfbar macht.",
    steps: ["Attribution", "Geo-Experiment", "MMM", "Budget-Signal"],
    tags: ["Measurement", "Incrementality", "Resource Allocation"],
    status: "Prototyp · synthetische Daten",
    scope: "Belegt ist die methodische Triangulation auf synthetischen Daten. Nicht belegt sind Produktionsreife oder Wirkung auf realem Spend im Maßstab.",
    href: "/agentic-ai/signal-steering",
  },
];
---

<SubPageLayout
  title="Data, AI & Digital Product | Karsten Uhlig"
  description="Data, AI und Digital Product als Enabler für bessere Entscheidungen und wirtschaftliche Wirkung. Mit den Praxistests sem-agentic und signal-steering."
>
  <article class="data-landing">
    <header class="data-hero">
      <div class="hero-eyebrow">Enabler im Commercial Management</div>
      <h1>Data, AI &amp;<br />Digital Product</h1>
      <p class="hero-subheadline">Digitale Fähigkeiten gezielt für wirtschaftliche Wirkung einsetzen.</p>
      <p class="hero-copy">Data, AI und Digital Product verbinden Datenbasis, Entscheidungslogik und Umsetzung. Relevant werden sie dort, wo sie Entscheidungen verbessern, Kundenerlebnisse verändern oder wirtschaftliche Wirkung wiederholbar in den Betrieb bringen.</p>

    </header>

    <section class="pilots-section" aria-labelledby="pilots-title">
      <div class="section-heading">
        <div class="section-kicker">Erste Praxistests</div>
        <div>
          <h2 id="pilots-title">Zwei Piloten, zwei unterschiedliche Steuerungsfragen.</h2>
          <p>Die Piloten machen zwei Seiten des Enablers konkret: den Aufbau eines agentischen Systems und die belastbare Verdichtung widersprüchlicher Messsignale.</p>
        </div>
      </div>

      <div class="pilot-grid">
        {
          pilots.map((pilot) => (
            <article class="pilot-card">
              <div class="pilot-topline">
                <span>{pilot.number}</span>
                <span>{pilot.status}</span>
              </div>

              <div class="pilot-area">{pilot.area}</div>
              <h3>{pilot.title}</h3>
              <p class="pilot-thesis">{pilot.thesis}</p>

              <div class="pilot-path" aria-label={`${pilot.title}: ${pilot.steps.join(" zu ")}`}>
                {pilot.steps.map((step, index) => (
                  <>
                    <span>{step}</span>
                    {index < pilot.steps.length - 1 && <b aria-hidden="true">→</b>}
                  </>
                ))}
              </div>

              <p class="pilot-description">{pilot.description}</p>

              <div class="pilot-tags" aria-label="Schwerpunkte">
                {pilot.tags.map((tag) => <span>{tag}</span>)}
              </div>

              <div class="pilot-scope">
                <strong>Geltungsbereich</strong>
                <p>{pilot.scope}</p>
              </div>

              <a class="pilot-link" href={pilot.href}>Pilot ansehen <span aria-hidden="true">→</span></a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="draft-note" aria-labelledby="draft-note-title">
      <div class="section-kicker">Einordnung</div>
      <div>
        <h2 id="draft-note-title">Praxistests statt Technologieversprechen.</h2>
        <p>Die beiden Piloten belegen konkrete Bestandteile und Lernfortschritt, nicht bereits wirtschaftliche Wirkung im Maßstab. Die tiefere fachliche Struktur dieser Landingpage wird im nächsten Schritt weiterentwickelt.</p>
      </div>
    </section>
  </article>
</SubPageLayout>

<style>
  .data-landing { min-width: 0; }
  .data-hero { position: relative; padding: 2.25rem 0 5.25rem; }
  .data-hero::after { content: ""; position: absolute; right: 2%; bottom: 0; left: 34%; height: 1px; background: linear-gradient(90deg, rgba(180,83,9,.65), rgba(30,60,100,.14), transparent); }
  .hero-eyebrow, .section-kicker { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .hero-eyebrow { margin-bottom: 1rem; }
  h1 { max-width: 900px; margin: 0; color: var(--color-ink); font-size: clamp(46px, 6.5vw, 78px); font-weight: 500; letter-spacing: -.055em; line-height: .98; }
  .hero-subheadline { max-width: 820px; margin: 1.6rem 0 0; color: var(--color-ink); font-size: clamp(22px, 2.6vw, 33px); font-weight: 400; letter-spacing: -.025em; line-height: 1.25; }
  .hero-copy { max-width: 800px; margin: 1.5rem 0 0; color: var(--color-body); font-size: 16px; line-height: 1.8; }

  .pilots-section { padding: 5.5rem 0; border-top: 1px solid var(--color-border); }
  .section-heading, .draft-note { display: grid; grid-template-columns: .34fr 1fr; gap: 4rem; align-items: start; }
  .section-heading { margin-bottom: 2.75rem; }
  .section-heading h2, .draft-note h2 { margin: 0; color: var(--color-ink); font-size: 31px; font-weight: 500; letter-spacing: -.03em; line-height: 1.18; }
  .section-heading p, .draft-note p { max-width: 780px; margin: .85rem 0 0; color: var(--color-body); font-size: 15px; line-height: 1.75; }
  .pilot-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1.25rem; }
  .pilot-card { display: flex; min-width: 0; min-height: 610px; flex-direction: column; padding: 2rem 2.15rem 2.2rem; background: rgba(255,255,255,.58); border: 1px solid var(--color-border-soft); border-top: 2px solid rgba(30,60,100,.34); }
  .pilot-topline { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 2.1rem; color: var(--color-ink-3); font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; }
  .pilot-topline span:first-child { color: var(--color-amber); }
  .pilot-area { margin-bottom: .65rem; color: var(--color-ink-3); font-size: 10.5px; font-weight: 500; letter-spacing: .11em; text-transform: uppercase; }
  .pilot-card h3 { margin: 0 0 .75rem; color: var(--color-ink); font-size: 32px; font-weight: 500; letter-spacing: -.035em; line-height: 1.1; }
  .pilot-thesis { margin: 0; color: var(--color-ink); font-size: 17px; line-height: 1.55; }
  .pilot-path { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; gap: .5rem; align-items: center; margin: 1.6rem 0; padding: 1rem; background: rgba(231,238,246,.7); border: 1px solid rgba(30,60,100,.14); }
  .pilot-path span { color: var(--color-ink-2); font-size: 11px; font-weight: 500; line-height: 1.35; text-align: center; }
  .pilot-path b { color: var(--color-amber); font-size: 14px; font-weight: 400; }
  .pilot-description { margin: 0; color: var(--color-body); font-size: 14px; line-height: 1.7; }
  .pilot-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.15rem; }
  .pilot-tags span { padding: .4rem .55rem; color: var(--color-ink-2); font-size: 10.5px; font-weight: 500; line-height: 1; background: rgba(225,234,243,.72); border: 1px solid var(--color-border-soft); }
  .pilot-scope { margin-top: 1.5rem; padding-top: 1.2rem; border-top: 1px solid var(--color-border-soft); }
  .pilot-scope strong { color: var(--color-ink-3); font-size: 10px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .pilot-scope p { margin: .55rem 0 0; color: var(--color-ink-3); font-size: 12.5px; line-height: 1.6; }
  .pilot-link { display: inline-flex; gap: .45rem; align-items: center; align-self: flex-start; margin-top: auto; padding-top: 1.5rem; color: var(--color-amber); font-size: 14px; font-weight: 500; text-decoration: none; }
  .pilot-link:hover { opacity: .72; }
  .pilot-link:focus-visible { outline: 3px solid rgba(180,83,9,.4); outline-offset: 4px; }

  .draft-note { padding: 5rem 0 1rem; border-top: 1px solid var(--color-border); }

  @media (max-width: 960px) {
    .pilot-grid { grid-template-columns: 1fr; }
    .pilot-card { min-height: 0; }
  }

  @media (max-width: 760px) {
    .data-hero { padding: 1rem 0 4rem; }
    .data-hero::after { left: 0; }
    h1 { font-size: 46px; }
    .hero-subheadline { font-size: 24px; }
    .hero-copy { font-size: 15px; }
    .pilots-section { padding: 4rem 0; }
    .section-heading, .draft-note { grid-template-columns: 1fr; gap: 1rem; }
    .section-heading { margin-bottom: 2rem; }
    .section-heading h2, .draft-note h2 { font-size: 27px; }
    .pilot-card { padding: 1.5rem; }
    .pilot-path { grid-template-columns: 1fr; }
    .pilot-path b { transform: rotate(90deg); text-align: center; }
    .draft-note { padding-top: 4rem; }
  }

  @media (max-width: 430px) {
    h1 { font-size: 39px; }
    .pilot-card h3 { font-size: 28px; }
    .pilot-topline { align-items: flex-start; flex-direction: column; margin-bottom: 1.5rem; }
  }
</style>
