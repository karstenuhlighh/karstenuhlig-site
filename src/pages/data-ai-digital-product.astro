---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import DataAiCapabilityGrid from "../components/DataAiCapabilityGrid.astro";

const decisionFlow = ["Data", "State", "Intelligence", "Decision", "Action", "Learning"];

const principles = [
  "Start with the decision, not the technology.",
  "Use the simplest mechanism that solves the problem.",
  "Evidence over plausibility.",
  "Intelligence creates value only through action.",
  "Reliability must scale with automation.",
];

const enterpriseProofs = [
  {
    title: "Integrated customer & marketing data platform",
    body: "Web-, Customer-, Transaktions- und Marketingdaten als gemeinsame Grundlage für Analytics und Steuerung verbunden.",
  },
  {
    title: "Data Science & predictive use cases",
    body: "Scoring, Prognosemodelle und Data-Science-Anwendungen von der Validierung bis zur operativen Nutzung entwickelt.",
  },
  {
    title: "Recommendation, Ranking & Personalisation",
    body: "Search-&-Browse-Ranking, Empfehlungen und Realtime-Personalisierung mit digitalen Customer Journeys verknüpft.",
  },
  {
    title: "Cross-channel decisioning",
    body: "Customer State und Response-Signale für abgestimmte Entscheidungen über CRM, Paid Media und Onsite eingesetzt.",
  },
  {
    title: "BigQuery / GCP transformation",
    body: "Eine gewachsene BI- und Data-Landschaft in Richtung cloud-basierter Analytics- und Datenplattform weiterentwickelt.",
  },
];

const explorations = [
  {
    title: "Augur / sem-agentic",
    status: "Prototype",
    body: "AI-assisted SEM decisioning mit LLMs, Rules, Tools, Evals und Human Approval. Belegt sind Architektur und Evaluation, nicht autonome Produktionswirkung.",
    href: "/agentic-ai/sem-agentic",
  },
  {
    title: "Signal Steering",
    status: "Prototype · synthetic data",
    body: "Measurement und Decision Intelligence durch Triangulation von Attribution, Geo-Incrementality und MMM. Signal Steering ist ausdrücklich kein Agentic System.",
    href: "/agentic-ai/signal-steering",
  },
  {
    title: "KA-OS",
    status: "Active personal use",
    body: "AI-enabled knowledge and context system für belastbare, längerfristige Human-AI-Arbeit. Aktive persönliche Nutzung, kein Enterprise-Scale-Claim.",
    href: undefined,
  },
];
---

<SubPageLayout
  title="Data, AI & Decisioning | Karsten Uhlig"
  description="Data, AI und Decisioning als Execution Capability für Digital Commerce: von belastbaren Signalen über Intelligence bis zu wirksamen Entscheidungen."
>
  <article class="data-landing">
    <header class="landing-hero">
      <div class="hero-eyebrow">Execution Capability for Digital Commerce</div>
      <h1>Data, AI &amp;<br />Decisioning</h1>
      <p class="hero-subheadline">Daten werden dann wertvoll, wenn sie bessere kommerzielle Entscheidungen ermöglichen.</p>
      <p class="hero-copy">Ich verbinde Measurement, Customer Data, Analytics, Data Science und AI mit den Entscheidungssystemen und digitalen Produkten, die daraus konkrete Kunden- und Geschäftswirkung erzeugen. Der Ausgangspunkt bleibt dabei Commercial Management: Welche Kunden-, Wachstums- oder Ressourcenentscheidung muss besser werden?</p>
    </header>

    <section class="logic-section" aria-labelledby="decision-logic-title">
      <div class="logic-intro">
        <svg class="signal-lines" viewBox="0 0 320 220" aria-hidden="true" focusable="false">
          <path d="M2 34 C108 28 156 54 205 126" />
          <path d="M2 100 C92 100 112 146 205 158" />
          <path d="M2 164 C82 174 130 198 258 198" />
          <path d="M205 126 H318" />
          <circle class="signal-node signal-node-small" cx="90" cy="126" r="5" />
          <circle class="signal-node" cx="153" cy="101" r="8" />
          <circle class="signal-halo" cx="205" cy="126" r="21" />
          <circle class="signal-node signal-node-active" cx="205" cy="126" r="9" />
        </svg>
        <div class="logic-copy">
          <div class="section-kicker">Die zentrale Logik</div>
          <h2 id="decision-logic-title">Von Daten zur wirksamen Entscheidung.</h2>
          <p>Belastbare Signale schaffen Customer Context. Analytics und Modelle verdichten ihn zu Intelligence. Wert entsteht erst in einer konkreten Action.</p>
        </div>
      </div>
      <ol class="decision-flow" aria-label={decisionFlow.join(" zu ")}>
        {decisionFlow.map((step) => (
          <li>
            <span class="flow-node" aria-hidden="true"></span>
            <strong>{step}</strong>
          </li>
        ))}
      </ol>
    </section>

    <DataAiCapabilityGrid />

    <section class="principles-section" aria-labelledby="principles-title">
      <div class="section-heading">
        <div class="section-kicker">Principles</div>
        <h2 id="principles-title">Technologie folgt der Entscheidungsfrage.</h2>
      </div>
      <ol class="principles-grid">
        {principles.map((principle, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{principle}</strong></li>
        ))}
      </ol>
    </section>

    <section class="proof-section" aria-labelledby="enterprise-proof-title">
      <div class="section-heading">
        <div class="section-kicker">Built &amp; scaled at enterprise level</div>
        <div>
          <h2 id="enterprise-proof-title">Substanz aus operativer Verantwortung und Skalierung.</h2>
          <p>Die historische Erfahrung liegt im Aufbau integrierter Data-, Analytics- und Decisioning-Capabilities für ein internationales Digital-Commerce-Geschäft.</p>
        </div>
      </div>
      <div class="proof-grid enterprise-grid">
        {enterpriseProofs.map((proof) => (
          <article class="proof-card">
            <h3>{proof.title}</h3>
            <p>{proof.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="proof-section current-section" aria-labelledby="current-proof-title">
      <div class="section-heading">
        <div class="section-kicker">Current AI explorations</div>
        <div>
          <h2 id="current-proof-title">Aktuelle Lern- und Anwendungsräume — mit offenem Reifegrad.</h2>
          <p>Diese Arbeiten zeigen Architektur, Methoden und aktives Lernen. Sie stehen bewusst nicht auf derselben Evidenzstufe wie die Enterprise-Erfahrung.</p>
        </div>
      </div>
      <div class="proof-grid exploration-grid">
        {explorations.map((item) => (
          <article class="exploration-card">
            <div class="status">{item.status}</div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {item.href && <a href={item.href}>Vertiefen <span aria-hidden="true">→</span></a>}
          </article>
        ))}
      </div>
    </section>

    <section class="commercial-return" aria-labelledby="commercial-return-title">
      <div class="section-kicker">Commercial first</div>
      <div>
        <h2 id="commercial-return-title">Data &amp; AI ist kein Selbstzweck.</h2>
        <p>Der Ausgangspunkt bleibt die kommerzielle Frage: Welche Kunden-, Wachstums- oder Ressourcenentscheidung muss besser werden?</p>
        <a href="/commercial-management">Zurück zu Commercial Management <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </article>
</SubPageLayout>

<style>
  .data-landing { min-width: 0; }
  .landing-hero { position: relative; padding: 2.25rem 0 5.25rem; }
  .landing-hero::after { content: ""; position: absolute; right: 2%; bottom: 0; left: 34%; height: 1px; background: linear-gradient(90deg, rgba(180,83,9,.65), rgba(30,60,100,.14), transparent); }
  .hero-eyebrow, .section-kicker { color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .hero-eyebrow { margin-bottom: 1rem; }
  h1 { max-width: 900px; margin: 0; color: var(--color-ink); font-size: clamp(46px, 6.5vw, 78px); font-weight: 500; letter-spacing: -.055em; line-height: .98; }
  .hero-subheadline { max-width: 860px; margin: 1.55rem 0 0; color: var(--color-ink); font-size: clamp(22px, 2.7vw, 34px); font-weight: 400; letter-spacing: -.025em; line-height: 1.25; }
  .hero-copy { max-width: 830px; margin: 1.55rem 0 0; color: var(--color-body); font-size: 16px; line-height: 1.8; }

  .logic-section, .principles-section, .proof-section { padding: 5.5rem 0; border-top: 1px solid var(--color-border); }
  .logic-section { position: relative; overflow: hidden; padding-bottom: 6.5rem; }
  .logic-intro { display: grid; grid-template-columns: .34fr 1fr; gap: 4rem; align-items: center; min-height: 250px; }
  .signal-lines { display: block; width: 100%; height: auto; overflow: visible; }
  .signal-lines path { fill: none; stroke: rgba(74,135,190,.42); stroke-width: 1.15; }
  .signal-node { fill: #6f9dcc; stroke: rgba(255,255,255,.34); stroke-width: 1; }
  .signal-node-small { fill: #8eb8dc; }
  .signal-halo { fill: rgba(180,83,9,.12); }
  .signal-node-active { fill: #ea5b0c; stroke: rgba(180,83,9,.45); }
  .logic-copy .section-kicker { margin-bottom: 1.4rem; }
  .logic-copy h2 { max-width: 900px; margin: 0; color: var(--color-ink); font-size: clamp(34px, 4vw, 52px); font-weight: 500; letter-spacing: -.045em; line-height: 1.08; }
  .logic-copy p { max-width: 880px; margin: 1.55rem 0 0; color: var(--color-ink-2); font-size: 18px; line-height: 1.55; }
  .section-heading, .commercial-return { display: grid; grid-template-columns: .34fr 1fr; gap: 4rem; align-items: start; }
  .section-heading { margin-bottom: 2.75rem; }
  .section-heading h2, .commercial-return h2 { max-width: 820px; margin: 0; color: var(--color-ink); font-size: 30px; font-weight: 500; letter-spacing: -.03em; line-height: 1.2; }
  .section-heading p, .commercial-return p { max-width: 780px; margin: .85rem 0 0; color: var(--color-body); font-size: 15px; line-height: 1.75; }

  .decision-flow { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); margin: 3rem 0 0; padding: 0; list-style: none; }
  .decision-flow li { position: relative; display: flex; min-width: 0; flex-direction: column; align-items: center; color: var(--color-ink); text-align: center; }
  .decision-flow li:not(:last-child)::after { content: ""; position: absolute; top: 45px; left: calc(50% + 57px); width: calc(100% - 114px); height: 1px; background: rgba(74,135,190,.44); }
  .decision-flow li:not(:last-child)::before { content: ""; position: absolute; top: 41px; right: -4px; z-index: 1; width: 8px; height: 8px; background: #ea5b0c; border-radius: 50%; }
  .flow-node { display: block; width: 92px; height: 92px; background: rgba(255,255,255,.34); border: 2px solid rgba(255,255,255,.9); border-radius: 50%; box-shadow: inset 0 0 22px rgba(255,255,255,.25), 0 8px 22px rgba(30,50,70,.04); }
  .decision-flow strong { display: block; margin-top: 1.05rem; font-size: 18px; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }

  .principles-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .principles-grid li { min-height: 150px; padding: 1.35rem; background: rgba(255,255,255,.52); border: 1px solid var(--color-border-soft); border-top: 2px solid rgba(30,60,100,.34); }
  .principles-grid span { display: block; margin-bottom: 1.2rem; color: var(--color-amber); font-size: 10.5px; font-weight: 500; letter-spacing: .1em; }
  .principles-grid strong { color: var(--color-ink); font-size: 14px; font-weight: 500; line-height: 1.5; }

  .proof-grid { display: grid; gap: 1rem; }
  .enterprise-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .proof-card, .exploration-card { min-width: 0; padding: 1.55rem; background: rgba(255,255,255,.54); border: 1px solid var(--color-border-soft); border-top: 2px solid rgba(30,60,100,.34); }
  .proof-card h3, .exploration-card h3 { margin: 0; color: var(--color-ink); font-size: 17px; font-weight: 500; letter-spacing: -.015em; line-height: 1.35; }
  .proof-card p, .exploration-card p { margin: .75rem 0 0; color: var(--color-body); font-size: 13px; line-height: 1.65; }
  .exploration-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .exploration-card { display: flex; min-height: 265px; flex-direction: column; }
  .status { margin-bottom: 1rem; color: var(--color-amber); font-size: 10.5px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  .exploration-card a, .commercial-return a { display: inline-flex; gap: .45rem; align-items: center; align-self: flex-start; margin-top: auto; padding-top: 1.25rem; color: var(--color-amber); font-size: 13px; font-weight: 500; text-decoration: none; }
  .exploration-card a:hover, .commercial-return a:hover { opacity: .72; }
  .exploration-card a:focus-visible, .commercial-return a:focus-visible { outline: 3px solid rgba(180,83,9,.4); outline-offset: 4px; }

  .commercial-return { margin-top: 1rem; padding: 5rem 0 1rem; border-top: 1px solid var(--color-border); }
  .commercial-return a { margin-top: .5rem; font-size: 14px; }

  @media (max-width: 1120px) {
    .enterprise-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .principles-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow-node { width: 72px; height: 72px; }
    .decision-flow li:not(:last-child)::after { top: 35px; left: calc(50% + 47px); width: calc(100% - 94px); }
    .decision-flow li:not(:last-child)::before { top: 31px; }
    .decision-flow strong { font-size: 16px; }
  }

  @media (max-width: 900px) {
    .exploration-grid { grid-template-columns: 1fr; }
    .exploration-card { min-height: 0; }
  }

  @media (max-width: 760px) {
    .landing-hero { padding: 1rem 0 4rem; }
    .landing-hero::after { left: 0; }
    h1 { font-size: 46px; }
    .hero-subheadline { font-size: 24px; }
    .hero-copy { font-size: 15px; }
    .logic-section, .principles-section, .proof-section { padding: 4rem 0; }
    .logic-section { padding-bottom: 4.5rem; }
    .logic-intro { grid-template-columns: 1fr; gap: 1.5rem; min-height: 0; }
    .signal-lines { width: min(260px, 78vw); margin: -2rem 0 -1rem -4.5rem; }
    .logic-copy h2 { font-size: 34px; }
    .logic-copy p { margin-top: 1.2rem; font-size: 16px; line-height: 1.65; }
    .section-heading, .commercial-return { grid-template-columns: 1fr; gap: 1rem; }
    .section-heading { margin-bottom: 2rem; }
    .section-heading h2, .commercial-return h2 { font-size: 26px; }
    .decision-flow { grid-template-columns: 1fr; gap: 0; margin-top: 2.75rem; }
    .decision-flow li { display: grid; min-height: 78px; grid-template-columns: 58px 1fr; gap: 1.25rem; align-items: center; text-align: left; }
    .decision-flow li:not(:last-child)::after { top: 57px; left: 28px; width: 1px; height: 21px; }
    .decision-flow li:not(:last-child)::before { top: auto; right: auto; bottom: 7px; left: 25px; width: 7px; height: 7px; }
    .flow-node { width: 58px; height: 58px; }
    .decision-flow strong { margin: 0; font-size: 17px; }
    .principles-grid, .enterprise-grid { grid-template-columns: 1fr; }
    .principles-grid li { min-height: 0; }
    .commercial-return { padding-top: 4rem; }
  }

  @media (max-width: 430px) {
    h1 { font-size: 39px; }
  }
</style>
