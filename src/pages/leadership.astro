---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import LeadershipFieldExplorer from "../components/LeadershipFieldExplorer.astro";
import EditorialImage from "../components/EditorialImage.astro";
import { getLanguage } from "../i18n/routes";

const language = getLanguage(Astro.url.pathname);
const isEnglish = language === "en";
---

<SubPageLayout
  editorial
  language={language}
  title="Leadership & Transformation | Karsten Uhlig"
  description={isEnglish ? "For me, leadership begins with clarity, trust and accountability, and with an understanding of what people and organisations need in a specific situation." : "Führung mit klaren Erwartungen, echtem Handlungsspielraum und hohem Anspruch an Ergebnisse. Aus der Führung einer Digitalorganisation mit mehr als 100 Mitarbeitenden."}
>
  <article class="leadership-landing">
    {isEnglish ? (
      <div class="leadership-intro">
        <header class="landing-hero">
          <div class="hero-eyebrow">Leadership & Transformation</div>
          <h1>Leadership takes both principles and practice.</h1>
          <p class="hero-copy">For me, leadership begins with clarity, trust and accountability, and with an understanding of what people and organisations need in a specific situation. Good leadership provides direction, creates room for decisions, brings different perspectives together and enables people to act independently. My principle: understand first, then act.</p>
          <div class="communication-principle">
            <h2>Turn complexity into clarity.</h2>
            <p>In complex organisations, I see it as part of leadership to distil complex relationships so that direction emerges and decisions become possible. This does not mean oversimplifying complexity, but making what matters visible.</p>
          </div>
        </header>

        <EditorialImage
          class="leadership-context"
          src="/images/karsten-uhlig-leadership-stage.png"
          alt="Karsten Uhlig speaking on stage"
          width={1536}
          height={1024}
        />
      </div>
    ) : (
      <>
        <div class="leadership-intro">
          <header class="landing-hero">
            <div class="hero-eyebrow">Leadership & Transformation</div>
            <h1>Führung braucht Haltung und Handwerk.</h1>
            <p class="hero-copy">Für mich beginnt Führung mit Klarheit über Ziele, Erwartungen und Verantwortung. Dazu gehören verlässliche Entscheidungsräume, hohe Ansprüche an Ergebnisse und ein Umgang, in dem unterschiedliche Perspektiven offen eingebracht werden können. Führung zeigt sich für mich darin, Entscheidungen nachvollziehbar zu machen, Verantwortung klar zu verankern und in der Umsetzung verbindlich zu bleiben.</p>
            <div class="communication-principle">
              <h2>Komplexität in Klarheit verwandeln.</h2>
              <p>In komplexen Organisationen gehört es für mich zu Führung, Zusammenhänge so zu verdichten, dass Entscheidungen möglich werden. Oft heißt das ganz konkret, eine unübersichtliche Lage auf eine Seite zu bringen: Ausgangslage, Optionen, Empfehlung und nächste Schritte.</p>
            </div>
          </header>

          <EditorialImage
            class="leadership-context"
            src="/images/karsten-uhlig-leadership-stage.png"
            alt="Karsten Uhlig bei einem Vortrag"
            width={1536}
            height={1024}
          />
        </div>

        <section class="practice-evidence" aria-labelledby="practice-evidence-title">
          <h2 id="practice-evidence-title">Aus der Praxis</h2>
          <div class="practice-evidence-list">
            <div class="practice-evidence-item">
              <h3>100+ Mitarbeitende · 8 Führungskräfte · 20+ Teams</h3>
              <p>Führung über mehrere Ebenen in einer internationalen Digitalorganisation.</p>
            </div>
            <div class="practice-evidence-item">
              <h3>Produktorganisation</h3>
              <p>Crossfunktionale Teams mit End-to-End-Verantwortung aufgebaut und gemeinsame Priorisierung über Product, Tech, Data und Business etabliert.</p>
            </div>
            <div class="practice-evidence-item">
              <h3>Internationale Matrix · 20+ Märkte</h3>
              <p>Prioritäten und digitale Initiativen gemeinsam mit Markt- und Funktionsverantwortlichen gesteuert.</p>
            </div>
          </div>
        </section>

        <section class="featured-proof" aria-labelledby="featured-proof-title">
          <a class="featured-proof-link" href="/transformation/product-organisation">
            <div class="featured-proof-copy">
              <div class="featured-proof-eyebrow">Leadership Case</div>
              <h2 id="featured-proof-title">Von Projekten zu Produktteams mit Ergebnisverantwortung</h2>
              <p>Eine internationale E-Commerce-Organisation zu crossfunktionalen Produktteams mit klarer End-to-End-Verantwortung weiterentwickelt.</p>
              <span class="featured-proof-cta">Transformation Case ansehen <span aria-hidden="true">→</span></span>
            </div>
            <figure class="featured-proof-visual">
              <img
                src="/images/homepage/06-product-organisation-transformation.png"
                alt="Transformation von funktionalen Projekten zu crossfunktionalen Produktteams"
                width="1254"
                height="1254"
                loading="lazy"
                decoding="async"
              />
            </figure>
          </a>
        </section>
      </>
    )}

    <LeadershipFieldExplorer language={language} />
  </article>
</SubPageLayout>

<style>
  .leadership-landing { min-width: 0; }
  .leadership-intro { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(300px, 1fr); gap: clamp(2.5rem, 4vw, 4rem); align-items: start; padding: 2rem 0 4rem; border-bottom: 1px solid var(--color-border-soft); }
  .landing-hero { min-width: 0; }
  .hero-eyebrow { display: flex; gap: .85rem; align-items: center; margin-bottom: 1.1rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .hero-eyebrow::before { content: ""; width: 2.25rem; height: 2px; flex: 0 0 auto; background: var(--color-amber); }
  h1 { max-width: 720px; margin: 0; color: var(--color-ink); font-size: clamp(46px, 5.2vw, 64px); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  .hero-copy { max-width: 640px; margin: 1.35rem 0 0; color: var(--color-body); font-size: 15.5px; line-height: 1.72; }
  .practice-evidence { padding: 2.7rem 0 3rem; border-bottom: 1px solid var(--color-border-soft); }
  .practice-evidence > h2 { margin: 0 0 1.65rem; color: var(--color-ink); font-size: 25px; font-weight: 500; letter-spacing: -.025em; line-height: 1.25; }
  .practice-evidence-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--color-border-soft); border-bottom: 1px solid var(--color-border-soft); }
  .practice-evidence-item { min-width: 0; padding: 1.35rem 1.5rem 1.45rem; }
  .practice-evidence-item:first-child { padding-left: 0; }
  .practice-evidence-item + .practice-evidence-item { border-left: 1px solid var(--color-border-soft); }
  .practice-evidence-item h3 { margin: 0; color: var(--color-ink); font-size: 15px; font-weight: 600; letter-spacing: -.01em; line-height: 1.4; }
  .practice-evidence-item p { margin: .55rem 0 0; color: var(--color-body); font-size: 14px; line-height: 1.62; }
  .featured-proof { padding: 2rem 0; }
  .featured-proof-link { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(220px, .65fr); gap: clamp(1.5rem, 3vw, 3rem); align-items: center; min-width: 0; padding: clamp(1.35rem, 2vw, 1.75rem); color: inherit; text-decoration: none; background: rgba(255,255,255,.62); border: 1px solid var(--color-border-soft); border-top: 2px solid var(--color-amber); }
  .featured-proof-link:focus-visible { outline: 2px solid var(--color-amber); outline-offset: 4px; }
  .featured-proof-copy { min-width: 0; }
  .featured-proof-eyebrow { margin-bottom: .65rem; color: var(--color-amber); font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .featured-proof h2 { max-width: 720px; margin: 0; color: var(--color-ink); font-size: clamp(28px, 3.2vw, 40px); font-weight: 500; letter-spacing: -.035em; line-height: 1.08; }
  .featured-proof-copy > p { max-width: 680px; margin: .75rem 0 0; color: var(--color-body); font-size: 15px; line-height: 1.7; }
  .featured-proof-cta { display: inline-flex; gap: .45rem; align-items: center; margin-top: 1rem; padding-bottom: .25rem; color: var(--color-amber); font-size: 13px; font-weight: 600; border-bottom: 1px solid rgba(180,83,9,.38); }
  .featured-proof-visual { width: min(100%, 260px); min-width: 0; margin: 0; justify-self: end; }
  .featured-proof-visual img { display: block; width: 100%; height: auto; }
  :global(.leadership-context) { --editorial-image-margin: 0; width: 100%; max-width: 400px; justify-self: end; }
  :global(.leadership-context .editorial-image__media) { aspect-ratio: 4 / 5; }
  :global(.leadership-context img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 57% center;
    filter: saturate(.82) contrast(.96) brightness(.98);
  }
  .communication-principle { max-width: 640px; margin-top: 2.15rem; }
  .communication-principle h2 { margin: 0; color: var(--color-ink); font-size: 21px; font-weight: 500; letter-spacing: -.02em; line-height: 1.25; }
  .communication-principle p { margin: .65rem 0 0; color: var(--color-body); font-size: 15px; line-height: 1.68; }
  .leadership-intro + :global(.field-section) { padding-top: 4rem; }

  @media (max-width: 900px) {
    .leadership-intro { grid-template-columns: 1fr; gap: 2rem; padding: 1rem 0 3rem; }
    :global(.leadership-context) { width: min(100%, 520px); max-width: none; justify-self: start; }
    :global(.leadership-context .editorial-image__media) { aspect-ratio: 5 / 4; }
    .featured-proof-link { grid-template-columns: minmax(0, 1fr) minmax(220px, .58fr); gap: 2rem; }
  }

  @media (max-width: 760px) {
    h1 { font-size: 42px; }
    .hero-copy { font-size: 15px; }
    .practice-evidence { padding: 2.35rem 0 2.6rem; }
    .practice-evidence > h2 { font-size: 23px; }
    .practice-evidence-list { grid-template-columns: 1fr; }
    .practice-evidence-item { padding: 1.15rem 0 1.25rem; }
    .practice-evidence-item + .practice-evidence-item { border-top: 1px solid var(--color-border-soft); border-left: 0; }
    .featured-proof { padding: 1.75rem 0; }
    .featured-proof-link { grid-template-columns: 1fr; gap: 1rem; padding: 1.2rem; }
    .featured-proof h2 { font-size: 28px; }
    .featured-proof-copy > p { font-size: 14.5px; }
    .featured-proof-visual { width: min(100%, 280px); justify-self: start; }
    .communication-principle h2 { font-size: 20px; }
    .leadership-intro + :global(.field-section) { padding-top: 3.5rem; }
  }

  @media (max-width: 430px) { h1 { font-size: 38px; } }
</style>
