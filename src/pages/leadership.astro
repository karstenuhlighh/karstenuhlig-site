---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import LeadershipFieldExplorer from "../components/LeadershipFieldExplorer.astro";
import EditorialImage from "../components/EditorialImage.astro";
import { getLanguage } from "../i18n/routes";

const language = getLanguage(Astro.url.pathname);
const isEnglish = language === "en";
---

<SubPageLayout
  language={language}
  title="Leadership & Transformation | Karsten Uhlig"
  description={isEnglish ? "Leadership as a discipline of diagnosis and decision-making: seven recurring leadership problems and the models I use to address them." : "Leadership als Diagnose- und Entscheidungshandwerk: sieben wiederkehrende Führungsprobleme und die Modelle, mit denen ich sie löse."}
>
  <article class="leadership-landing">
    <header class="landing-hero">
      <div class="hero-eyebrow">Leadership & Transformation</div>
      <h1>Leadership & Transformation</h1>
      <p class="hero-subheadline">{isEnglish ? "Turning strategy into organisation and execution." : "Strategie in Organisation und Umsetzung übersetzen."}</p>
      <p class="hero-copy">{isEnglish ? "For me, leadership is not reducible to style or intuition. Leadership shows up in recurring situations: clarifying accountability, developing performance, resolving conflicts, enabling decisions and getting change moving. That requires diagnosis before intervention. Understand the actual cause first, then choose the appropriate leadership instrument." : "Führung reduziert sich für mich nicht auf Stil oder Intuition. Führung zeigt sich in wiederkehrenden Situationen: Verantwortung klären, Performance entwickeln, Konflikte lösen, Entscheidungen ermöglichen und Veränderung in Bewegung bringen. Dafür braucht es Diagnose vor Intervention. Erst die tatsächliche Ursache verstehen, dann das passende Führungsinstrument wählen."}</p>
    </header>

    <EditorialImage
      class="leadership-context"
      src="/images/karsten-uhlig-leadership-stage.png"
      alt={isEnglish ? "Karsten Uhlig speaking on stage" : "Karsten Uhlig bei einem Vortrag"}
      width={1672}
      height={941}
    />

    <LeadershipFieldExplorer language={language} />
  </article>
</SubPageLayout>

<style>
  .leadership-landing { min-width: 0; }
  .landing-hero { padding: 2.25rem 0 5.75rem; }
  .hero-eyebrow { margin-bottom: 1rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  h1 { max-width: 900px; margin: 0; color: var(--color-ink); font-size: clamp(46px, 7vw, 82px); font-weight: 500; letter-spacing: -.055em; line-height: .98; }
  .hero-subheadline { max-width: 860px; margin: 1.55rem 0 0; color: var(--color-ink); font-size: clamp(22px, 2.7vw, 34px); font-weight: 400; letter-spacing: -.025em; line-height: 1.25; }
  .hero-copy { max-width: 810px; margin: 1.55rem 0 0; color: var(--color-body); font-size: 16px; line-height: 1.8; }
  :global(.leadership-context) { --editorial-image-margin: 0 auto 2rem 0; width: min(76%, 860px); }
  :global(.leadership-context) + :global(.field-section) { padding-top: 3.75rem; }

  @media (max-width: 760px) {
    .landing-hero { padding: 1rem 0 3.25rem; }
    h1 { font-size: 48px; }
    .hero-subheadline { font-size: 24px; }
    .hero-copy { font-size: 15px; }
    :global(.leadership-context) { --editorial-image-margin: 0 0 1.5rem; width: 100%; }
    :global(.leadership-context) + :global(.field-section) { padding-top: 3rem; }
  }

  @media (max-width: 430px) { h1 { font-size: 41px; } }
</style>
