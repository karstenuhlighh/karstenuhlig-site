---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import PageHeader from "../components/PageHeader.astro";

const enablers = [
  {
    title: "Leadership & Transformation",
    href: "/e-commerce-marketing/organisatorische-schwerkraft",
    intro:
      "Strategie in Organisation und Umsetzung übersetzen.",
    linkLabel: "Praxis zur Transformation",
  },
  {
    title: "Data, AI & Digital Product",
    href: "/agentic-ai/sem-agentic",
    intro:
      "Digitale Fähigkeiten gezielt für wirtschaftliche Wirkung einsetzen. Agentic AI ist dabei ein aktueller Praxis- und Entwicklungsbereich.",
    linkLabel: "Aktueller Praxistest",
  },
];
---

<SubPageLayout
  title="Schwerpunkte | Karsten Uhlig"
  description="Commercial Management / Digital Commerce als Kern, unterstützt durch Leadership & Transformation sowie Data, AI & Digital Product."
>
  <PageHeader
    eyebrow="Übersicht"
    headline="Schwerpunkte"
    intro="Commercial Management / Digital Commerce ist der Kern. Leadership & Transformation sowie Data, AI & Digital Product unterstützen die wirtschaftliche Wirkung als Enabler."
  />

  <section class="sp-grid">
    <div class="sp-meta">Kern</div>
    <a href="/#commercial-management" class="sp-card">
      <h2 class="sp-title">Commercial Management / Digital Commerce</h2>
      <p class="sp-intro">
        Digitale Geschäfte wirtschaftlich steuern und skalieren. Wachstum,
        Kundenbasis, Customer Journey, Commercial Economics und knappe Ressourcen
        gehören in ein zusammenhängendes Managementsystem.
      </p>
      <div class="sp-meta">Commercial Management ansehen &rarr;</div>
    </a>

    <h2 class="sp-meta">Enabler</h2>
    {
      enablers.map((enabler) => (
        <a href={enabler.href} class="sp-card">
          <h3 class="sp-title">{enabler.title}</h3>
          <p class="sp-intro">{enabler.intro}</p>
          <div class="sp-meta">{enabler.linkLabel} &rarr;</div>
        </a>
      ))
    }
  </section>
</SubPageLayout>

<style>
  .sp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 760px;
  }
  .sp-card {
    display: block;
    background: rgba(255, 255, 255, 0.55);
    border: 1px solid var(--color-border-soft);
    border-radius: 3px;
    padding: 1.75rem;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }
  .sp-card:hover {
    border-color: rgba(180, 83, 9, 0.45);
    background: rgba(255, 255, 255, 0.75);
    transform: translateY(-2px);
  }
  .sp-title {
    font-size: 22px;
    font-weight: 500;
    color: var(--color-ink);
    letter-spacing: -0.015em;
    margin-bottom: 0.6rem;
  }
  .sp-intro {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-ink-2);
    margin: 0 0 1.1rem;
  }
  .sp-meta {
    font-size: 11px;
    color: var(--color-amber);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }
</style>
