---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";

// Bespoke native web modules; the source visual is a design reference only.
---

<Layout
  title="Performance Marketing Steering | Karsten Uhlig"
  description="Wirkung messen, Budgets steuern und Plattformen intelligent führen: Performance Marketing als integriertes Steuerungssystem."
>
  <section class="performance-shell">
    <div class="performance-inner">
      <Nav homepage />
      <article class="performance-page">
    <svg class="icon-sprite" aria-hidden="true">
      <symbol id="icon-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.5"/><path d="m15 15 5 5"/></symbol>
      <symbol id="icon-sliders" viewBox="0 0 24 24"><path d="M5 3v18M12 3v18M19 3v18"/><path d="M2.5 8h5M9.5 15h5M16.5 10h5"/><circle cx="5" cy="8" r="1.8"/><circle cx="12" cy="15" r="1.8"/><circle cx="19" cy="10" r="1.8"/></symbol>
      <symbol id="icon-megaphone" viewBox="0 0 24 24"><path d="M4 11v4h4l8 4V7l-8 4H4Z"/><path d="m8 15 1 5h3M19 9l2-2M19 16l2 2"/></symbol>
      <symbol id="icon-bars" viewBox="0 0 24 24"><path d="M4 19h4v-6H4v6Zm6 0h4V8h-4v11Zm6 0h4V4h-4v15Z"/></symbol>
      <symbol id="icon-target" viewBox="0 0 24 24"><circle cx="11" cy="13" r="8"/><circle cx="11" cy="13" r="4"/><path d="m11 13 8-8M16 5h3V2M19 5h3"/></symbol>
      <symbol id="icon-database" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="7" ry="3"/><path d="M5 5v6c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 11v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/></symbol>
      <symbol id="icon-people" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c.5-4 2.5-6 6-6s5.5 2 6 6M14 14.5c3.8-.7 6.2 1.1 7 4.5"/></symbol>
      <symbol id="icon-flask" viewBox="0 0 24 24"><path d="M9 3h6M10 3v6l-6 10c-.5 1 .2 2 1.4 2h13.2c1.2 0 1.9-1 1.4-2L14 9V3"/><path d="M7 15h10"/></symbol>
      <symbol id="icon-nodes" viewBox="0 0 24 24"><circle cx="12" cy="5" r="3"/><circle cx="5" cy="18" r="3"/><circle cx="19" cy="18" r="3"/><path d="m10.5 7.6-4 7.8M13.5 7.6l4 7.8M8 18h8"/></symbol>
      <symbol id="icon-feedback" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M18.3 16a8 8 0 0 1-13.5-1M5.7 8a8 8 0 0 1 13.5 1"/></symbol>
    </svg>
    <header class="performance-hero">
      <div class="hero-copy">
        <p class="eyebrow">Performance Marketing · Measurement · AI</p>
        <h1>Performance Marketing Steering</h1>
        <p class="hero-lead">Wirkung messen. Budgets steuern. Plattformen intelligent führen.</p>
        <p class="hero-body">
          Plattformen automatisieren immer größere Teile der Kampagnenausführung. Gleichzeitig wird es schwieriger,
          attribuierten Umsatz von tatsächlicher Wirkung zu unterscheiden.
        </p>
        <p class="hero-body">
          Moderne Performance-Steuerung verbindet <strong>Business-Ziele, Value Signals, Measurement und
          AI-gestützte Entscheidungen.</strong>
        </p>
      </div>
      <div class="hero-capabilities" aria-label="Themenschwerpunkte">
        <span>Google Ads</span><span>Smart Bidding</span><span>Incrementality</span><span>MMM</span><span>CAC/LTV</span><span>Agentic AI</span>
      </div>
    </header>

    <section class="page-section shift-section" aria-labelledby="shift-title">
      <div class="section-intro">
        <p class="section-label">01 · Shift</p>
        <h2 id="shift-title">Der Steuerungshebel verschiebt sich.</h2>
        <p>Von der manuellen Kampagnensteuerung zur strategischen, datenbasierten Steuerung von Wirkung, Wert und Wachstum.</p>
      </div>

      <figure class="shift-visual">
        <img
          src="/images/performance-marketing-steering/01-shift.png"
          alt="Der Shift von operativer Kampagnensteuerung mit Keywords, Bids, Campaigns und Channel KPIs zu moderner Steuerung über Business Targets, Value Signals, Measurement und Decision Rights."
          width="2172"
          height="724"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <p class="key-message"><span aria-hidden="true"></span>Je autonomer die Ausführung wird, desto wichtiger werden Zielsystem, Measurement und Entscheidungsrechte.</p>
    </section>

    <section class="page-section steering-section" aria-labelledby="steering-title">
      <div class="section-intro">
        <p class="section-label">02 · Steering Model</p>
        <h2 id="steering-title">Vier Ebenen moderner Performance-Steuerung.</h2>
      </div>

      <div class="steering-composition">
        <aside class="steering-context">
          <p>Nachhaltige Wirkung entsteht aus dem Zusammenspiel von Business, Daten, Plattformen und kontinuierlichem Lernen.</p>
          <span aria-hidden="true"></span>
          <p>Ein integriertes Modell für bessere Entscheidungen und mehr Wachstum.</p>
        </aside>

        <figure class="steering-visual">
          <img
            src="/images/performance-marketing-steering/02-steering-model.png"
            alt="Vier Ebenen moderner Performance-Steuerung: Business Economics, Signals und Measurement, Platform Steering sowie Learning und Control – verbunden mit Wert schaffen, Steuerung integrieren und Wirkung skalieren."
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="page-section measurement-section" aria-labelledby="measurement-title">
      <div class="section-intro">
        <p class="section-label">03 · Measurement</p>
        <h2 id="measurement-title">Von Attribution zu Budgetentscheidungen.</h2>
        <p>Unterschiedliche Messmethoden beantworten unterschiedliche Fragen. Entscheidend ist, sie in eine gemeinsame Steuerungslogik zu übersetzen.</p>
      </div>

      <figure class="measurement-visual">
        <img
          src="/images/performance-marketing-steering/03-measurement.png"
          alt="Attribution, Incrementality und Marketing Mix Modeling fließen in eine gemeinsame Decision Logic für die Budget Allocation ein."
          width="1672"
          height="941"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <p class="key-message"><span aria-hidden="true"></span>Nicht eine Kennzahl entscheidet – sondern die passende Messmethode für die jeweilige Entscheidung.</p>
    </section>

    <section class="page-section platform-section" aria-labelledby="platform-title">
      <div class="platform-grid">
        <div class="section-intro platform-copy">
          <p class="section-label">04 · Platform Steering</p>
          <h2 id="platform-title">Google Ads zeigt, wohin sich Steuerung entwickelt.</h2>
          <p>Wenn Bidding, Matching und Teile der Kampagnenausführung zunehmend automatisiert werden, gewinnen die Inputs in das System an Bedeutung.</p>
          <div class="topic-line"><span>Google Ads</span><span>Smart Bidding</span><span>tROAS</span><span>Value Signals</span></div>
        </div>

        <figure class="platform-visual">
          <img
            src="/images/performance-marketing-steering/04-platform-steering.png"
            alt="Google Ads Feedback Loop mit Business Target, Value Signals, Measurement und Feedback rund um Google Ads als zentrale Ausführungsplattform."
            width="1448"
            height="1086"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <aside class="platform-aside"><span aria-hidden="true"></span><p>Je mehr die Plattform selbst optimiert, desto wichtiger wird die Qualität dessen, worauf und womit sie optimiert.</p></aside>
      </div>
      <p class="key-message platform-message">Die Plattform optimiert die Ausführung. Den Unterschied macht die Qualität der Inputs – und wie wir sie nutzen.</p>
    </section>

    <section class="page-section capability-section" aria-labelledby="capability-title">
      <div class="section-intro">
        <p class="section-label">05 · Capability</p>
        <h2 id="capability-title">Erfahrung. Aktuelle Vertiefung. Eigene Praxis.</h2>
        <p>Drei unterschiedliche Evidenzebenen – bewusst getrennt.</p>
      </div>

      <div class="capability-levels">
        <article class="capability-level track-record-level">
          <p class="visual-label">Track Record</p><h3>Data-driven Commercial Steering</h3>
          <p>Langjährige Erfahrung mit internationalem Digital Commerce, Digital Marketing, Tracking und Attribution, Customer Data, CRM sowie produktiven Analytics- und ML-Anwendungen.</p>
          <span>Commercial Steering · Data &amp; Analytics · Attribution · CRM · Personalization · ML</span>
        </article>
        <article class="capability-level current-focus-level">
          <p class="visual-label">Current Focus</p><h3>Modern Performance Measurement</h3>
          <p>Aktuelle Vertiefung von Value-based Bidding, Incrementality, Marketing Mix Modeling und marginaler Budgetallokation. Im Mittelpunkt steht die Übersetzung in bessere kommerzielle Entscheidungen.</p>
          <span>Smart Bidding · CAC/LTV · Incrementality · MMM · mROI</span>
        </article>
        <article class="capability-level practice-level">
          <p class="visual-label">Practice</p><h3>Agentic Decisioning</h3>
          <p>Eigene Prototypen untersuchen, wie AI Analyse, Entscheidungsunterstützung und Steuerung im Performance Marketing verändern kann.</p>
          <span>Agents · Decision Support · Validation · Guardrails</span>
        </article>
      </div>
    </section>

    <section class="page-section proof-section" aria-labelledby="proof-title">
      <div class="section-intro">
        <p class="section-label">06 · Practice &amp; Proof</p>
        <h2 id="proof-title">Zwei Praxistests.</h2>
      </div>
      <div class="proof-grid">
        <a class="proof-panel" href="/agentic-ai/sem-agentic">
          <span class="proof-kicker">sem-agentic</span><h3>Agentic AI für SEM</h3>
          <p>Wie können spezialisierte Agents Research, Performance-Analyse und Optimierungsempfehlungen im SEM unterstützen und zu nachvollziehbaren Entscheidungen verdichten?</p>
          <span class="proof-topics">Google SEM · Agentic AI · Validation · Human Control</span>
          <span class="proof-evidence"><strong>Der Pilot zeigt</strong>Agentenarchitektur · spezialisierte Analyse · Koordination · Validierung</span>
          <span class="proof-link">Praxistest ansehen <b aria-hidden="true">→</b></span>
        </a>
        <a class="proof-panel" href="/agentic-ai/signal-steering">
          <span class="proof-kicker">signal-steering</span><h3>Measurement zu einer Entscheidung verbinden</h3>
          <p>Wie lassen sich Attribution, Geo-Incrementality und Marketing Mix Modeling als unterschiedliche Signale auf dieselbe Marketingwirkung anwenden?</p>
          <span class="proof-topics">Attribution · Incrementality · MMM · Budget Steering</span>
          <span class="proof-evidence"><strong>Der Pilot zeigt</strong>Methodische Triangulation · prototypische Decision Logic · Measurement</span>
          <span class="proof-link">Praxistest ansehen <b aria-hidden="true">→</b></span>
        </a>
      </div>
    </section>

    <section class="page-section executive-section" aria-labelledby="executive-title">
      <div class="section-intro">
        <p class="section-label">07 · Executive View</p>
        <h2 id="executive-title">Performance Marketing als Steuerungssystem.</h2>
        <p>Die nächste Generation von Performance Marketing entsteht nicht durch ein einzelnes Tool oder Modell.</p>
      </div>
      <div class="executive-chain" aria-label="Steuerungssystem von Business Value bis Learning">
        <span>Business Value</span><b aria-hidden="true">→</b><span>Signals</span><b aria-hidden="true">→</b><span>Measurement</span><b aria-hidden="true">→</b><span>Decision</span><b aria-hidden="true">→</b><span>Activation</span><b aria-hidden="true">→</b><span>Learning</span>
      </div>
      <blockquote>Die Führungsaufgabe verschiebt sich von der Optimierung einzelner Kanäle hin zur Gestaltung eines Systems, das Wirkung misst, Ressourcen allokiert, kontinuierlich lernt und Automation kontrolliert einsetzt.</blockquote>
    </section>
      </article>
    </div>
  </section>
</Layout>

<style>
  :global(body) { background: #eef2f7; }
  .performance-shell { position: relative; width: 100%; overflow: hidden; background: radial-gradient(circle at 86% 8rem, rgba(255,255,255,.78) 0, rgba(255,255,255,0) 30rem), linear-gradient(180deg, #eef2f7 0, #dce7f1 54rem, #eef2f7 108rem, #eef2f7 100%); }
  .performance-inner { position: relative; max-width: 1440px; margin: 0 auto; padding: 1.25rem 4.25rem 5rem; }
  .performance-page { --surface: rgba(255,255,255,.38); --surface-strong: rgba(255,255,255,.56); min-width: 0; color: var(--color-ink); }
  .icon-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  .performance-page :where(h1,h2,h3,p,ul,blockquote) { margin-top: 0; }
  .performance-hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(270px, .55fr); gap: clamp(2rem, 6vw, 7rem); align-items: end; padding: 1.4rem 0 6rem; }
  .eyebrow, .section-label, .visual-label, .proof-kicker { color: var(--color-amber); font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
  .eyebrow { margin-bottom: 1.2rem; }
  h1 { max-width: 900px; margin-bottom: 1.45rem; font-size: clamp(46px, 4.6vw, 62px); font-weight: 500; letter-spacing: -.05em; line-height: .98; }
  .hero-lead { max-width: 760px; margin-bottom: 1.35rem; font-size: clamp(22px, 2.35vw, 31px); letter-spacing: -.025em; line-height: 1.24; }
  .hero-body { max-width: 760px; margin-bottom: .55rem; color: var(--color-body); font-size: 16px; line-height: 1.75; }
  .hero-body strong { color: var(--color-ink); font-weight: 500; }
  .hero-capabilities { display: flex; flex-wrap: wrap; gap: .8rem 1.2rem; align-content: end; padding-bottom: .4rem; color: var(--color-ink-2); font-size: 12px; line-height: 1.5; }
  .hero-capabilities span::before { display: inline-block; width: 3px; height: 3px; margin-right: .55rem; vertical-align: .2em; background: var(--color-amber); border-radius: 50%; content: ""; }

  .page-section { position: relative; padding: 5.5rem 0; border-top: 1px solid var(--color-border); }
  .section-intro { max-width: 900px; margin-bottom: 3rem; }
  .section-label { margin-bottom: .8rem; }
  .section-intro h2 { margin-bottom: .8rem; overflow-wrap: anywhere; font-size: clamp(32px, 3.7vw, 48px); font-weight: 500; letter-spacing: -.045em; line-height: 1.06; }
  .section-intro > p:last-child:not(.section-label) { max-width: 680px; margin-bottom: 0; color: var(--color-body); font-size: 16px; line-height: 1.65; }
  .key-message { display: flex; gap: 1rem; align-items: flex-start; margin: 2.4rem 0 0; padding-top: 1.2rem; color: var(--color-ink); font-size: clamp(15px, 1.7vw, 18px); line-height: 1.55; border-top: 1px solid var(--color-border); }
  .key-message > span { flex: 0 0 28px; height: 2px; margin-top: .75em; background: var(--color-amber); }

  .visual-label { margin-bottom: .6rem; color: var(--color-ink-2); }
  .shift-visual { position: relative; margin: 0; overflow: hidden; aspect-ratio: 2172 / 611; }
  .shift-visual img { position: absolute; top: -10.97%; left: 0; display: block; width: 100%; max-width: none; height: auto; }

  .steering-section { background: rgba(255,255,255,.16); }
  .steering-composition { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 2rem; align-items: center; }
  .steering-context { color: var(--color-body); font-size: 14px; line-height: 1.55; }
  .steering-context span { display: block; width: 28px; height: 2px; margin: 2.1rem 0 1rem; background: var(--color-amber); }
  .steering-visual { position: relative; min-width: 0; margin: 0; overflow: hidden; aspect-ratio: 1672 / 647; }
  .steering-visual img { position: absolute; top: -25.04%; left: 0; display: block; width: 100%; max-width: none; height: auto; }

  .measurement-visual { position: relative; margin: 0; overflow: hidden; aspect-ratio: 1672 / 492; }
  .measurement-visual img { position: absolute; top: -48.98%; left: 0; display: block; width: 100%; max-width: none; height: auto; }

  .platform-grid { display: grid; grid-template-columns: minmax(260px, .85fr) minmax(480px, 1.65fr) 135px; gap: 2rem; align-items: center; }
  .platform-copy { margin-bottom: 0; }
  .platform-copy h2 { font-size: clamp(32px, 3vw, 40px); }
  .topic-line { display: flex; flex-wrap: wrap; gap: .65rem 1.2rem; margin-top: 2rem; color: var(--color-ink-2); font-size: 11px; }
  .platform-visual { min-width: 0; margin: 0; }
  .platform-visual img { display: block; width: 100%; height: auto; }
  .platform-aside { display: grid; gap: 1rem; color: var(--color-body); font-size: 13px; line-height: 1.55; }
  .platform-aside span { width: 28px; height: 2px; background: var(--color-amber); }
  .platform-message { margin-top: 2rem; }

  .capability-levels { display: grid; gap: .85rem; }
  .capability-level { display: grid; grid-template-columns: 130px minmax(230px, .7fr) minmax(300px, 1.2fr); gap: 1.6rem; align-items: center; padding: 1.6rem 2rem; border: 1px solid var(--color-border-soft); }
  .capability-level h3 { margin: 0; font-size: clamp(21px, 2.3vw, 29px); font-weight: 500; letter-spacing: -.03em; line-height: 1.15; }
  .capability-level > p:nth-of-type(2) { margin: 0; color: var(--color-body); font-size: 13px; line-height: 1.6; }
  .capability-level > span { grid-column: 2 / -1; color: var(--color-ink-2); font-size: 11px; letter-spacing: .02em; }
  .track-record-level { margin-right: 0; background: rgba(255,255,255,.5); border-left: 3px solid var(--color-ink-2); }
  .current-focus-level { margin-left: 6%; margin-right: 4%; background: rgba(238,242,247,.44); border-left: 2px solid #91afcb; }
  .practice-level { margin-left: 12%; margin-right: 8%; background: rgba(255,255,255,.3); border-left: 2px solid var(--color-amber); }

  .proof-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .proof-panel { display: flex; min-height: 430px; flex-direction: column; padding: 2.1rem; color: var(--color-ink); text-decoration: none; background: rgba(255,255,255,.38); border: 1px solid var(--color-border-soft); border-top: 2px solid var(--color-ink-2); transition: background .2s ease; }
  .proof-panel:hover { background: rgba(255,255,255,.58); }
  .proof-panel:focus-visible { outline: 3px solid rgba(180,83,9,.45); outline-offset: 4px; }
  .proof-panel h3 { max-width: 430px; margin: .9rem 0 1.1rem; font-size: clamp(26px, 3vw, 36px); font-weight: 500; letter-spacing: -.035em; line-height: 1.12; }
  .proof-panel p { max-width: 520px; color: var(--color-body); font-size: 14px; line-height: 1.7; }
  .proof-topics { display: block; margin-top: .8rem; color: var(--color-ink-2); font-size: 11px; }
  .proof-evidence { display: grid; gap: .3rem; margin-top: 2rem; padding-top: 1.2rem; color: var(--color-body); font-size: 12px; line-height: 1.55; border-top: 1px solid var(--color-border-soft); }
  .proof-evidence strong { color: var(--color-ink); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; }
  .proof-link { display: flex; gap: .5rem; align-items: center; margin-top: auto; padding-top: 1.5rem; color: var(--color-amber); font-size: 13px; font-weight: 500; }
  .proof-link b { font-size: 18px; font-weight: 400; }

  .executive-section { padding-bottom: 3rem; }
  .executive-chain { display: flex; gap: 1rem; align-items: center; justify-content: space-between; padding: 1.6rem 0; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .executive-chain span { color: var(--color-ink-2); font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .executive-chain b { color: var(--color-amber); font-size: 20px; font-weight: 400; }
  .executive-section blockquote { max-width: 980px; margin: 3rem 0 0; padding-left: 2rem; font-size: clamp(20px, 2vw, 28px); font-weight: 400; letter-spacing: -.03em; line-height: 1.3; border-left: 3px solid var(--color-amber); }

  @media (max-width: 1050px) {
    .steering-composition { grid-template-columns: 150px minmax(0, 1fr); }
    .platform-grid { grid-template-columns: minmax(240px, .8fr) minmax(460px, 1.5fr); }
    .platform-aside { display: none; }
  }

  @media (max-width: 820px) {
    .performance-inner { padding-inline: 2.5rem; }
    .performance-hero { grid-template-columns: 1fr; gap: 2.2rem; padding-bottom: 5rem; }
    .page-section { padding: 4rem 0; }
    .steering-composition { grid-template-columns: 1fr; }
    .steering-context { display: grid; grid-template-columns: 1fr 28px 1fr; gap: 1rem; align-items: center; }
    .steering-context span { margin: 0; }
    .platform-grid { grid-template-columns: 1fr; }
    .platform-visual { max-width: 620px; width: 100%; justify-self: center; }
    .capability-level { grid-template-columns: 110px 1fr; }
    .capability-level > p:nth-of-type(2), .capability-level > span { grid-column: 2; }
  }

  @media (max-width: 640px) {
    .performance-shell { background: radial-gradient(circle at 88% 6rem, rgba(255,255,255,.72) 0, rgba(255,255,255,0) 20rem), linear-gradient(180deg, #d6e1ed 0, #eef2f7 74rem, #eef2f7 100%); }
    .performance-inner { padding: 2rem 1.5rem 3rem; }
    h1 { font-size: 46px; }
    .section-intro { margin-bottom: 2rem; }
    .section-intro h2 { font-size: 35px; }
    .steering-context { grid-template-columns: 1fr; }
    .steering-context span { margin: .4rem 0; }
    .capability-level { grid-template-columns: 1fr; gap: .75rem; padding: 1.35rem; }
    .capability-level > p:nth-of-type(2), .capability-level > span { grid-column: 1; }
    .current-focus-level, .practice-level { margin-inline: 0; }
    .proof-grid { grid-template-columns: 1fr; }
    .proof-panel { min-height: 380px; }
    .executive-chain { display: grid; grid-template-columns: 1fr; justify-items: center; }
    .executive-chain b { transform: rotate(90deg); }
    .executive-section blockquote { margin-top: 2.5rem; padding-left: 1.2rem; font-size: 21px; }
  }

  @media (prefers-reduced-motion: reduce) { .proof-panel { transition: none; } }
</style>
