---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import CommercialFieldExplorer from "../components/CommercialFieldExplorer.astro";
import CommercialSteeringModel from "../components/CommercialSteeringModel.astro";
import CommercialDeepDives from "../components/CommercialDeepDives.astro";
import CommercialManagementLoop from "../components/CommercialManagementLoop.astro";
import MarketOffers from "../components/MarketOffers.astro";

const landingTensions = [
  {
    title: "Wachstum verliert an Effizienz",
    body: "Mehr Aufwand führt nicht mehr proportional zu mehr Ergebnis.",
    relevant: "01 · 02 · 06",
  },
  {
    title: "Customer Journey und Kundenwert greifen nicht zusammen",
    body: "Kanäle optimieren lokal, aber nicht als gemeinsames wirtschaftliches System.",
    relevant: "03 · 04 · 06",
  },
  {
    title: "Prioritäten und Verantwortung zerfasern",
    body: "Zu viele Initiativen, zu wenig klare Steuerung.",
    relevant: "01 · 07 · 08",
  },
  {
    title: "Data, AI und Digital Products erzeugen Aktivität, aber zu wenig Ergebnis",
    body: "Es gibt Bewegung, aber keine harte wirtschaftliche Konsequenz.",
    relevant: "06 · 07 · 08",
  },
];
---

<SubPageLayout
  editorial
  title="Commercial Management | Karsten Uhlig"
  description="Commercial Management und Digital Commerce: Wachstum, Kundenwert und Profitabilität als zusammenhängendes System steuern."
>
  <article class="commercial-landing">
    <header class="landing-hero">
      <div class="hero-copy-column">
        <div class="hero-eyebrow">Commercial Management / Digital Commerce</div>
        <h1>Commercial Management</h1>
        <p class="hero-subheadline">Wachstum, Kundenwert und Profitabilität als zusammenhängendes System steuern.</p>
        <p class="hero-copy">Nachhaltiges Wachstum entsteht nicht aus einzelnen Kanälen oder Maßnahmen. Es hängt daran, wie Angebot, Nachfrage, Kundenbasis, Customer Journey, Märkte, Ressourcen und Organisation zusammenspielen. Commercial Management heißt für mich: diese Mechanik verstehen, Prioritäten ableiten und über Funktionsgrenzen hinweg ins Geschäft bringen.</p>
        <a class="hero-cta" href="#steuerungsmodell">Mein Ansatz im Überblick <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="hero-visual">
        <img
          src="/images/commercial-management/digital-commerce-steuerungsmodell-kompakt.png"
          alt="Kompaktes Steuerungsmodell: von der Realität über Commercial Management und seine Enabler zu Wachstum, Kundenwert, Profitabilität und Wettbewerbsfähigkeit."
          width="1448"
          height="1086"
        />
      </figure>
    </header>

    <CommercialFieldExplorer />
    <CommercialSteeringModel />
    <CommercialDeepDives />
    <CommercialManagementLoop
      title="Wie ich steuere"
      lead="Signale helfen nur, wenn daraus Entscheidungen werden. Und Entscheidungen zählen erst, wenn sie in der Umsetzung ankommen."
    />
    <MarketOffers tensions={landingTensions} />
  </article>
</SubPageLayout>

<style>
  .commercial-landing { min-width: 0; }
  .landing-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, .82fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding: 2rem 0 4rem;
    border-bottom: 1px solid var(--color-border-soft);
  }
  .hero-eyebrow { display: flex; gap: .85rem; align-items: center; margin-bottom: 1.1rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .hero-eyebrow::before { content: ""; width: 2.25rem; height: 2px; flex: 0 0 auto; background: var(--color-amber); }
  h1 { max-width: 560px; margin: 0; color: var(--color-ink); font-size: clamp(44px, 4.8vw, 64px); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  .hero-subheadline { max-width: 540px; margin: 1.35rem 0 0; color: var(--color-ink); font-size: clamp(21px, 2.2vw, 29px); font-weight: 500; letter-spacing: -.025em; line-height: 1.25; }
  .hero-copy { max-width: 535px; margin: 1.35rem 0 0; color: var(--color-body); font-size: 15px; line-height: 1.72; }
  .hero-cta { display: inline-flex; gap: .45rem; align-items: center; margin-top: 1.6rem; padding-bottom: .3rem; color: var(--color-amber); font-size: 13px; font-weight: 500; text-decoration: none; border-bottom: 1px solid rgba(180,83,9,.38); }
  .hero-cta:hover { border-bottom-color: var(--color-amber); }
  .hero-cta:focus-visible { outline: 3px solid rgba(180,83,9,.42); outline-offset: 4px; }
  .hero-visual { min-width: 0; margin: 0; }
  .hero-visual img { display: block; width: 100%; height: auto; max-height: 610px; object-fit: contain; object-position: center; }

  @media (max-width: 980px) {
    .landing-hero { grid-template-columns: 1fr; gap: 2.25rem; }
    .hero-copy-column { max-width: 720px; }
    .hero-visual { width: min(100%, 760px); margin: 0 auto; }
  }

  @media (max-width: 760px) {
    .landing-hero { gap: 1.75rem; padding: 1rem 0 3rem; }
    h1 { font-size: 42px; }
    .hero-subheadline { font-size: 23px; }
    .hero-copy { font-size: 15px; }
  }

  @media (max-width: 430px) {
    h1 { font-size: 38px; }
    :global(.commercial-landing .outcomes) { overflow-wrap: anywhere; }
  }
</style>
