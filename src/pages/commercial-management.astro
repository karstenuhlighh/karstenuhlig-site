---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import CommercialFieldExplorer from "../components/CommercialFieldExplorer.astro";
import CommercialSystemMap from "../components/CommercialSystemMap.astro";
import CommercialDeepDives from "../components/CommercialDeepDives.astro";
import CommercialManagementLoop from "../components/CommercialManagementLoop.astro";
import MarketOffers from "../components/MarketOffers.astro";
import CommercialEvidence from "../components/CommercialEvidence.astro";

const landingTensions = [
  {
    title: "Wachstum verliert an Effizienz",
    body: "Mehr Aufwand erzeugt nicht mehr proportional mehr Wirkung.",
    relevant: "01 · 02 · 06",
  },
  {
    title: "Customer Journey und Kundenwert greifen nicht zusammen",
    body: "Kanäle optimieren lokal, aber nicht als gemeinsames wirtschaftliches System.",
    relevant: "03 · 04 · 06",
  },
  {
    title: "Prioritäten und Verantwortung zerfasern",
    body: "Zu viele Initiativen, zu wenig klare Steuerung.",
    relevant: "01 · 07 · 08",
  },
  {
    title: "Data, AI und Digital Products erzeugen Aktivität, aber zu wenig kommerzielle Wirkung",
    body: "Es gibt Bewegung, aber keine harte wirtschaftliche Konsequenz.",
    relevant: "06 · 07 · 08",
  },
];
---

<SubPageLayout
  title="Commercial Management | Karsten Uhlig"
  description="Commercial Management und Digital Commerce: Wachstum, Kundenwert und Profitabilität als zusammenhängendes System steuern."
>
  <article class="commercial-landing">
    <header class="landing-hero">
      <div class="hero-eyebrow">Commercial Management / Digital Commerce</div>
      <h1>Commercial Management</h1>
      <p class="hero-subheadline">Wachstum, Kundenwert und Profitabilität als zusammenhängendes System steuern.</p>
      <p class="hero-copy">Nachhaltiges Wachstum entsteht nicht aus einzelnen Kanälen oder Maßnahmen. Entscheidend ist, wie Angebot, Nachfrage, Kundenbasis, Customer Journey, Märkte, Ressourcen und Organisation zusammenwirken. Commercial Management bedeutet für mich, diese Mechanik zu verstehen, Prioritäten daraus abzuleiten und sie über Funktionsgrenzen hinweg wirksam zu steuern.</p>
    </header>

    <CommercialFieldExplorer />
    <CommercialSystemMap />
    <CommercialDeepDives />
    <CommercialManagementLoop
      title="Wie ich steuere"
      lead="Beobachtung, Entscheidung und Umsetzung bleiben verbunden, damit aus Signalen klare Prioritäten und aus Prioritäten wirtschaftliche Wirkung wird."
    />
    <MarketOffers tensions={landingTensions} />
    <CommercialEvidence />
  </article>
</SubPageLayout>

<style>
  .commercial-landing { min-width: 0; }
  .landing-hero { position: relative; padding: 2.25rem 0 5.25rem; }
  .landing-hero::after { content: ""; position: absolute; right: 2%; bottom: 0; left: 34%; height: 1px; background: linear-gradient(90deg, rgba(180,83,9,.65), rgba(30,60,100,.14), transparent); }
  .hero-eyebrow { margin-bottom: 1rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  h1 { max-width: 900px; margin: 0; color: var(--color-ink); font-size: clamp(46px, 7vw, 82px); font-weight: 500; letter-spacing: -.055em; line-height: .98; }
  .hero-subheadline { max-width: 860px; margin: 1.55rem 0 0; color: var(--color-ink); font-size: clamp(22px, 2.7vw, 34px); font-weight: 400; letter-spacing: -.025em; line-height: 1.25; }
  .hero-copy { max-width: 810px; margin: 1.55rem 0 0; color: var(--color-body); font-size: 16px; line-height: 1.8; }

  @media (max-width: 760px) {
    .landing-hero { padding: 1rem 0 4rem; }
    .landing-hero::after { left: 0; }
    h1 { font-size: 48px; }
    .hero-subheadline { font-size: 24px; }
    .hero-copy { font-size: 15px; }
  }

  @media (max-width: 430px) { h1 { font-size: 41px; } }
</style>
