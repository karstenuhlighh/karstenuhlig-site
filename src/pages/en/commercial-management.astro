---
import SubPageLayout from "../../layouts/SubPageLayout.astro";
import CommercialFieldExplorer from "../../components/CommercialFieldExplorer.astro";
import CommercialSystemMap from "../../components/CommercialSystemMap.astro";
import CommercialDeepDives from "../../components/CommercialDeepDives.astro";
import CommercialManagementLoop from "../../components/CommercialManagementLoop.astro";
import MarketOffers from "../../components/MarketOffers.astro";
import CommercialEvidence from "../../components/CommercialEvidence.astro";

const landingTensions = [
  {
    title: "Growth is becoming less efficient",
    body: "More effort no longer creates proportionally more impact.",
    relevant: "01 · 02 · 06",
  },
  {
    title: "Customer journey and Customer Value do not work as one system",
    body: "Channels optimise locally, but not as one economic system.",
    relevant: "03 · 04 · 06",
  },
  {
    title: "Priorities and accountability become fragmented",
    body: "Too many initiatives, too little clear steering.",
    relevant: "01 · 07 · 08",
  },
  {
    title: "Data, AI and digital products create activity, but too little commercial impact",
    body: "There is movement, but no hard economic consequence.",
    relevant: "06 · 07 · 08",
  },
];
---

<SubPageLayout
  language="en"
  title="Commercial Management | Karsten Uhlig"
  description="Commercial Management and Digital Commerce: steering growth, Customer Value and profitability as one coherent system."
>
  <article class="commercial-landing">
    <header class="landing-hero">
      <div class="hero-eyebrow">Commercial Management / Digital Commerce</div>
      <h1>Commercial Management</h1>
      <p class="hero-subheadline">Steering growth, Customer Value and profitability as one coherent system.</p>
      <p class="hero-copy">Sustainable growth does not come from individual channels or interventions. What matters is how offer, demand, customer base, Customer Journey, markets, resources and organisation work together. For me, Commercial Management means understanding these mechanics, deriving priorities from them and steering them effectively across functional boundaries.</p>
    </header>

    <CommercialFieldExplorer language="en" />
    <CommercialSystemMap language="en" />
    <CommercialDeepDives language="en" />
    <CommercialManagementLoop
      language="en"
      title="How I steer"
      lead="Observation, decision and execution remain connected, turning signals into clear priorities and priorities into economic impact."
    />
    <MarketOffers language="en" tensions={landingTensions} />
    <CommercialEvidence language="en" />
  </article>
</SubPageLayout>

<style>
  .commercial-landing { min-width: 0; }
  .landing-hero { position: relative; padding: 2.25rem 0 5.25rem; }
  .landing-hero::after { content: ""; position: absolute; right: 2%; bottom: 0; left: 34%; height: 1px; background: linear-gradient(90deg, rgba(180,83,9,.65), rgba(30,60,100,.14), transparent); }
  .hero-eyebrow { margin-bottom: 1rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  h1 { max-width: 900px; margin: 0; color: var(--color-ink); font-size: clamp(46px, 7vw, 82px); font-weight: 500; letter-spacing: -.055em; line-height: .98; }
  .hero-subheadline { max-width: 860px; margin: 1.55rem 0 0; color: var(--color-ink); font-size: clamp(22px, 2.7vw, 34px); font-weight: 400; letter-spacing: -.025em; line-height: 1.25; }
  .hero-copy { max-width: 810px; margin: 1.55rem 0 0; color: var(--color-body); font-size: 16px; line-height: 1.8; }

  @media (max-width: 760px) {
    .landing-hero { padding: 1rem 0 4rem; }
    .landing-hero::after { left: 0; }
    h1 { font-size: 48px; }
    .hero-subheadline { font-size: 24px; }
    .hero-copy { font-size: 15px; }
  }

  @media (max-width: 430px) { h1 { font-size: 41px; } }
</style>
