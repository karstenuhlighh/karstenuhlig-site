---
import SubPageLayout from "../../layouts/SubPageLayout.astro";
import CommercialFieldExplorer from "../../components/CommercialFieldExplorer.astro";
import CommercialSystemMap from "../../components/CommercialSystemMap.astro";
import CommercialDeepDives from "../../components/CommercialDeepDives.astro";
import CommercialManagementLoop from "../../components/CommercialManagementLoop.astro";
import MarketOffers from "../../components/MarketOffers.astro";
import CommercialEvidence from "../../components/CommercialEvidence.astro";

const landingTensions = [
  {
    title: "Growth is becoming less efficient",
    body: "More effort no longer leads proportionally to more results.",
    relevant: "01 · 02 · 06",
  },
  {
    title: "Customer journey and Customer Value do not work as one system",
    body: "Channels optimise locally, but not as one economic system.",
    relevant: "03 · 04 · 06",
  },
  {
    title: "Priorities and accountability become fragmented",
    body: "Too many initiatives, too little clear steering.",
    relevant: "01 · 07 · 08",
  },
  {
    title: "Data, AI and digital products create activity, but too little result",
    body: "There is movement, but no hard economic consequence.",
    relevant: "06 · 07 · 08",
  },
];
---

<SubPageLayout
  editorial
  language="en"
  title="Commercial Management | Karsten Uhlig"
  description="Commercial Management and Digital Commerce: steering growth, Customer Value and profitability as one coherent system."
>
  <article class="commercial-landing">
    <header class="landing-hero">
      <div class="hero-eyebrow">Commercial Management / Digital Commerce</div>
      <h1>Commercial Management</h1>
      <p class="hero-subheadline">Steering growth, Customer Value and profitability as one coherent system.</p>
      <p class="hero-copy">Sustainable growth does not come from individual channels or interventions. It depends on how offer, demand, customer base, Customer Journey, markets, resources and organisation work together. For me, Commercial Management means understanding these mechanics, setting priorities and bringing them into the business across functional boundaries.</p>
    </header>

    <CommercialFieldExplorer language="en" />
    <CommercialSystemMap language="en" />
    <CommercialDeepDives language="en" />
    <CommercialManagementLoop
      language="en"
      title="How I steer"
      lead="Signals only help when they become decisions. And decisions only count when they reach execution."
    />
    <MarketOffers language="en" tensions={landingTensions} />
    <CommercialEvidence language="en" />
  </article>
</SubPageLayout>

<style>
  .commercial-landing { min-width: 0; }
  .landing-hero { position: relative; padding: 2rem 0 4rem; border-bottom: 1px solid var(--color-border-soft); }
  .hero-eyebrow { display: flex; gap: .85rem; align-items: center; margin-bottom: 1.1rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .14em; text-transform: uppercase; }
  .hero-eyebrow::before { content: ""; width: 2.25rem; height: 2px; flex: 0 0 auto; background: var(--color-amber); }
  h1 { max-width: 800px; margin: 0; color: var(--color-ink); font-size: clamp(46px, 5.4vw, 64px); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  .hero-subheadline { max-width: 800px; margin: 1.35rem 0 0; color: var(--color-ink); font-size: clamp(22px, 2.35vw, 30px); font-weight: 500; letter-spacing: -.025em; line-height: 1.25; }
  .hero-copy { max-width: 800px; margin: 1.35rem 0 0; color: var(--color-body); font-size: 15.5px; line-height: 1.72; }

  @media (max-width: 760px) {
    .landing-hero { padding: 1rem 0 3rem; }
    h1 { font-size: 42px; }
    .hero-subheadline { font-size: 23px; }
    .hero-copy { font-size: 15px; }
  }

  @media (max-width: 430px) { h1 { font-size: 38px; } }
</style>
