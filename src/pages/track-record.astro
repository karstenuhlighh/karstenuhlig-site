---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import SelectedInitiatives from "../components/SelectedInitiatives.astro";
import { trackRecordPhases } from "../data/track-record";
import { trackRecordPhasesEn } from "../data/en/track-record";
import { getLanguage } from "../i18n/routes";

const language = getLanguage(Astro.url.pathname);
const isEnglish = language === "en";
const phases = isEnglish ? trackRecordPhasesEn : trackRecordPhases;
---

<SubPageLayout
  language={language}
  title="Track Record | Karsten Uhlig | Commercial & Digital Commerce Executive"
  description={isEnglish ? "From Offer Management and Digital Marketing through CRM to end-to-end steering of an international E-Commerce business. Four phases of building and scaling at bonprix since 2004." : "Von Angebotssteuerung und Digital Marketing über CRM bis zur End-to-End-Steuerung eines internationalen E-Commerce-Geschäfts. Vier Aufbau- und Skalierungsphasen bei bonprix ab 2004."}
>
  <div class="tr-intro">
    <div class="tr-eyebrow">Track Record</div>

    <div class="tr-copy">
      <h1 class="tr-headline">{isEnglish ? "Accountability across the digital value chain" : "Verantwortung entlang der digitalen Wertschöpfung"}</h1>

      <div class="tr-body">
        <p>{isEnglish ? "Three complementary perspectives make the track record tangible: how my accountability developed, how I steer commercial performance, and what was built or changed in practice. The visible entries stay deliberately concise; each opens the full context in a detail layer." : "Drei ergänzende Perspektiven machen den Track Record greifbar: wie sich meine Verantwortung entwickelte, wie ich Geschäft steuere und was konkret aufgebaut oder verändert wurde."}</p>
      </div>
    </div>

    <figure class="tr-portrait">
      <img
        src="/images/karsten-uhlig-track-record-portrait.png"
        alt={isEnglish ? "Portrait of Karsten Uhlig in a suit" : "Portrait von Karsten Uhlig im Anzug"}
        width="996"
        height="1024"
        decoding="async"
      />
    </figure>

    <div class="tr-divider" aria-hidden="true"></div>
  </div>

  <SelectedInitiatives language={isEnglish ? "en" : "de"} phases={phases} />

  <section class="tr-now" aria-labelledby="tr-now-title">
    <div class="tr-arc-period">{isEnglish ? "Since 2025" : "Seit 2025"}</div>
    <h2 id="tr-now-title">{isEnglish ? "Developing Commercial Management further with AI" : "Commercial Management mit AI weiterentwickeln"}</h2>
    <p>{isEnglish ? "Today, I am developing this approach further through AI-assisted decision models for Marketing and Digital Commerce, and testing these approaches through my own Agentic AI prototypes, among other applications." : "Heute entwickle ich diesen Ansatz mit AI-gestützten Entscheidungsmodellen für Marketing und Digital Commerce weiter und teste die Ansätze unter anderem an eigenen Agentic-AI-Prototypen."}</p>
  </section>
</SubPageLayout>

<style>
  .tr-intro { display: grid; grid-template-columns: minmax(0, 1fr) 280px; grid-template-areas: "eyebrow ." "copy portrait" "divider divider"; column-gap: clamp(3rem, 6vw, 5.25rem); row-gap: 1.5rem; align-items: start; padding: 1.5rem 0 0; }
  .tr-eyebrow { grid-area: eyebrow; color: var(--color-amber); font-size: 12px; font-weight: 500; letter-spacing: .15em; text-transform: uppercase; }
  .tr-copy { grid-area: copy; min-width: 0; }
  .tr-headline { margin: 0 0 1.5rem; color: var(--color-ink); font-size: 44px; font-weight: 500; letter-spacing: -.03em; line-height: 1.05; }
  .tr-body { max-width: 100%; }
  .tr-body p { font-size: 17px; line-height: 1.75; color: var(--color-ink-2); margin: 0 0 1.5rem; }
  .tr-body p:last-child { margin-bottom: 0; }
  .tr-portrait { grid-area: portrait; width: 100%; aspect-ratio: 4 / 5; margin: 0; overflow: hidden; }
  .tr-portrait img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .tr-divider { grid-area: divider; width: 100%; margin-top: 1.25rem; border-top: 1px solid var(--color-border); }
  :global(.page-main > .perspectives) { margin-top: 0; }
  :global(.page-main > .perspectives .perspective-column:first-child) { border-top: 0; }
  .tr-arc-period { margin-bottom: .55rem; font-size: 13px; font-weight: 500; color: var(--color-amber); }
  h2 { margin: 0 0 .75rem; font-size: 28px; font-weight: 500; letter-spacing: -.02em; line-height: 1.2; color: var(--color-ink); }
  .tr-now p { margin: 0; font-size: 15px; line-height: 1.7; color: var(--color-body); }
  .tr-now { max-width: 760px; margin-top: 2.25rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  @media (max-width: 900px) {
    .tr-intro { grid-template-columns: 1fr; grid-template-areas: "eyebrow" "copy" "portrait" "divider"; column-gap: 0; row-gap: 1.5rem; padding-top: 1rem; }
    .tr-portrait { aspect-ratio: 5 / 4; }
    .tr-portrait img { object-position: 50% 0%; }
    .tr-divider { margin-top: 0; }
  }
  @media (max-width: 768px) {
    .tr-headline { font-size: 32px; }
    h2 { font-size: 24px; }
    .tr-now { margin-top: 1.75rem; padding-top: 1.25rem; }
  }
</style>
