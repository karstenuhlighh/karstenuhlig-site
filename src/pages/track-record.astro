---
import SubPageLayout from "../layouts/SubPageLayout.astro";

const phases = [
  {
    period: "2018–2025",
    title: "Internationales E-Commerce-Geschäft steuern und skalieren",
    body: "End-to-End-Verantwortung für ein digitales Geschäft mit €1,6 Mrd. Umsatz in 20+ Märkten – über Customer Journey, Conversion, CRM, Digital Marketing, Personalisierung und Digital Products.",
    proof: "100+ Mitarbeitende · 20+ crossfunktionale Teams · >€30 Mio. Budget",
  },
  {
    period: "2010–2018",
    title: "CRM, Customer Journey und Data verbinden",
    body: "Aufbau eines integrierten CRM- und Datenmodells über digitale und klassische Touchpoints. Einführung einer gemeinsamen Marketing-Datenplattform, Self-Service-Analytics sowie erster produktiver ML-Anwendungen. Parallel entstanden Mobile Commerce und die bonprix App als neue Vertriebskanäle.",
  },
  {
    period: "2005–2010",
    title: "Digital Marketing aufbauen und international expandieren",
    body: "Aufbau der internationalen Online-Marketing-Organisation für SEM, SEO, Affiliates, Display und E-Mail sowie Verantwortung für Frontend, Plattform und Prozesse von 11 internationalen Webshops. Der marketinggetriebene Anteil am Online-Traffic wuchs von 0 auf 50 Prozent.",
  },
  {
    period: "2000–2005",
    title: "Aus Sortiment wird datenbasierte Angebotssteuerung",
    body: "Ausgangspunkt war das Einkaufsmarketing: Sortiment, Preis, Bestand und Verfügbarkeit wurden erstmals anhand digitaler Nachfrage- und Erfolgsdaten gesteuert. Während der Katalog rund 800 Styles abbilden konnte, ließen sich online rund 8.000 Styles wirtschaftlich darstellen.",
  },
];
---

<SubPageLayout
  title="Track Record | Karsten Uhlig | CDO & VP E-Commerce"
  description="Vier fachliche Aufbau- und Skalierungsphasen bei bonprix: vom Einkauf über Digital Marketing und CRM bis zur End-to-End-Steuerung des internationalen E-Commerce-Geschäfts."
>
<section class="track-record" id="track-record" aria-labelledby="track-record-title">
  <div class="track-heading">
    <div class="eyebrow">Track Record</div>
    <div>
      <div class="track-context">bonprix (Otto Group), 2000–2025</div>
      <h1 class="track-lead" id="track-record-title">Vom Einkauf über Digital Marketing und CRM bis zur End-to-End-Steuerung eines internationalen E-Commerce-Geschäfts.</h1>
      <p class="track-intro">Meine Verantwortung ist mit dem digitalen Geschäft gewachsen: von datenbasierter Angebotssteuerung über den Aufbau von Online-Marketing, Webshops und CRM bis zur durchgängigen Verantwortung für Customer Journey, Wachstum und digitale Produkte in mehr als 20 Märkten.</p>
    </div>
  </div>

  <ol class="track-phases">
    {
      phases.map((phase) => (
        <li>
          <span class="track-period">{phase.period}</span>
          <div>
            <h2>{phase.title}</h2>
            <p>{phase.body}</p>
            {phase.proof && <p class="track-proof">{phase.proof}</p>}
          </div>
        </li>
      ))
    }
  </ol>

  <a class="track-link" href="/track-record/deep-dive">Track Record im Deep Dive <span aria-hidden="true">→</span></a>
</section>
</SubPageLayout>

<style>
  .track-record { position: relative; }
  .track-heading, .track-phases li { display: grid; grid-template-columns: .38fr minmax(0, 1fr); gap: 4rem; align-items: start; }
  .eyebrow { margin: 0; color: var(--color-ink-3); font-size: 12px; font-weight: 500; letter-spacing: .15em; text-transform: uppercase; }
  .track-context { margin-bottom: .75rem; color: var(--color-amber); font-size: 11px; font-weight: 500; letter-spacing: .1em; text-transform: uppercase; }
  .track-lead { margin: 0 0 .9rem; color: var(--color-ink); font-size: 30px; font-weight: 500; letter-spacing: -.025em; line-height: 1.15; }
  .track-intro { max-width: 720px; margin: 0; color: var(--color-body); font-size: 15px; line-height: 1.75; }
  .track-phases { list-style: none; margin: 2.5rem 0 1.75rem; padding: 0; border-top: 1px solid var(--color-border-soft); }
  .track-phases li { padding: 1.65rem 0 1.75rem; border-bottom: 1px solid var(--color-border-soft); }
  .track-period { padding-top: .2rem; color: var(--color-amber); font-size: 13px; font-weight: 500; }
  h2 { margin: 0 0 .65rem; color: var(--color-ink); font-size: 20px; font-weight: 500; letter-spacing: -.01em; line-height: 1.35; }
  .track-phases p { margin: 0; color: var(--color-body); font-size: 15px; line-height: 1.7; }
  .track-phases .track-proof { margin-top: .75rem; color: var(--color-ink-2); font-size: 13px; font-weight: 500; }
  .track-link { display: inline-flex; gap: .45rem; align-items: center; color: var(--color-amber); font-size: 15px; font-weight: 500; text-decoration: none; transition: opacity .2s ease; }
  .track-link:hover { opacity: .7; }
  @media (max-width: 768px) {
    .track-heading, .track-phases li { grid-template-columns: 1fr; }
    .track-heading { gap: 1.25rem; }
    .track-lead { font-size: 26px; }
    .track-phases li { gap: .65rem; padding: 1.35rem 0; }
    .track-period { padding-top: 0; }
    h2 { font-size: 18px; }
  }
</style>
