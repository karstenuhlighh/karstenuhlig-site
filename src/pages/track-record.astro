---
import SubPageLayout from "../layouts/SubPageLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { trackRecordPhases } from "../data/track-record";
import { trackRecordPhasesEn } from "../data/en/track-record";
import { getLanguage } from "../i18n/routes";

const language = getLanguage(Astro.url.pathname);
const isEnglish = language === "en";
const phases = isEnglish ? trackRecordPhasesEn : trackRecordPhases;
---

<SubPageLayout
  language={language}
  title="Track Record | Karsten Uhlig | Commercial & Digital Commerce Executive"
  description={isEnglish ? "From Offer Management and Digital Marketing through CRM to end-to-end steering of an international E-Commerce business. Four phases of building and scaling at bonprix since 2004." : "Von Angebotssteuerung und Digital Marketing über CRM bis zur End-to-End-Steuerung eines internationalen E-Commerce-Geschäfts. Vier Aufbau- und Skalierungsphasen bei bonprix ab 2004."}
>
  <PageHeader
    eyebrow="Track Record"
    headline={isEnglish ? "Accountability across the digital value chain" : "Verantwortung entlang der digitalen Wertschöpfung"}
  />

  <div class="tr-body">
    <p>{isEnglish ? "My development at bonprix progressed through several professionally distinct phases of building and scaling: from Offer Management and Digital Marketing through international webshops, CRM, Customer Journey and Data to the end-to-end Commercial Steering of an international E-Commerce business. Across these phases, the common thread was to build new capabilities, make them economically robust and then scale them internationally." : "Meine Entwicklung bei bonprix verlief über mehrere fachlich unterschiedliche Aufbau- und Skalierungsphasen: von Angebotssteuerung und Digital Marketing über internationale Webshops, CRM, Customer Journey und Data bis zur durchgängigen kommerziellen Steuerung eines internationalen E-Commerce-Geschäfts. Gemeinsam war diesen Phasen, neue Fähigkeiten aufzubauen, wirtschaftlich belastbar zu machen und anschließend international zu skalieren."}</p>
  </div>

  <section class="tr-facts" aria-label={isEnglish ? "Professional development at bonprix, 2004–2025" : "Fachliche Entwicklung bei bonprix, 2004–2025"}>
    <ol class="tr-arc">
      {
        phases.map((phase) => (
          <li class="tr-arc-item">
            <div class="tr-arc-head">
              <div class="tr-arc-period">{phase.period}</div>
              <h2>{phase.title}</h2>
            </div>
            <div class="tr-arc-body">
              <p>{phase.body}</p>
            </div>
            <div class="tr-closing">
              <h3>{isEnglish ? "Focus" : "Schwerpunkte"}</h3>
              <p>{phase.focus}</p>
            </div>
            {phase.scale && (
              <div class="tr-closing">
                <h3>Scale &amp; Impact</h3>
                <p>{phase.scale}</p>
              </div>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="tr-now" aria-labelledby="tr-now-title">
    <div class="tr-arc-period">{isEnglish ? "Since 2025" : "Seit 2025"}</div>
    <h2 id="tr-now-title">{isEnglish ? "Developing Commercial Management further with AI" : "Commercial Management mit AI weiterentwickeln"}</h2>
    <p>{isEnglish ? "Today, I am developing this approach further through AI-assisted decision models for Marketing and Digital Commerce, and testing these approaches through my own Agentic AI prototypes, among other applications." : "Heute entwickle ich diesen Ansatz mit AI-gestützten Entscheidungsmodellen für Marketing und Digital Commerce weiter und teste die Ansätze unter anderem an eigenen Agentic-AI-Prototypen."}</p>
  </section>
</SubPageLayout>

<style>
  .tr-body { max-width: 720px; }
  .tr-body p { font-size: 17px; line-height: 1.75; color: var(--color-ink-2); margin: 0 0 1.5rem; }
  .tr-body p:last-child { margin-bottom: 0; }
  .tr-facts { margin-top: 4rem; padding-top: 3rem; border-top: 1px solid var(--color-border); }
  .tr-arc { list-style: none; padding: 0; margin: 0; max-width: 760px; }
  .tr-arc-item { position: relative; padding: 0 0 3rem 1.5rem; border-left: 1px solid var(--color-border); }
  .tr-arc-item:last-child { padding-bottom: 0; }
  .tr-arc-item::before { content: ""; position: absolute; left: -4px; top: .45em; width: 7px; height: 7px; border-radius: 50%; background: var(--color-amber); }
  .tr-arc-head { margin-bottom: 1.5rem; }
  .tr-arc-period { margin-bottom: .75rem; font-size: 13px; font-weight: 500; color: var(--color-amber); }
  h2 { margin: 0 0 .75rem; font-size: 28px; font-weight: 500; letter-spacing: -.02em; line-height: 1.2; color: var(--color-ink); }
  .tr-arc-body p, .tr-closing p, .tr-now p { margin: 0 0 1rem; font-size: 15px; line-height: 1.75; color: var(--color-body); }
  .tr-arc-body > p:last-child, .tr-closing p, .tr-now p { margin-bottom: 0; }
  .tr-closing h3 { margin: 0 0 .4rem; font-size: 14px; line-height: 1.5; font-weight: 500; color: var(--color-ink); }
  .tr-closing { margin-top: 1.5rem; }
  .tr-closing p { color: var(--color-ink-2); }
  .tr-now { max-width: 760px; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  @media (max-width: 768px) {
    .tr-facts { margin-top: 3rem; padding-top: 2rem; }
    .tr-arc-item { padding-left: 1.25rem; }
    h2 { font-size: 24px; }
    .tr-now { margin-top: 3rem; }
  }
</style>
