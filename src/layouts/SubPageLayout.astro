---
import Layout from "./Layout.astro";
import Nav from "../components/Nav.astro";
import { getLanguage, type Language } from "../i18n/routes";

interface Props {
  title?: string;
  description?: string;
  language?: Language;
  editorial?: boolean;
  variant?: "default" | "agentic";
}

const { title, description, language = getLanguage(Astro.url.pathname), editorial = false, variant = "default" } = Astro.props;
const bodyClass = editorial
  ? `is-editorial-subpage${variant === "agentic" ? " is-agentic-editorial" : ""}`
  : undefined;
---

<Layout title={title} description={description} language={language} bodyClass={bodyClass}>
  <div class:list={["subpage-surface", { "subpage-surface--editorial": editorial }]}>
    <div class="page-shell">
      <header class="page-header">
        <Nav language={language} homepage={editorial} />
      </header>
      <main class="page-main">
        <slot />
      </main>
    </div>
  </div>
</Layout>

<style>
  .subpage-surface--editorial {
    min-height: 100vh;
    overflow-x: clip;
    background:
      radial-gradient(circle at 84% 8rem, rgba(255,255,255,.72) 0, rgba(255,255,255,0) 31rem),
      linear-gradient(180deg, #EEF2F7 0, #D6E1ED 44rem, #E7EEF5 82rem, #EEF2F7 100%);
  }
  .page-shell {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 4rem 5rem;
  }
  .subpage-surface--editorial .page-shell {
    max-width: 1440px;
    padding: 1.25rem 4.25rem 5rem;
  }
  .page-main {
    min-width: 0;
  }
  :global(.is-agentic-editorial .tabs) {
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    max-width: none;
    margin: 0 0 3.5rem;
    overflow-x: auto;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    scrollbar-width: thin;
  }
  :global(.is-agentic-editorial .tab) {
    flex: 1 0 auto;
    min-height: 3.6rem;
    margin: 0;
    padding: 1rem 1.35rem;
    color: var(--color-ink-3);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .11em;
    text-align: left;
    text-transform: uppercase;
    border: 0;
    border-right: 1px solid var(--color-border-soft);
    border-bottom: 2px solid transparent;
    background: rgba(255, 255, 255, .18);
  }
  :global(.is-agentic-editorial .tab:last-child) {
    border-right: 0;
  }
  :global(.is-agentic-editorial .tab:hover) {
    color: var(--color-ink);
    background: rgba(255, 255, 255, .36);
  }
  :global(.is-agentic-editorial .tab:focus-visible) {
    position: relative;
    z-index: 1;
    outline: 3px solid rgba(180, 83, 9, .4);
    outline-offset: -3px;
  }
  :global(.is-agentic-editorial .tab.tab-active) {
    color: var(--color-ink);
    border-bottom-color: var(--color-amber);
    background: rgba(255, 255, 255, .48);
  }
  :global(.is-agentic-editorial [data-panel]) {
    max-width: 1180px;
    margin-right: auto;
    margin-left: auto;
  }
  :global(.is-agentic-editorial .tab-sub) {
    max-width: 820px;
    margin-bottom: 2rem;
    color: var(--color-ink-2);
    font-size: 13px;
    font-style: normal;
    line-height: 1.65;
  }
  @media (max-width: 1100px) {
    .subpage-surface--editorial .page-shell {
      padding-inline: 2.5rem;
    }
  }
  @media (max-width: 768px) {
    .subpage-surface--editorial {
      background:
        radial-gradient(circle at 100% 6rem, rgba(255,255,255,.65) 0, rgba(255,255,255,0) 22rem),
        linear-gradient(180deg, #EEF2F7 0, #D6E1ED 34rem, #EEF2F7 76rem);
    }
    .page-shell,
    .subpage-surface--editorial .page-shell {
      padding: 2rem 1.5rem 3rem;
    }
    :global(.is-agentic-editorial .tabs) {
      margin-bottom: 2.5rem;
    }
    :global(.is-agentic-editorial .tab) {
      min-width: max-content;
      min-height: 3.25rem;
      padding: .9rem 1rem;
      font-size: 10px;
    }
  }
</style>
